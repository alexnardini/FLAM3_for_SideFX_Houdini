                    "75"    "Wedge..."
                    "76"    "Wedgejulia... "
                    "77"    "Wedgesph... "
                    "78"    "Whorl... "
                }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "ffp1weight"
                label   "   w"
                type    float
                default { "0" }
                help    "<h2>POST 01 weight</h2>Set it to <b>0</b>(<i>Zero</i>) to disable it. Can be set higher than <b>1</b>(<i>one</i>)."
                range   { 0! 1 }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "ffp2type"
                label   "ffp2"
                type    ordinal
                nolabel
                joinnext
                default { "0" }
                help    "Select a variation type"
                menu usetokenvalue {
                    "0"     "Linear                                     "
                    "39"    "Arch"
                    "94"    "Auger..."
                    "14"    "Bent"
                    "52"    "Bent2..."
                    "53"    "Bipolar..."
                    "43"    "Blade"
                    "30"    "Blob..."
                    "26"    "Blur"
                    "54"    "Boarders"
                    "23"    "Bubble"
                    "55"    "Butterfly"
                    "99"    "Bwraps..."
                    "56"    "Cell..."
                    "50"    "Conic..."
                    "83"    "Cos"
                    "89"    "Cosh"
                    "20"    "Cosine"
                    "87"    "Cot"
                    "93"    "Coth"
                    "57"    "Cpow..."
                    "102"   "Crop..."
                    "46"    "Cross"
                    "86"    "Csc"
                    "92"    "Csch"
                    "27"    "Curl..."
                    "97"    "Curve..."
                    "24"    "Cylinder"
                    "11"    "Diamond"
                    "8"     "Disc"
                    "47"    "Disc2..."
                    "58"    "Edisc"
                    "59"    "Elliptic"
                    "61"    "Escher..."
                    "12"    "Ex"
                    "80"    "Exp"
                    "18"    "Exponential"
                    "25"    "Eyefish"
                    "22"    "Fan*"
                    "34"    "Fan2..."
                    "16"    "Fisheye"
                    "49"    "Flower..."
                    "95"    "Flux..."
                    "62"    "Foci"
                    "33"    "Gaussian blur"
                    "104"   "Glynnia"
                    "6"     "Handkerchief"
                    "7"     "Heart"
                    "100"   "Hemisphere"
                    "4"     "Horseshoe"
                    "10"    "Hyperbolic"
                    "13"    "Julia"
                    "31"    "JuliaN..."
                    "32"    "Juliascope..."
                    "63"    "Lazysusan..."
                    "81"    "Log"
                    "64"    "Loonie"
                    "96"    "Mobius..."
                    "66"    "Modulus..."
                    "28"    "Ngon..."
                    "60"    "Noise"
                    "67"    "Oscope..."
                    "51"    "Parabola..."
                    "29"    "Pdj..."
                    "98"    "Perspective..."
                    "38"    "Pie... "
                    "105"   "Point sym... "
                    "5"     "Polar"
                    "68"    "Polar2"
                    "101"   "Polynomial... "
                    "17"    "Popcorn*"
                    "69"    "Popcorn2..."
                    "19"    "Power"
                    "37"    "Radialblur..."
                    "42"    "Rays"
                    "36"    "Rectangles..."
                    "21"    "Rings*"
                    "35"    "Rings2..."
                    "70"    "Scry"
                    "85"    "Sec"
                    "44"    "Secant2"
                    "91"    "Sech"
                    "71"    "Separation..."
                    "82"    "Sin"
                    "88"    "Sinh"
                    "1"     "Sinusoidal"
                    "2"     "Spherical"
                    "9"     "Spiral"
                    "72"    "Split..."
                    "73"    "Splits..."
                    "41"    "Square"
                    "74"    "Stripes..."
                    "48"    "Supershape..."
                    "3"     "Swirl"
                    "84"    "Tan"
                    "40"    "Tangent"
                    "90"    "Tanh"
                    "45"    "Twintrian"
                    "103"   "Unpolar"
                    "15"    "Waves*"
                    "79"    "Waves2..."
                    "75"    "Wedge..."
                    "76"    "Wedgejulia... "
                    "77"    "Wedgesph... "
                    "78"    "Whorl... "
                }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "ffp2weight"
                label   "   w"
                type    float
                default { "0" }
                help    "<h2>POST 02 weight</h2>Set it to <b>0</b>(<i>Zero</i>) to disable it. Can be set higher than <b>1</b>(<i>one</i>)."
                range   { 0! 1 }
                parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_iterator_utils(kwargs).swap_FF_post_vars()\n" }
                parmtag { "script_action_help" "[LMB] to swap the order of the POST Variations and their weights. [CTRL+LMB] to swap the variation's names only." }
                parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteKwargsSVG.svg" }
                parmtag { "script_callback_language" "python" }
            }
        }

        groupcollapsible {
            name    "f_ffpostaffinedo"
            label   "FF: post affine"
            disablewhentab "{ doff == 0 }"
            grouptag { "group_type" "collapsible" }
            parmtag { "sidefx::header_toggle" "ffdopost" }

            parm {
                name    "ffdopost"
                label   "FF post"
                type    toggle
                default { "0" }
                help    "<h2>Turn FF post affine <b>ON</b>/<b>OFF</b></h2>The term \"<b>post-affine</b>\" would be used to emphasize the sequential application of an affine transformation within a larger pipeline of operations.<br/><br/>For example, if you first apply a perspective transformation to an image and then apply an affine transformation to correct for a slight remaining distortion or to further refine the image, you might refer to the latter as a \"<b>post-affine transformation</b>\" to distinguish its place in the sequence.<br/><br/><i>In the context of fractal Flames, the \"<b>post-affine transformation</b>\" will be the very last to be applied to the incoming point/sample</i>."
                parmtag { "script_callback_language" "python" }
            }
        }

        group {
            name    "f_ffpreaffine"
            label   "FF: pre affine"

            groupsimple {
                name    "f_ffpreaffinedata"
                label   "FF PRE AFFINE"
                disablewhentab "{ doff == 0 }"
                grouptag { "group_type" "simple" }

                parm {
                    name    "ffscl"
                    label   "Scale"
                    type    float
                    default { "1" }
                    help    "Scale <u><b>FF pre affine</b></u> values (<i><b>X</b> and <b>Y</b></i>) by an amount,<br/>with a value of <b>1</b>(<i>one</i>) (<i>100% -> no scale</i>) being the default.<br/><br/><b>The are two ways to use this parameter</b>:<ol><li>Input a value into the numeric field. For example if you type: <b>1.2</b> it will scale the affine up by <b>20%</b>.</li><li>[<b>LMB</b>] into the numeric field and use the [<b>Mouse Wheel</b>] to increment the scale up or down.</li></ol><b>When using the mouse wheel (<i><b>2</b></i>)</b>:<ul><li>[<b>Mouse Wheel</b>]<br/>will scale the value by an increment of: <b>+/- 0.1</b></li><li>[<b>SHIFT+Mouse Wheel</b>]<br/>will scale the value by an increment of: <b>+/- 0.01</b></li><li>[<b>CTRL+Mouse Wheel</b>]<br/>will scale the value by an increment of: <b>+/- 1</b></li></ul><br/><i>Additionally</i>:<br/><i>The parameter's slider ranges are between <b>0.975</b> and <b>1.025</b> to allow for precise and very small value changes when dragged left or right</i>.<br/><br/><u><b>This parameter can not be animated</b></u>.<br/><br/><b>NOTE</b>:<br/>Every time you either input a value, drag the slider or use the mouse wheel to increment the value, it will revert back to the default value of <b>1</b>(<i>one</i>) (<i>100% -> no scale</i>)."
                    range   { 0.975 1.025 }
                    parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_iterator_utils(kwargs).prm_paste_sel_pre_affine_FF()" }
                    parmtag { "script_action_help" "[LMB] to copy the values from the FF POST Affine into here, the FF PRE Affine. It will copy: X, Y, O and Rot. Additionally: [SHIFT+LMB] to copy only the X and Y values. [CTRL+LMB] to copy only the O value. [ALT+LMB] to copy only the Rotation angle value." }
                    parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_StarSwapRedCopyPasteAffineFFSVG.svg" }
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_iterator_utils(kwargs).iterator_FF_affine_scale()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ffx"
                    label   "X (A, D)"
                    type    vector2
                    size    2
                    default { "1" "0" }
                    help    "<u><b>FF pre affine</b></u>: <b>X</b>.<i>x</i>, <b>X</b>.<i>y</i> ( [<b>A</b>], [<b>D</b>] )<br/><br/>Some of the variations uses some of the pre affine coefficients to determine their behavior rather than additional parameters.<br/><br/>These are call: <b>dependent</b> variations.<br/><br/>The <b>dependent</b> variations and the affine coefficients they employ are listed below:<ul><li><h2>Waves* -> B, C, E, F</h2></li><li><h2>Popcorn* -> C, F</h2></li><li><h2>Rings* -> C</h2></li><li><h2>Fan* -> C, F</h2></li></ul><br/><b>NOTE</b>:<br/><i>Please, read the FLAM3H™ documentation to find out more.</i>"
                    range   { -1 1 }
                    parmtag { "script_callback" "" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ffy"
                    label   "Y (B, E)"
                    type    vector2
                    size    2
                    default { "0" "1" }
                    help    "<u><b>FF pre affine</b></u>: <b>Y</b>.<i>x</i>, <b>Y</b>.<i>y</i> ( [<b>B</b>], [<b>E</b>] )<br/><br/>Some of the variations uses some of the pre affine coefficients to determine their behavior rather than additional parameters.<br/><br/>These are call: <b>dependent</b> variations.<br/><br/>The <b>dependent</b> variations and the affine coefficients they employ are listed below:<ul><li><h2>Waves* -> B, C, E, F</h2></li><li><h2>Popcorn* -> C, F</h2></li><li><h2>Rings* -> C</h2></li><li><h2>Fan* -> C, F</h2></li></ul><br/><b>NOTE</b>:<br/><i>Please, read the FLAM3H™ documentation to find out more.</i>"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ffo"
                    label   "O (C, F)"
                    type    vector2
                    size    2
                    default { "0" "0" }
                    help    "<u><b>FF pre affine</b></u> (<b>O</b><i>ffset</i>): <b>O</b>.<i>x</i>, <b>O</b>.<i>y</i> ( [<b>C</b>], [<b>F</b>] )<br/><br/>Some of the variations uses some of the pre affine coefficients to determine their behavior rather than additional parameters.<br/><br/>These are call: <b>dependent</b> variations.<br/><br/>The <b>dependent</b> variations and the affine coefficients they employ are listed below:<ul><li><h2>Waves* -> B, C, E, F</h2></li><li><h2>Popcorn* -> C, F</h2></li><li><h2>Rings* -> C</h2></li><li><h2>Fan* -> C, F</h2></li></ul><br/><b>NOTE</b>:<br/><i>Please, read the FLAM3H™ documentation to find out more.</i>"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ffang"
                    label   "Rot"
                    type    float
                    default { "0" }
                    help    "Rotate <u><b>FF pre affine</b></u> in angle degrees.<br/><br/>The rotation will take the values of <b>X</b>, <b>Y</b>, <b>O</b> and apply a rotation<br/>(<i>with <b>O</b> being the pivot</i>).<br/><br/><b>NOTE</b>:<br/>the resulting affine coefficients are not updated in the UI but passed directly internally to the algorithm."
                    range   { -90 90 }
                    parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_iterator_utils(kwargs).reset_preaffine_FF()" }
                    parmtag { "script_action_help" "[LMB] to reset all affine values. [SHIFT+LMB] to reset only the affine X and Y values. [CTRL+LMB] to reset only the affine O value. [ALT+LMB] to reset only the affine Rotation angle value." }
                    parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteKwargsSVG.svg" }
                    parmtag { "script_callback_language" "python" }
                }
            }

        }

        group {
            name    "f_ffpreaffine_1"
            label   "FF: post affine"

            groupsimple {
                name    "f_ffpostaffinedata"
                label   "FF POST AFFINE"
                disablewhentab "{ doff == 0 } { ffdopost == 0 }"
                grouptag { "group_type" "simple" }

                parm {
                    name    "ffpscl"
                    label   "Scale"
                    type    float
                    default { "1" }
                    help    "Scale <u><b>FF post affine</b></u> values (<i><b>X</b> and <b>Y</b></i>) by an amount,<br/>with a value of <b>1</b>(<i>one</i>) (<i>100% -> no scale</i>) being the default.<br/><br/><b>The are two ways to use this parameter</b>:<ol><li>Input a value into the numeric field. For example if you type: <b>1.2</b> it will scale the affine up by <b>20%</b>.</li><li>[<b>LMB</b>] into the numeric field and use the [<b>Mouse Wheel</b>] to increment the scale up or down.</li></ol><b>When using the mouse wheel (<i><b>2</b></i>)</b>:<ul><li>[<b>Mouse Wheel</b>]<br/>will scale the value by an increment of: <b>+/- 0.1</b></li><li>[<b>SHIFT+Mouse Wheel</b>]<br/>will scale the value by an increment of: <b>+/- 0.01</b></li><li>[<b>CTRL+Mouse Wheel</b>]<br/>will scale the value by an increment of: <b>+/- 1</b></li></ul><br/><i>Additionally</i>:<br/><i>The parameter's slider ranges are between <b>0.975</b> and <b>1.025</b> to allow for precise and very small value changes when dragged left or right</i>.<br/><br/><u><b>This parameter can not be animated</b></u>.<br/><br/><b>NOTE</b>:<br/>Every time you either input a value, drag the slider or use the mouse wheel to increment the value, it will revert back to the default value of <b>1</b>(<i>one</i>) (<i>100% -> no scale</i>)."
                    range   { 0.975 1.025 }
                    parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_iterator_utils(kwargs).prm_paste_sel_post_affine_FF()" }
                    parmtag { "script_action_help" "[LMB] to copy the values from the FF PRE Affine into here, the FF POST Affine. It will copy: X, Y, O and Rot. Additionally: [SHIFT+LMB] to copy only the X and Y values. [CTRL+LMB] to copy only the O value. [ALT+LMB] to copy only the Rotation angle value." }
                    parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_StarSwapRedCopyPasteAffineFFSVG.svg" }
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_iterator_utils(kwargs).iterator_FF_post_affine_scale()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ffpx"
                    label   "X"
                    type    vector2
                    size    2
                    default { "1" "0" }
                    help    "<u><b>FF post affine</b></u>: <b>X</b>.<i>x</i>, <b>X</b>.<i>y</i> ( [<b>A</b>], [<b>D</b>] )"
                    range   { -1 1 }
                    parmtag { "script_callback" "" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ffpy"
                    label   "Y"
                    type    vector2
                    size    2
                    default { "0" "1" }
                    help    "<u><b>FF post affine</b></u>: <b>Y</b>.<i>x</i>, <b>Y</b>.<i>y</i> ( [<b>B</b>], [<b>E</b>] )"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ffpo"
                    label   "O"
                    type    vector2
                    size    2
                    default { "0" "0" }
                    help    "<u><b>FF post affine</b></u> (<b>O</b><i>ffset</i>): <b>O</b>.<i>x</i>, <b>O</b>.<i>y</i> ( [<b>C</b>], [<b>F</b>] )"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ffpang"
                    label   "Rot"
                    type    float
                    default { "0" }
                    help    "Rotate <u><b>FF post affine</b></u> in angle degrees.<br/><br/>The rotation will take the values of <b>X</b>, <b>Y</b>, <b>O</b> and apply a rotation<br/>(<i>with <b>O</b> being the pivot</i>).<br/><br/><b>NOTE</b>:<br/>the resulting affine coefficients are not updated in the UI but passed directly internally to the algorithm."
                    range   { -90 90 }
                    parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_iterator_utils(kwargs).reset_postaffine_FF()" }
                    parmtag { "script_action_help" "[LMB] to reset all affine values. [SHIFT+LMB] to reset only the affine X and Y values. [CTRL+LMB] to reset only the affine O value. [ALT+LMB] to reset only the affine Rotation angle value." }
                    parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteKwargsSVG.svg" }
                    parmtag { "script_callback_language" "python" }
                }
            }

        }

        group {
            name    "f_ffpreaffine_2"
            label   "FF: VARS"

            groupsimple {
                name    "f_ffvariablesdata"
                label   "FF VARS PARAMETERS"
                disablewhentab "{ doff == 0 }"
                grouptag { "group_type" "simple" }

                parm {
                    name    "ff_auger"
                    label   "f/s/s/w AUGER"
                    type    vector4
                    size    4
                    default { "1" "2" "1" "1" }
                    help    "<br/><i>Auger</i> <u><b>F</b></u><i>requency</i>, <u><b>S</b></u><i>cale</i>, <u><b>S</b></u><i>ymmetry</i>, <u><b>W</b></u><i>eight</i> <h2>X -> Frequency</h2> Controls the size of the waves. Higher values create smaller, more frequent ripples. <h2>Y -> Scale</h2> Adjusts the size of the wave deformation. Higher values produce broader, more noticeable bends. <h2>Z -> Symmetry</h2> Balances how evenly the effect is applied across the pattern. <h2>W -> Weight</h2> Controls the overall strength of the deformation. Higher values produce a stronger effect."
                    hidewhen "{ ffv1type != 94 ffv2type != 94 }"
                    range   { 0 4 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_bent2xy"
                    label   "xy BENT2"
                    type    vector2
                    size    2
                    default { "1.5" "0" }
                    help    "<br/><i>Bent2</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X</h2> Controls how much the negative X (<i>left</i>) side of the pattern is stretched or compressed. <h2>Y</h2> Controls how much the negative Y (<i>bottom</i>) side of the pattern is stretched or compressed."
                    hidewhen "{ ffv1type != 52 ffv2type != 52 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_bipolarshift"
                    label   "shift BIPOLAR"
                    type    float
                    default { "1" }
                    help    "<br/><i>Bipolar</i> <u><b>Shift</b></u> <h2>Shift</h2> Moves the seam of the bipolar mapping around the pattern, changing where the transformation wraps."
                    hidewhen "{ ffv1type != 53 ffv2type != 53 }"
                    range   { 0 10 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_blob"
                    label   "low/high/wave BLOB"
                    type    vector
                    size    3
                    default { "0.2" "1" "6" }
                    help    "<br/><i>Blob</i> <u><b>Low</b></u>, <u><b>High</b></u>, <u><b>Waves</b></u> <h2>X -> Low</h2> Sets the minimum size of the blob. <h2>Y -> High</h2> Sets the maximum size of the blob. <h2>Z -> Waves</h2> Controls the number of bulges or lobes around the blob. Higher values create more repeating bumps."
                    hidewhen "{ ffv1type != 30 ffv2type != 30 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_bwraps"
                    label   "s/s/g BWRAPS"
                    type    vector
                    size    3
                    default { "0.5" "0" "1" }
                    help    "<br/><i>Bwraps</i> <u><b>S</b></u><i>ize</i>, <u><b>S</b></u><i>pace</i>, <u><b>G</b></u><i>ain</i> <h2>X -> Size</h2> Controls the size of each bubble wrap cell. Larger values create bigger wrapped areas. <h2>Y -> Space</h2> Controls the spacing between bubble cells. Higher values spread the bubbles farther apart. <h2>Z -> Gain</h2> Controls the intensity of the bubble distortion. Higher values create a stronger wrapping effect."
                    hidewhen "{ ffv1type != 99 ffv2type != 99 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_bwrapstwist"
                    label   "in/out twist BWRAPS"
                    type    vector2
                    size    2
                    default { "3" "0" }
                    help    "<br/><i>Bwraps</i> <u><b>IN Twist</b></u>, <u><b>OUT Twist</b></u> <h2>X -> IN Twist</h2> Controls the amount of rotation applied toward the center of each bubble. <h2>Y -> OUT Twist</h2> Controls the amount of rotation applied toward the outside of each bubble."
                    hidewhen "{ ffv1type != 99 ffv2type != 99 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_cellsize"
                    label   "size CELL"
                    type    float
                    default { "0.05" }
                    help    "<br/><i>Cell</i> <u><b>Size</b></u> <h2>Size</h2> Controls the size of the repeating cells. Smaller values create more, smaller cells; larger values create fewer, larger cells."
                    hidewhen "{ ffv1type != 56 ffv2type != 56 }"
                    range   { 0 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_conic"
                    label   "ecc/holes CONIC"
                    type    vector2
                    size    2
                    default { "0.5" "0.5" }
                    help    "<br/><i>Conic</i> <u><b>Eccentricity</b></u>, <u><b>Holes</b></u> <h2>X -> Eccentricity</h2> Controls the shape and intensity of the cone distortion. <h2>Y -> Holes</h2> Adjusts the amount of open space in the conic pattern."
                    hidewhen "{ ffv1type != 50 ffv2type != 50 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_cpow"
                    label   "pow/r/i CPOW"
                    type    vector
                    size    3
                    default { "2" "1" "0.25" }
                    help    "<br/><i>Cpow</i> <u><b>Power</b></u>, <u><b>R</b></u>, <u><b>I</b></u> <h2>X -> Power</h2> Controls the number of repeated spiral sections. Higher values create more repetitions and finer details. <h2>Y -> R</h2> Controls the radial distortion, affecting how the pattern expands or contracts from the center. <h2>Z -> I</h2> Controls the angular distortion, changing the twist and rotation of the pattern."
                    hidewhen "{ ffv1type != 57 ffv2type != 57 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_cropltrb"
                    label   "l/t/r/b CROP"
                    type    vector4
                    size    4
                    default { "-1" "-1" "1" "1" }
                    help    "<br/><i>Crop</i> <u><b>L</b></u><i>eft</i>, <u><b>T</b></u><i>op</i>, <u><b>R</b></u><i>ight</i>, <u><b>B</b></u><i>ottom</i> <h2>X -> Left</h2> Sets the left boundary of the crop area. <h2>Y -> Top</h2> Sets the top boundary of the crop area. <h2>Z -> Right</h2> Sets the right boundary of the crop area. <h2>W -> Bottom</h2> Sets the bottom boundary of the crop area."
                    hidewhen "{ ffv1type != 102 ffv2type != 102 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_cropaz"
                    label   "area/zero CROP"
                    type    vector2
                    size    2
                    default { "0" "0" }
                    help    "<br/><i>Crop</i> <u><b>Area</b></u>, <u><b>Zero</b></u> <h2>X -> Area</h2> Controls the amount of random repositioning inside the crop area. Higher values create a larger randomized region. <h2>Y -> Zero</h2> Controls what happens to points outside the crop area. When enabled (<i>it just need to be higher than <b>0</b>(Zero)</i>), outside points are moved to the center instead."
                    hidewhen "{ ffv1type != 102 ffv2type != 102 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_curlc"
                    label   "c1/c2 CURL"
                    type    vector2
                    size    2
                    default { "1" "0" }
                    help    "<br/><i>Curl</i> <u><b>C1</b></u>, <u><b>C2</b></u> <h2>X -> C1 (Curl Strength)</h2> Controls the overall curl direction and strength. Higher values create a stronger bending effect. <h2>Y -> C2 (Curl Twist)</h2> Controls the secondary curl behavior, adding more twisting and variation to the distortion."
                    hidewhen "{ ffv1type != 27 ffv2type != 27 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_curvexyzlenght"
                    label   "lenght:xy CURVE"
                    type    vector2
                    size    2
                    default { "1" "1" }
                    help    "<br/><i>Curve</i> <u><b>Lenght X</b></u>, <u><b>Lenght Y</b></u> <h2>X -> Lenght X</h2> Controls the horizontal range of the curve effect. Larger values make the curve spread over a wider area. <h2>Y -> Lenght Y</h2> Controls the vertical range of the curve effect. Larger values make the curve spread over a wider area."
                    hidewhen "{ ffv1type != 97 ffv2type != 97 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_curvexyzamp"
                    label   "amp:xy CURVE"
                    type    vector2
                    size    2
                    default { "0" "0" }
                    help    "<br/><i>Curve</i> <u><b>Amplitude X</b></u>, <u><b>Amplitude Y</b></u> <h2>X -> Amplitude X</h2> Controls the strength of the horizontal bend. Higher values create a stronger curve along X. <h2>Y -> Amplitude Y</h2> Controls the strength of the vertical bend. Higher values create a stronger curve along Y."
                    hidewhen "{ ffv1type != 97 ffv2type != 97 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_disc2"
                    label   "rot/twist DISC2"
                    type    vector2
                    size    2
                    default { "6" "0.5" }
                    help    "<br/><i>Disc2</i> <u><b>Rotation</b></u>, <u><b>Twist</b></u> <h2>X -> Rotation</h2> Rotates the disc pattern. Adjust this to change the overall orientation of the effect. <h2>Y -> Twist</h2> Adds a twisting offset to the disc pattern, changing how tightly or loosely it spirals."
                    hidewhen "{ ffv1type != 47 ffv2type != 47 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_escherbeta"
                    label   "beta ESCHER"
                    type    float
                    default { "1" }
                    help    "<br/><i>Escher</i> <u><b>Beta</b></u> <h2>Beta</h2> Controls the intensity of the Escher distortion. Lower values create a subtle transformation, while higher values produce stronger twisting and scaling effects."
                    hidewhen "{ ffv1type != 61 ffv2type != 61 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_fan2"
                    label   "xy FAN2"
                    type    vector2
                    size    2
                    default { "1" "1" }
                    help    "<br/><i>Fan2</i> <u><b>Size</b></u>, <u><b>Rotation</b></u> <h2>X -> Size</h2> Controls how wide each fan segment is. Lower values create many thin segments, while higher values create fewer, broader segments. <h2>Y -> Rotation</h2> Rotates the entire fan pattern around the center without changing its shape."
                    hidewhen "{ ffv1type != 34 ffv2type != 34 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_flower"
                    label   "petals/holes FLOWER"
                    type    vector2
                    size    2
                    default { "5" "0.5" }
                    help    "<br/><i>Flower</i> <u><b>Petals</b></u>, <u><b>Holes</b></u> <h2>X -> Petals</h2> Controls the number of petals in the flower pattern. Higher values create more petals and finer details. <h2>Y -> Holes</h2> Controls the amount of empty space between petals. Higher values create a more open, hollow flower shape."
                    hidewhen "{ ffv1type != 49 ffv2type != 49 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_fluxspread"
                    label   "spread FLUX"
                    type    float
                    default { "0.5" }
                    help    "<br/><i>Flux</i> <u><b>Spread</b></u> <h2>Spread</h2> Controls the intensity of the flux effect. Higher values create a wider, stronger flow distortion; lower values keep the effect tighter and more subtle."
                    hidewhen "{ ffv1type != 95 ffv2type != 95 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_julian"
                    label   "power/dist JULIAN"
                    type    vector2
                    size    2
                    default { "3" "0.5" }
                    help    "<br/><i>JuliaN</i> <u><b>Power</b></u>, <u><b>Distance</b></u> <h2>X -> Power</h2> Controls the number of repeated sections in the pattern. Higher values create more symmetrical repetitions and finer details. <h2>Y -> Distance</h2> Controls how the pattern expands or contracts from the center. Higher values change the overall spread and shape of the distortion. <br/><br/> <b>TIP</b>:<br/> <i>The copies all rotate in the same direction, creating a more continuous spiral or radial repetition.</i>"
                    hidewhen "{ ffv1type != 31 ffv2type != 31 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_juliascope"
                    label   "power/dist JULIASCOPE"
                    type    vector2
                    size    2
                    default { "3" "0.5" }
                    help    "<br/><i>JuliaScope</i> <u><b>Power</b></u>, <u><b>Distance</b></u> <h2>X -> Power</h2> Controls the number of repeated sections in the pattern. Higher values create more symmetrical details and tighter repetitions. <h2>Y -> Distance</h2> Controls how the pattern expands or contracts from the center, affecting the overall size and spread of the distortion. <br/><br/> <b>TIP</b>:<br/> <i>Creates a mirrored repetition around the center, producing kaleidoscope-like fractal patterns.</i>"
                    hidewhen "{ ffv1type != 32 ffv2type != 32 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_lazysusanxyz"
                    label   "xy LAZYSUSAN"
                    type    vector2
                    size    2
                    default { "0" "0" }
                    help    "<br/><i>Lazysusan</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X</h2> Moves the center of the effect horizontally. <h2>Y</h2> Moves the center of the effect vertically."
                    hidewhen "{ ffv1type != 63 ffv2type != 63 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_lazysusan"
                    label   "s/t/s LAZYSUSAN"
                    type    vector
                    size    3
                    default { "3.14159" "0" "0" }
                    help    "<br/><i>Lazysusan</i> <u><b>S</b></u><i>pin</i>, <u><b>T</b></u><i>wist</i>, <u><b>S</b></u><i>pace</i> <h2>X -> Spin</h2> Rotates the area near the center. Higher values increase the amount of rotation. <h2>Y -> Twist</h2> Adds extra twisting toward the center, creating a spiral-like effect. <h2>Z -> Space</h2> Controls how strongly points outside the center are pushed away."
                    hidewhen "{ ffv1type != 63 ffv2type != 63 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_mobiusre"
                    label   "re:abcd MOBIUS"
                    type    vector4
                    size    4
                    default { "1" "0" "0" "1" }
                    help    "<br/><i>Mobius real</i> <u><b>A</b></u>, <u><b>B</b></u>, <u><b>C</b></u>, <u><b>D</b></u> <h2>X -> reA - Transform</h2> Controls the main transformation strength, including rotation, scaling, and distortion. <h2>Y -> reB - Offset</h2> Controls the offset/translation of the transformation. <h2>Z -> reC - Warp</h2> Controls the amount of inversion and warping behavior. <h2>W -> reD - Balance</h2> Controls the final shift and overall transformation balance."
                    hidewhen "{ ffv1type != 96 ffv2type != 96 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_mobiusim"
                    label   "im:abcd MOBIUS"
                    type    vector4
                    size    4
                    default { "0" "0" "1" "0" }
                    help    "<br/><i>Mobius imaginary</i> <u><b>A</b></u>, <u><b>B</b></u>, <u><b>C</b></u>, <u><b>D</b></u> <h2>X -> imA - Transform</h2> Controls the main transformation strength, including rotation, scaling, and distortion. <h2>Y -> imB - Offset</h2> Controls the offset/translation of the transformation. <h2>Z -> imC - Warp</h2> Controls the amount of inversion and warping behavior. <h2>W -> imD - Balance</h2> Controls the final shift and overall transformation balance."
                    hidewhen "{ ffv1type != 96 ffv2type != 96 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_modulusXYZ"
                    label   "xy MODULUS"
                    type    vector2
                    size    2
                    default { "1" "1" }
                    help    "<br/><i>Modulus</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X</h2> Controls the horizontal repetition size. Larger values create wider repeating sections along X. <h2>Y</h2> Controls the vertical repetition size. Larger values create taller repeating sections along Y."
                    hidewhen "{ ffv1type != 66 ffv2type != 66 }"
                    range   { 0 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_ngon"
                    label   "p/s/c/c NGON"
                    type    vector4
                    size    4
                    default { "1.25" "3" "0.5" "0.25" }
                    help    "<br/><i>Ngon</i> <u><b>P</b></u><i>ower</i>, <u><b>S</b></u><i>ides</i>, <u><b>C</b></u><i>orner</i>, <u><b>C</b></u><i>ircle</i> <h2>X -> Power</h2> Controls the overall scaling and radial behavior of the shape. Higher values change the size and intensity of the transformation. <h2>Y -> Sides</h2> Controls the number of sides of the polygon. Lower values create simpler shapes (triangle, square, etc.), while higher values create more circular forms. <h2>Z -> Corner</h2> Controls the sharpness of the polygon corners. Higher values emphasize the corners; lower values make the shape smoother. <h2>W -> Circle</h2> Controls the roundness of the polygon. Higher values make the shape more circular, while lower values keep sharper polygon edges."
                    hidewhen "{ ffv1type != 28 ffv2type != 28 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_oscope"
                    label   "f/a/d/s OSCOPE"
                    type    vector4
                    size    4
                    default { "3.14159" "1" "0" "1" }
                    help    "<br/><i>Oscope</i> <u><b>F</b></u><i>requency</i>, <u><b>A</b></u><i>mplitude</i>, <u><b>D</b></u><i>amping</i>, <u><b>S</b></u><i>eparation</i> <h2>X -> Frequency</h2> Controls how many waves appear across the pattern. Higher values create more frequent oscillations. <h2>Y -> Amplitude</h2> Controls the height/strength of the wave distortion. Higher values create larger wave movements. <h2>Z -> Damping</h2> Controls how quickly the wave fades away from the center. Higher values make the effect disappear faster. <h2>W -> Separation</h2> Controls the base offset of the wave boundary, changing the position where the flip occurs."
                    hidewhen "{ ffv1type != 67 ffv2type != 67 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_parabola"
                    label   "height/width PARABOLA"
                    type    vector2
                    size    2
                    default { "2" "3" }
                    help    "<br/><i>Parabola</i> <u><b>Height</b></u>, <u><b>Width</b></u> <h2>X -> Eight</h2> Controls the vertical strength of the parabola. Higher values make the curve extend further. <h2>Y -> Width</h2> Controls the horizontal spread of the parabola. Higher values make the curve wider and softer."
                    hidewhen "{ ffv1type != 51 ffv2type != 51 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_pdjw"
                    label   "w ABCD PDJ"
                    type    vector4
                    size    4
                    default { "1" "1" "1" "1" }
                    help    "<br/><i>PDJ</i> <u><b>wA</b></u>, <u><b>wB</b></u>, <u><b>wC</b></u>, <u><b>wD</b></u> <h2>X -> wA</h2> Controls the frequency of the wave affecting the X direction. Higher values create tighter, more frequent variations. <h2>Y -> wB</h2> Controls the frequency of the wave affecting the X direction's secondary pattern. <h2>Z -> wC</h2> Controls the frequency of the wave affecting the Y direction. Higher values create tighter, more frequent variations. <h2>W -> wD</h2> Controls the frequency of the wave affecting the Y direction's secondary pattern."
                    hidewhen "{ ffv1type != 29 ffv2type != 29 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_persp"
                    label   "angle/dist PERSPECTIVE"
                    type    vector2
                    size    2
                    default { "0.5" "0.5" }
                    help    "<br/><i>Perspective</i> <u><b>Angle</b></u>, <u><b>Distance</b></u> <h2>X -> Angle</h2> Controls the viewing angle of the perspective effect. Higher values create a stronger tilt or distortion. <h2>Y -> Distance</h2> Controls the distance of the virtual camera. Higher values reduce the perspective distortion; lower values create a stronger depth effect."
                    hidewhen "{ ffv1type != 98 ffv2type != 98 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_pie"
                    label   "slice/thick/rot PIE"
                    type    vector
                    size    3
                    default { "6" "0.5" "0" }
                    help    "<br/><i>Pie</i> <u><b>Slices</b></u>, <u><b>Thickness</b></u>, <u><b>Rotation</b></u> <h2>X -> Slices</h2> Controls the number of pie sections. Higher values create more individual slices around the circle. <h2>Y -> Thickness</h2> Controls how much of each slice is filled. Lower values create thinner slices; higher values fill more of each section. <h2>Z -> Rotation</h2> Rotates the pie pattern around the center."
                    hidewhen "{ ffv1type != 38 ffv2type != 38 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_ptsym"
                    label   "o/x/y POINT SYMMETRY"
                    type    vector
                    size    3
                    default { "3" "0" "0" }
                    help    "<br/><i>Point Symmetry</i> <u><b>O</b></u><i>rder</i>, <i>Center </i><u><b>X</b></u>, <i>Center </i><u><b>Y</b></u> <h2>X -> Order</h2> Controls the number of symmetry repetitions around the center. Higher values create more repeated copies and finer radial patterns. <h2>Y -> Center X</h2> Moves the symmetry center horizontally. <h2>Z -> Center Y</h2> Moves the symmetry center vertically."
                    hidewhen "{ ffv1type != 105 ffv2type != 105 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_polynomialpow"
                    label   "pow:xy POLYNOMIAL"
                    type    vector2
                    size    2
                    default { "1" "1" }
                    help    "<br/><i>Polynomial</i> <u><b>Power X</b></u>, <u><b>Power Y</b></u> <h2>X -> Power X</h2> Controls the shape of the curve along the X axis. Higher values create stronger, sharper changes; lower values create softer curves. <h2>Y -> Power Y</h2> Controls the shape of the curve along the Y axis. Higher values create stronger, sharper changes; lower values create softer curves."
                    hidewhen "{ ffv1type != 101 ffv2type != 101 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_polynomiallc"
                    label   "lc:xy POLYNOMIAL"
                    type    vector2
                    size    2
                    default { "0" "0" }
                    help    "<br/><i>Polynomial</i> <u><b>Linear X</b></u>, <u><b>Linear Y</b></u> <h2>X -> Linear X</h2> Controls the amount of regular scaling applied along the X axis. <h2>Y -> Linear Y</h2> Controls the amount of regular scaling applied along the Y axis."
                    hidewhen "{ ffv1type != 101 ffv2type != 101 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_polynomialsc"
                    label   "sc:xy POLYNOMIAL"
                    type    vector2
                    size    2
                    default { "0" "0" }
                    help    "<br/><i>Polynomial</i> <u><b>Scale X</b></u>, <u><b>Scale Y</b></u> <h2>X -> Scale X</h2> Adds a horizontal offset to the result. <h2>Y -> Scale Y</h2> Adds a vertical offset to the result."
                    hidewhen "{ ffv1type != 101 ffv2type != 101 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_popcorn2xyz"
                    label   "xy POPCORN2"
                    type    vector2
                    size    2
                    default { "0.1" "0.1" }
                    help    "<br/><i>Popcorn2</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X -> Horizontal</h2> Controls the strength of the effect along the X (horizontal) direction. <h2>Y -> Vertical</h2> Controls the strength of the effect along the Y (vertical) direction."
                    hidewhen "{ ffv1type != 69 ffv2type != 69 }"
                    range   { 0 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_popcorn2c"
                    label   "c POPCORN2"
                    type    float
                    default { "2" }
                    help    "<br/><i>Popcorn2</i> <u><b>C</b></u> <h2>C - Detail</h2> Controls the frequency of the popcorn ripples. Higher values create finer, more intricate patterns."
                    hidewhen "{ ffv1type != 69 ffv2type != 69 }"
                    range   { 0 8 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_radialblur"
                    label   "angle RADIALBLUR"
                    type    float
                    default { "0.5" }
                    help    "<br/><i>Radial Blur</i> <u><b>Angle</b></u> <h2>Angle</h2> Controls the intensity of the radial blur. Higher values create stronger circular motion and zoom-like distortion."
                    hidewhen "{ ffv1type != 37 ffv2type != 37 }"
                    range   { 0 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_rectangles"
                    label   "xy RECTANGLE"
                    type    vector2
                    size    2
                    default { "1" "1" }
                    help    "<br/><i>Rectangles</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X -> Width</h2> Controls the width of the repeating rectangles. Larger values create wider horizontal sections. <h2>Y -> Height</h2> Controls the height of the repeating rectangles. Larger values create taller vertical sections."
                    hidewhen "{ ffv1type != 36 ffv2type != 36 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_rings2val"
                    label   "val RINGS2"
                    type    float
                    default { "1" }
                    help    "<br/><i>Rings2</i> <u><b>Value</b></u> <h2>Value</h2> Controls the size of the rings. Smaller values create more frequent rings, while larger values create wider spacing between rings."
                    hidewhen "{ ffv1type != 35 ffv2type != 35 }"
                    range   { 0 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_separationxyz"
                    label   "xy SEPARATION"
                    type    vector2
                    size    2
                    default { "0.5" "0.5" }
                    help    "<br/><i>Separation</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X -> Horizontal separation</h2> Controls the horizontal separation distance. Higher values push the left and right sides farther apart. <h2>Y -> Vertical separation</h2> Controls the vertical separation distance. Higher values push the top and bottom areas farther apart."
                    hidewhen "{ ffv1type != 71 ffv2type != 71 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_separationinsidexyz"
                    label   "inside xy SEPARATION"
                    type    vector2
                    size    2
                    default { "1.5" "1.5" }
                    help    "<br/><i>Separation</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X -> Horizontal influence</h2> Controls the horizontal influence of the separation effect. Higher values increase the internal spread along X. <h2>Y -> Vertical influence</h2> Controls the vertical influence of the separation effect. Higher values increase the internal spread along Y."
                    hidewhen "{ ffv1type != 71 ffv2type != 71 }"
                    range   { 0 4 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_splitxyz"
                    label   "xy SPLIT"
                    type    vector2
                    size    2
                    default { "4" "1" }
                    help    "<br/><i>Split</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X -> Horizontal split</h2> Controls the number of horizontal splits. Higher values create more repeated left/right flips (<i>mirror</i>) sections. <h2>Y -> Vertical split</h2> Controls the number of vertical splits. Higher values create more repeated top/bottom flips (<i>mirror</i>) sections."
                    hidewhen "{ ffv1type != 72 ffv2type != 72 }"
                    range   { 0 8 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_splitsxyz"
                    label   "xy SPLITS"
                    type    vector2
                    size    2
                    default { "1" "1" }
                    help    "<br/><i>Splits</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X -> Horizontal split distance</h2> Controls the horizontal separation offset. Higher values push the left and right sides farther apart. <h2>Y -> Vertical split distance</h2> Controls the vertical separation offset. Higher values push the top and bottom sides farther apart. <br/><br/> <b>TIP</b>:<br/> <i>Unlike <b>Split</b>, which creates repeated mirrored sections, <b>Splits</b> simply separates the positive and negative sides.</i>"
                    hidewhen "{ ffv1type != 73 ffv2type != 73 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_stripes"
                    label   "space/warp STRIPES"
                    type    vector2
                    size    2
                    default { "0.5" "0" }
                    help    "<br/><i>Stripes</i> <u><b>Space</b></u>, <u><b>Warp</b></u> <h2>X -> Space</h2> Controls the spacing and compression of the stripes. Higher values change how tightly the stripes are packed. <h2>Y -> Warp</h2> Controls the amount of bending or distortion applied to the stripes. Higher values create stronger curved stripe patterns."
                    hidewhen "{ ffv1type != 74 ffv2type != 74 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_supershape"
                    label   "m/r/h SUPERSHAPE"
                    type    vector
                    size    3
                    default { "6" "0" "2" }
                    help    "<br/><i>Supershape</i> <u><b>M</b></u>, <u><b>R</b></u><i>andom</i>, <u><b>H</b></u><i>oles</i> <h2>X -> M</h2> Controls the number of repeating features around the shape. Higher values create more lobes, points, or symmetry. <h2>Y -> Random</h2> Adds variation to the size of the generated points. Higher values create more irregular, scattered shapes. <h2>Z -> Holes</h2> Controls the amount of empty space near the center. Higher values create more open or hollow shapes."
                    hidewhen "{ ffv1type != 48 ffv2type != 48 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_supershapen"
                    label   "n SUPERSHAPE"
                    type    vector
                    size    3
                    default { "1" "1" "1" }
                    help    "<br/><i>Supershape</i> <u><b>N1</b></u>, <u><b>N2</b></u>, <u><b>N3</b></u> <h2>X -> N1</h2> Controls the overall shape transition. Changes whether the form appears more rounded or angular. <h2>Y -> N2</h2> Controls the horizontal shape characteristics. Adjusts the width and side curvature of the form. <h2>Z -> N3</h2> Controls the vertical shape characteristics. Adjusts the height and top/bottom curvature of the form."
                    hidewhen "{ ffv1type != 48 ffv2type != 48 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_waves2scalexyz"
                    label   "scale xy WAVES2"
                    type    vector2
                    size    2
                    default { "1" "1" }
                    help    "<br/><i>Waves2</i> <u><b>Scale X</b></u>, <u><b>Scale Y</b></u> <h2>X -> Scale X</h2> Controls the horizontal strength of the wave distortion. Higher values create larger movement along X. <h2>Y -> Scale Y</h2> Controls the vertical strength of the wave distortion. Higher values create larger movement along Y."
                    hidewhen "{ ffv1type != 79 ffv2type != 79 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_waves2freqxyz"
                    label   "freq xy WAVES2"
                    type    vector2
                    size    2
                    default { "1" "1" }
                    help    "<br/><i>Waves2</i> <u><b>Frequency X</b></u>, <u><b>Frequency Y</b></u> <h2>X -> Frequency X</h2> Controls how quickly the waves repeat horizontally. Higher values create tighter, more frequent waves. <h2>Y -> Frequency Y</h2> Controls how quickly the waves repeat vertically. Higher values create tighter, more frequent waves."
                    hidewhen "{ ffv1type != 79 ffv2type != 79 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_wedge"
                    label   "s/a/h/c WEDGE"
                    type    vector4
                    size    4
                    default { "0" "1.5708" "0" "2" }
                    help    "<br/><i>Wedge</i> <u><b>S</b></u><i>wirl</i>, <u><b>A</b></u><i>ngle</i>, <u><b>H</b></u><i>ole</i>, <u><b>C</b></u><i>ount</i> <h2>X -> Swirl</h2> Controls the amount of twisting applied as points move away from the center. Higher values create a stronger spiral effect. <h2>Y -> Angle</h2> Controls the rotation and width of the wedge sections. Higher values change the orientation and spacing of the wedges. <h2>Z -> Hole</h2> Controls the empty space around the center. Higher values push the pattern outward, creating a larger central gap. <h2>W -> Count</h2> Controls the number of wedge sections around the circle. Higher values create more slices and finer radial details."
                    hidewhen "{ ffv1type != 75 ffv2type != 75 }"
                    range   { 0 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_wedgejulia"
                    label   "p/a/d/c WEDGEJULIA"
                    type    vector4
                    size    4
                    default { "1" "0" "0" "1" }
                    help    "<br/><i>WedgeJulia</i> <u><b>P</b></u><i>ower</i>, <u><b>A</b></u><i>ngle</i>, <u><b>D</b></u><i>istance</i>, <u><b>C</b></u><i>ount</i> <h2>X -> Power</h2> Controls the number of Julia-style repetitions. Higher values create more repeated sections and finer details <h2>Y -> Angle</h2> Controls the rotation and compression of the wedge sections. Higher values change the orientation and spacing of the slices. <h2>Z -> Distance</h2> Controls the radial scaling of the Julia transformation. Higher values change how far the pattern expands or contracts from the center. <h2>W -> Count</h2> Controls the number of wedge sections around the circle. Higher values create more radial divisions."
                    hidewhen "{ ffv1type != 76 ffv2type != 76 }"
                    range   { 0 10 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_wedgesph"
                    label   "s/a/h/c WEDGESPH"
                    type    vector4
                    size    4
                    default { "0" "1.5708" "0" "2" }
                    help    "<br/><i>WedgeSph</i> <u><b>S</b></u><i>wirl</i>, <u><b>A</b></u><i>ngle</i>, <u><b>H</b></u><i>ole</i>, <u><b>C</b></u><i>ount</i> <h2>X -> Swirl</h2> Controls the amount of twisting applied from the center outward. Higher values create a stronger spiral distortion. <h2>Y -> Angle</h2> Controls the rotation and compression of the wedge sections. Higher values change the spacing and orientation of the wedges. <h2>Z -> Hole</h2> Controls the distance from the center where the effect begins. Higher values create a larger empty area around the center. <h2>W -> Count</h2> Controls the number of wedge sections around the circle. Higher values create more, thinner sections."
                    hidewhen "{ ffv1type != 77 ffv2type != 77 }"
                    range   { 0 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "ff_whorl"
                    label   "in/out WHORL"
                    type    vector2
                    size    2
                    default { "3" "0.5" }
                    help    "<br/><i>Whorl</i> <u><b>Inside</b></u>, <u><b>Outside</b></u> <h2>X -> Inside</h2> Controls the amount of rotation applied to points inside the radius. Higher values create a stronger inner spiral twist. <h2>Y - Outside</h2> Controls the amount of rotation applied to points outside the radius. Higher values create a stronger outer spiral twist."
                    hidewhen "{ ffv1type != 78 ffv2type != 78 }"
                    range   { 0 6 }
                    parmtag { "script_callback_language" "python" }
                }
            }

        }

        group {
            name    "f_ffpreaffine_3"
            label   "FF: PP VARS"

            groupsimple {
                name    "f_ffvariablesppdata"
                label   "FF PRE and POST VARS PARAMETERS"
                disablewhentab "{ doff == 0 }"
                grouptag { "group_type" "simple" }

                parm {
                    name    "fp1_auger"
                    label   "f/s/s/w AUGER"
                    type    vector4
                    size    4
                    default { "1" "2" "1" "1" }
                    help    "<br/><i>Auger</i> <u><b>F</b></u><i>requency</i>, <u><b>S</b></u><i>cale</i>, <u><b>S</b></u><i>ymmetry</i>, <u><b>W</b></u><i>eight</i> <h2>X -> Frequency</h2> Controls the size of the waves. Higher values create smaller, more frequent ripples. <h2>Y -> Scale</h2> Adjusts the size of the wave deformation. Higher values produce broader, more noticeable bends. <h2>Z -> Symmetry</h2> Balances how evenly the effect is applied across the pattern. <h2>W -> Weight</h2> Controls the overall strength of the deformation. Higher values produce a stronger effect."
                    hidewhen "{ ffpre1type != 94 ffp1type != 94 ffp2type != 94 }"
                    range   { 0 4 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_bent2xy"
                    label   "xy BENT2"
                    type    vector2
                    size    2
                    default { "1.5" "0" }
                    help    "<br/><i>Bent2</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X</h2> Controls how much the negative X (<i>left</i>) side of the pattern is stretched or compressed. <h2>Y</h2> Controls how much the negative Y (<i>bottom</i>) side of the pattern is stretched or compressed."
                    hidewhen "{ ffpre1type != 52 ffp1type != 52 ffp2type != 52 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_bipolarshift"
                    label   "shift BIPOLAR"
                    type    float
                    default { "1" }
                    help    "<br/><i>Bipolar</i> <u><b>Shift</b></u> <h2>Shift</h2> Moves the seam of the bipolar mapping around the pattern, changing where the transformation wraps."
                    hidewhen "{ ffpre1type != 53 ffp1type != 53 ffp2type != 53 }"
                    range   { 0 10 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_blob"
                    label   "low/high/wave BLOB"
                    type    vector
                    size    3
                    default { "0.2" "1" "6" }
                    help    "<br/><i>Blob</i> <u><b>Low</b></u>, <u><b>High</b></u>, <u><b>Waves</b></u> <h2>X -> Low</h2> Sets the minimum size of the blob. <h2>Y -> High</h2> Sets the maximum size of the blob. <h2>Z -> Waves</h2> Controls the number of bulges or lobes around the blob. Higher values create more repeating bumps."
                    hidewhen "{ ffpre1type != 30 ffp1type != 30 ffp2type != 30 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_bwraps"
                    label   "s/s/g BWRAPS"
                    type    vector
                    size    3
                    default { "0.5" "0" "1" }
                    help    "<br/><i>Bwraps</i> <u><b>S</b></u><i>ize</i>, <u><b>S</b></u><i>pace</i>, <u><b>G</b></u><i>ain</i> <h2>X -> Size</h2> Controls the size of each bubble wrap cell. Larger values create bigger wrapped areas. <h2>Y -> Space</h2> Controls the spacing between bubble cells. Higher values spread the bubbles farther apart. <h2>Z -> Gain</h2> Controls the intensity of the bubble distortion. Higher values create a stronger wrapping effect."
                    hidewhen "{ ffpre1type != 99 ffp1type != 99 ffp2type != 99 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_bwrapstwist"
                    label   "in/out twist BWRAPS"
                    type    vector2
                    size    2
                    default { "3" "0" }
                    help    "<br/><i>Bwraps</i> <u><b>IN Twist</b></u>, <u><b>OUT Twist</b></u> <h2>X -> IN Twist</h2> Controls the amount of rotation applied toward the center of each bubble. <h2>Y -> OUT Twist</h2> Controls the amount of rotation applied toward the outside of each bubble."
                    hidewhen "{ ffpre1type != 99 ffp1type != 99 ffp2type != 99 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_cellsize"
                    label   "size CELL"
                    type    float
                    default { "0.05" }
                    help    "<br/><i>Cell</i> <u><b>Size</b></u> <h2>Size</h2> Controls the size of the repeating cells. Smaller values create more, smaller cells; larger values create fewer, larger cells."
                    hidewhen "{ ffpre1type != 56 ffp1type != 56 ffp2type != 56 }"
                    range   { 0 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_conic"
                    label   "ecc/holes CONIC"
                    type    vector2
                    size    2
                    default { "0.5" "0.5" }
                    help    "<br/><i>Conic</i> <u><b>Eccentricity</b></u>, <u><b>Holes</b></u> <h2>X -> Eccentricity</h2> Controls the shape and intensity of the cone distortion. <h2>Y -> Holes</h2> Adjusts the amount of open space in the conic pattern."
                    hidewhen "{ ffpre1type != 50 ffp1type != 50 ffp2type != 50 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_cpow"
                    label   "pow/r/i CPOW"
                    type    vector
                    size    3
                    default { "2" "1" "0.25" }
                    help    "<br/><i>Cpow</i> <u><b>Power</b></u>, <u><b>R</b></u>, <u><b>I</b></u> <h2>X -> Power</h2> Controls the number of repeated spiral sections. Higher values create more repetitions and finer details. <h2>Y -> R</h2> Controls the radial distortion, affecting how the pattern expands or contracts from the center. <h2>Z -> I</h2> Controls the angular distortion, changing the twist and rotation of the pattern."
                    hidewhen "{ ffpre1type != 57 ffp1type != 57 ffp2type != 57 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_cropltrb"
                    label   "l/t/r/b CROP"
                    type    vector4
                    size    4
                    default { "-1" "-1" "1" "1" }
                    help    "<br/><i>Crop</i> <u><b>L</b></u><i>eft</i>, <u><b>T</b></u><i>op</i>, <u><b>R</b></u><i>ight</i>, <u><b>B</b></u><i>ottom</i> <h2>X -> Left</h2> Sets the left boundary of the crop area. <h2>Y -> Top</h2> Sets the top boundary of the crop area. <h2>Z -> Right</h2> Sets the right boundary of the crop area. <h2>W -> Bottom</h2> Sets the bottom boundary of the crop area."
                    hidewhen "{ ffpre1type != 102 ffp1type != 102 ffp2type != 102 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_cropaz"
                    label   "area/zero CROP"
                    type    vector2
                    size    2
                    default { "0" "0" }
                    help    "<br/><i>Crop</i> <u><b>Area</b></u>, <u><b>Zero</b></u> <h2>X -> Area</h2> Controls the amount of random repositioning inside the crop area. Higher values create a larger randomized region. <h2>Y -> Zero</h2> Controls what happens to points outside the crop area. When enabled (<i>it just need to be higher than <b>0</b>(Zero)</i>), outside points are moved to the center instead."
                    hidewhen "{ ffpre1type != 102 ffp1type != 102 ffp2type != 102 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_curlc"
                    label   "c1/c2 CURL"
                    type    vector2
                    size    2
                    default { "1" "0" }
                    help    "<br/><i>Curl</i> <u><b>C1</b></u>, <u><b>C2</b></u> <h2>X -> C1 (Curl Strength)</h2> Controls the overall curl direction and strength. Higher values create a stronger bending effect. <h2>Y -> C2 (Curl Twist)</h2> Controls the secondary curl behavior, adding more twisting and variation to the distortion."
                    hidewhen "{ ffpre1type != 27 ffp1type != 27 ffp2type != 27 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_curvexyzlenght"
                    label   "lenght:xy CURVE"
                    type    vector2
                    size    2
                    default { "1" "1" }
                    help    "<br/><i>Curve</i> <u><b>Lenght X</b></u>, <u><b>Lenght Y</b></u> <h2>X -> Lenght X</h2> Controls the horizontal range of the curve effect. Larger values make the curve spread over a wider area. <h2>Y -> Lenght Y</h2> Controls the vertical range of the curve effect. Larger values make the curve spread over a wider area."
                    hidewhen "{ ffpre1type != 97 ffp1type != 97 ffp2type != 97 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_curvexyzamp"
                    label   "amp:xy CURVE"
                    type    vector2
                    size    2
                    default { "0" "0" }
                    help    "<br/><i>Curve</i> <u><b>Amplitude X</b></u>, <u><b>Amplitude Y</b></u> <h2>X -> Amplitude X</h2> Controls the strength of the horizontal bend. Higher values create a stronger curve along X. <h2>Y -> Amplitude Y</h2> Controls the strength of the vertical bend. Higher values create a stronger curve along Y."
                    hidewhen "{ ffpre1type != 97 ffp1type != 97 ffp2type != 97 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_disc2"
                    label   "rot/twist DISC2"
                    type    vector2
                    size    2
                    default { "6" "0.5" }
                    help    "<br/><i>Disc2</i> <u><b>Rotation</b></u>, <u><b>Twist</b></u> <h2>X -> Rotation</h2> Rotates the disc pattern. Adjust this to change the overall orientation of the effect. <h2>Y -> Twist</h2> Adds a twisting offset to the disc pattern, changing how tightly or loosely it spirals."
                    hidewhen "{ ffpre1type != 47 ffp1type != 47 ffp2type != 47 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_escherbeta"
                    label   "beta ESCHER"
                    type    float
                    default { "1" }
                    help    "<br/><i>Escher</i> <u><b>Beta</b></u> <h2>Beta</h2> Controls the intensity of the Escher distortion. Lower values create a subtle transformation, while higher values produce stronger twisting and scaling effects."
                    hidewhen "{ ffpre1type != 61 ffp1type != 61 ffp2type != 61 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_fan2"
                    label   "xy FAN2"
                    type    vector2
                    size    2
                    default { "1" "1" }
                    help    "<br/><i>Fan2</i> <u><b>Size</b></u>, <u><b>Rotation</b></u> <h2>X -> Size</h2> Controls how wide each fan segment is. Lower values create many thin segments, while higher values create fewer, broader segments. <h2>Y -> Rotation</h2> Rotates the entire fan pattern around the center without changing its shape."
                    hidewhen "{ ffpre1type != 34 ffp1type != 34 ffp2type != 34 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_flower"
                    label   "petals/holes FLOWER"
                    type    vector2
                    size    2
                    default { "5" "0.5" }
                    help    "<br/><i>Flower</i> <u><b>Petals</b></u>, <u><b>Holes</b></u> <h2>X -> Petals</h2> Controls the number of petals in the flower pattern. Higher values create more petals and finer details. <h2>Y -> Holes</h2> Controls the amount of empty space between petals. Higher values create a more open, hollow flower shape."
                    hidewhen "{ ffpre1type != 49 ffp1type != 49 ffp2type != 49 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_fluxspread"
                    label   "spread FLUX"
                    type    float
                    default { "0.5" }
                    help    "<br/><i>Flux</i> <u><b>Spread</b></u> <h2>Spread</h2> Controls the intensity of the flux effect. Higher values create a wider, stronger flow distortion; lower values keep the effect tighter and more subtle."
                    hidewhen "{ ffpre1type != 95 ffp1type != 95 ffp2type != 95 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_julian"
                    label   "power/dist JULIAN"
                    type    vector2
                    size    2
                    default { "3" "0.5" }
                    help    "<br/><i>JuliaN</i> <u><b>Power</b></u>, <u><b>Distance</b></u> <h2>X -> Power</h2> Controls the number of repeated sections in the pattern. Higher values create more symmetrical repetitions and finer details. <h2>Y -> Distance</h2> Controls how the pattern expands or contracts from the center. Higher values change the overall spread and shape of the distortion. <br/><br/> <b>TIP</b>:<br/> <i>The copies all rotate in the same direction, creating a more continuous spiral or radial repetition.</i>"
                    hidewhen "{ ffpre1type != 31 ffp1type != 31 ffp2type != 31 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_juliascope"
                    label   "power/dist JULIASCOPE"
                    type    vector2
                    size    2
                    default { "3" "0.5" }
                    help    "<br/><i>JuliaScope</i> <u><b>Power</b></u>, <u><b>Distance</b></u> <h2>X -> Power</h2> Controls the number of repeated sections in the pattern. Higher values create more symmetrical details and tighter repetitions. <h2>Y -> Distance</h2> Controls how the pattern expands or contracts from the center, affecting the overall size and spread of the distortion. <br/><br/> <b>TIP</b>:<br/> <i>Creates a mirrored repetition around the center, producing kaleidoscope-like fractal patterns.</i>"
                    hidewhen "{ ffpre1type != 32 ffp1type != 32 ffp2type != 32 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_lazysusanxyz"
                    label   "xy LAZYSUSAN"
                    type    vector2
                    size    2
                    default { "0" "0" }
                    help    "<br/><i>Lazysusan</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X</h2> Moves the center of the effect horizontally. <h2>Y</h2> Moves the center of the effect vertically."
                    hidewhen "{ ffpre1type != 63 ffp1type != 63 ffp2type != 63 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_lazysusan"
                    label   "s/t/s LAZYSUSAN"
                    type    vector
                    size    3
                    default { "3.14159" "0" "0" }
                    help    "<br/><i>Lazysusan</i> <u><b>S</b></u><i>pin</i>, <u><b>T</b></u><i>wist</i>, <u><b>S</b></u><i>pace</i> <h2>X -> Spin</h2> Rotates the area near the center. Higher values increase the amount of rotation. <h2>Y -> Twist</h2> Adds extra twisting toward the center, creating a spiral-like effect. <h2>Z -> Space</h2> Controls how strongly points outside the center are pushed away."
                    hidewhen "{ ffpre1type != 63 ffp1type != 63 ffp2type != 63 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_mobiusre"
                    label   "re:abcd MOBIUS"
                    type    vector4
                    size    4
                    default { "1" "0" "0" "1" }
                    help    "<br/><i>Mobius real</i> <u><b>A</b></u>, <u><b>B</b></u>, <u><b>C</b></u>, <u><b>D</b></u> <h2>X -> reA - Transform</h2> Controls the main transformation strength, including rotation, scaling, and distortion. <h2>Y -> reB - Offset</h2> Controls the offset/translation of the transformation. <h2>Z -> reC - Warp</h2> Controls the amount of inversion and warping behavior. <h2>W -> reD - Balance</h2> Controls the final shift and overall transformation balance."
                    hidewhen "{ ffpre1type != 96 ffp1type != 96 ffp2type != 96 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_mobiusim"
                    label   "im:abcd MOBIUS"
                    type    vector4
                    size    4
                    default { "0" "0" "1" "0" }
                    help    "<br/><i>Mobius imaginary</i> <u><b>A</b></u>, <u><b>B</b></u>, <u><b>C</b></u>, <u><b>D</b></u> <h2>X -> imA - Transform</h2> Controls the main transformation strength, including rotation, scaling, and distortion. <h2>Y -> imB - Offset</h2> Controls the offset/translation of the transformation. <h2>Z -> imC - Warp</h2> Controls the amount of inversion and warping behavior. <h2>W -> imD - Balance</h2> Controls the final shift and overall transformation balance."
                    hidewhen "{ ffpre1type != 96 ffp1type != 96 ffp2type != 96 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_modulusXYZ"
                    label   "xy MODULUS"
                    type    vector2
                    size    2
                    default { "1" "1" }
                    help    "<br/><i>Modulus</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X</h2> Controls the horizontal repetition size. Larger values create wider repeating sections along X. <h2>Y</h2> Controls the vertical repetition size. Larger values create taller repeating sections along Y."
                    hidewhen "{ ffpre1type != 66 ffp1type != 66 ffp2type != 66 }"
                    range   { 0 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_ngon"
                    label   "p/s/c/c NGON"
                    type    vector4
                    size    4
                    default { "1.25" "3" "0.5" "0.25" }
                    help    "<br/><i>Ngon</i> <u><b>P</b></u><i>ower</i>, <u><b>S</b></u><i>ides</i>, <u><b>C</b></u><i>orner</i>, <u><b>C</b></u><i>ircle</i> <h2>X -> Power</h2> Controls the overall scaling and radial behavior of the shape. Higher values change the size and intensity of the transformation. <h2>Y -> Sides</h2> Controls the number of sides of the polygon. Lower values create simpler shapes (triangle, square, etc.), while higher values create more circular forms. <h2>Z -> Corner</h2> Controls the sharpness of the polygon corners. Higher values emphasize the corners; lower values make the shape smoother. <h2>W -> Circle</h2> Controls the roundness of the polygon. Higher values make the shape more circular, while lower values keep sharper polygon edges."
                    hidewhen "{ ffpre1type != 28 ffp1type != 28 ffp2type != 28 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_oscope"
                    label   "f/a/d/s OSCOPE"
                    type    vector4
                    size    4
                    default { "3.14159" "1" "0" "1" }
                    help    "<br/><i>Oscope</i> <u><b>F</b></u><i>requency</i>, <u><b>A</b></u><i>mplitude</i>, <u><b>D</b></u><i>amping</i>, <u><b>S</b></u><i>eparation</i> <h2>X -> Frequency</h2> Controls how many waves appear across the pattern. Higher values create more frequent oscillations. <h2>Y -> Amplitude</h2> Controls the height/strength of the wave distortion. Higher values create larger wave movements. <h2>Z -> Damping</h2> Controls how quickly the wave fades away from the center. Higher values make the effect disappear faster. <h2>W -> Separation</h2> Controls the base offset of the wave boundary, changing the position where the flip occurs."
                    hidewhen "{ ffpre1type != 67 ffp1type != 67 ffp2type != 67 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_parabola"
                    label   "height/width PARABOLA"
                    type    vector2
                    size    2
                    default { "2" "3" }
                    help    "<br/><i>Parabola</i> <u><b>Height</b></u>, <u><b>Width</b></u> <h2>X -> Eight</h2> Controls the vertical strength of the parabola. Higher values make the curve extend further. <h2>Y -> Width</h2> Controls the horizontal spread of the parabola. Higher values make the curve wider and softer."
                    hidewhen "{ ffpre1type != 51 ffp1type != 51 ffp2type != 51 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_pdjw"
                    label   "w ABCD PDJ"
                    type    vector4
                    size    4
                    default { "1" "1" "1" "1" }
                    help    "<br/><i>PDJ</i> <u><b>wA</b></u>, <u><b>wB</b></u>, <u><b>wC</b></u>, <u><b>wD</b></u> <h2>X -> wA</h2> Controls the frequency of the wave affecting the X direction. Higher values create tighter, more frequent variations. <h2>Y -> wB</h2> Controls the frequency of the wave affecting the X direction's secondary pattern. <h2>Z -> wC</h2> Controls the frequency of the wave affecting the Y direction. Higher values create tighter, more frequent variations. <h2>W -> wD</h2> Controls the frequency of the wave affecting the Y direction's secondary pattern."
                    hidewhen "{ ffpre1type != 29 ffp1type != 29 ffp2type != 29 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_persp"
                    label   "angle/dist PERSPECTIVE"
                    type    vector2
                    size    2
                    default { "0.5" "0.5" }
                    help    "<br/><i>Perspective</i> <u><b>Angle</b></u>, <u><b>Distance</b></u> <h2>X -> Angle</h2> Controls the viewing angle of the perspective effect. Higher values create a stronger tilt or distortion. <h2>Y -> Distance</h2> Controls the distance of the virtual camera. Higher values reduce the perspective distortion; lower values create a stronger depth effect."
                    hidewhen "{ ffpre1type != 98 ffp1type != 98 ffp2type != 98 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_pie"
                    label   "slice/thick/rot PIE"
                    type    vector
                    size    3
                    default { "6" "0.5" "0" }
                    help    "<br/><i>Pie</i> <u><b>Slices</b></u>, <u><b>Thickness</b></u>, <u><b>Rotation</b></u> <h2>X -> Slices</h2> Controls the number of pie sections. Higher values create more individual slices around the circle. <h2>Y -> Thickness</h2> Controls how much of each slice is filled. Lower values create thinner slices; higher values fill more of each section. <h2>Z -> Rotation</h2> Rotates the pie pattern around the center."
                    hidewhen "{ ffpre1type != 38 ffp1type != 38 ffp2type != 38 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_ptsym"
                    label   "o/x/y POINT SYMMETRY"
                    type    vector
                    size    3
                    default { "3" "0" "0" }
                    help    "<br/><i>Point Symmetry</i> <u><b>O</b></u><i>rder</i>, <i>Center </i><u><b>X</b></u>, <i>Center </i><u><b>Y</b></u> <h2>X -> Order</h2> Controls the number of symmetry repetitions around the center. Higher values create more repeated copies and finer radial patterns. <h2>Y -> Center X</h2> Moves the symmetry center horizontally. <h2>Z -> Center Y</h2> Moves the symmetry center vertically."
                    hidewhen "{ ffpre1type != 105 ffp1type != 105 ffp2type != 105 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_polynomialpow"
                    label   "pow:xy POLYNOMIAL"
                    type    vector2
                    size    2
                    default { "1" "1" }
                    help    "<br/><i>Polynomial</i> <u><b>Power X</b></u>, <u><b>Power Y</b></u> <h2>X -> Power X</h2> Controls the shape of the curve along the X axis. Higher values create stronger, sharper changes; lower values create softer curves. <h2>Y -> Power Y</h2> Controls the shape of the curve along the Y axis. Higher values create stronger, sharper changes; lower values create softer curves."
                    hidewhen "{ ffpre1type != 101 ffp1type != 101 ffp2type != 101 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_polynomiallc"
                    label   "lc:xy POLYNOMIAL"
                    type    vector2
                    size    2
                    default { "0" "0" }
                    help    "<br/><i>Polynomial</i> <u><b>Linear X</b></u>, <u><b>Linear Y</b></u> <h2>X -> Linear X</h2> Controls the amount of regular scaling applied along the X axis. <h2>Y -> Linear Y</h2> Controls the amount of regular scaling applied along the Y axis."
                    hidewhen "{ ffpre1type != 101 ffp1type != 101 ffp2type != 101 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_polynomialsc"
                    label   "sc:xy POLYNOMIAL"
                    type    vector2
                    size    2
                    default { "0" "0" }
                    help    "<br/><i>Polynomial</i> <u><b>Scale X</b></u>, <u><b>Scale Y</b></u> <h2>X -> Scale X</h2> Adds a horizontal offset to the result. <h2>Y -> Scale Y</h2> Adds a vertical offset to the result."
                    hidewhen "{ ffpre1type != 101 ffp1type != 101 ffp2type != 101 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_popcorn2xyz"
                    label   "xy POPCORN2"
                    type    vector2
                    size    2
                    default { "0.1" "0.1" }
                    help    "<br/><i>Popcorn2</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X -> Horizontal</h2> Controls the strength of the effect along the X (horizontal) direction. <h2>Y -> Vertical</h2> Controls the strength of the effect along the Y (vertical) direction."
                    hidewhen "{ ffpre1type != 69 ffp1type != 69 ffp2type != 69 }"
                    range   { 0 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_popcorn2c"
                    label   "c POPCORN2"
                    type    float
                    default { "2" }
                    help    "<br/><i>Popcorn2</i> <u><b>C</b></u> <h2>C - Detail</h2> Controls the frequency of the popcorn ripples. Higher values create finer, more intricate patterns."
                    hidewhen "{ ffpre1type != 69 ffp1type != 69 ffp2type != 69 }"
                    range   { 0 8 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_radialblur"
                    label   "angle RADIALBLUR"
                    type    float
                    default { "0.5" }
                    help    "<br/><i>Radial Blur</i> <u><b>Angle</b></u> <h2>Angle</h2> Controls the intensity of the radial blur. Higher values create stronger circular motion and zoom-like distortion."
                    hidewhen "{ ffpre1type != 37 ffp1type != 37 ffp2type != 37 }"
                    range   { 0 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_rectangles"
                    label   "xy RECTANGLE"
                    type    vector2
                    size    2
                    default { "1" "1" }
                    help    "<br/><i>Rectangles</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X -> Width</h2> Controls the width of the repeating rectangles. Larger values create wider horizontal sections. <h2>Y -> Height</h2> Controls the height of the repeating rectangles. Larger values create taller vertical sections."
                    hidewhen "{ ffpre1type != 36 ffp1type != 36 ffp2type != 36 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_rings2val"
                    label   "val RINGS2"
                    type    float
                    default { "1" }
                    help    "<br/><i>Rings2</i> <u><b>Value</b></u> <h2>Value</h2> Controls the size of the rings. Smaller values create more frequent rings, while larger values create wider spacing between rings."
                    hidewhen "{ ffpre1type != 35 ffp1type != 35 ffp2type != 35 }"
                    range   { 0 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_separationxyz"
                    label   "xy SEPARATION"
                    type    vector2
                    size    2
                    default { "0.5" "0.5" }
                    help    "<br/><i>Separation</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X -> Horizontal separation</h2> Controls the horizontal separation distance. Higher values push the left and right sides farther apart. <h2>Y -> Vertical separation</h2> Controls the vertical separation distance. Higher values push the top and bottom areas farther apart."
                    hidewhen "{ ffpre1type != 71 ffp1type != 71 ffp2type != 71 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_separationinsidexyz"
                    label   "inside xy SEPARATION"
                    type    vector2
                    size    2
                    default { "1.5" "1.5" }
                    help    "<br/><i>Separation</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X -> Horizontal influence</h2> Controls the horizontal influence of the separation effect. Higher values increase the internal spread along X. <h2>Y -> Vertical influence</h2> Controls the vertical influence of the separation effect. Higher values increase the internal spread along Y."
                    hidewhen "{ ffpre1type != 71 ffp1type != 71 ffp2type != 71 }"
                    range   { 0 4 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_splitxyz"
                    label   "xy SPLIT"
                    type    vector2
                    size    2
                    default { "4" "1" }
                    help    "<br/><i>Split</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X -> Horizontal split</h2> Controls the number of horizontal splits. Higher values create more repeated left/right flips (<i>mirror</i>) sections. <h2>Y -> Vertical split</h2> Controls the number of vertical splits. Higher values create more repeated top/bottom flips (<i>mirror</i>) sections."
                    hidewhen "{ ffpre1type != 72 ffp1type != 72 ffp2type != 72 }"
                    range   { 0 8 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_splitsxyz"
                    label   "xy SPLITS"
                    type    vector2
                    size    2
                    default { "1" "1" }
                    help    "<br/><i>Splits</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X -> Horizontal split distance</h2> Controls the horizontal separation offset. Higher values push the left and right sides farther apart. <h2>Y -> Vertical split distance</h2> Controls the vertical separation offset. Higher values push the top and bottom sides farther apart. <br/><br/> <b>TIP</b>:<br/> <i>Unlike <b>Split</b>, which creates repeated mirrored sections, <b>Splits</b> simply separates the positive and negative sides.</i>"
                    hidewhen "{ ffpre1type != 73 ffp1type != 73 ffp2type != 73 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_stripes"
                    label   "space/warp STRIPES"
                    type    vector2
                    size    2
                    default { "0.5" "0" }
                    help    "<br/><i>Stripes</i> <u><b>Space</b></u>, <u><b>Warp</b></u> <h2>X -> Space</h2> Controls the spacing and compression of the stripes. Higher values change how tightly the stripes are packed. <h2>Y -> Warp</h2> Controls the amount of bending or distortion applied to the stripes. Higher values create stronger curved stripe patterns."
                    hidewhen "{ ffpre1type != 74 ffp1type != 74 ffp2type != 74 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_supershape"
                    label   "m/r/h SUPERSHAPE"
                    type    vector
                    size    3
                    default { "6" "0" "2" }
                    help    "<br/><i>Supershape</i> <u><b>M</b></u>, <u><b>R</b></u><i>andom</i>, <u><b>H</b></u><i>oles</i> <h2>X -> M</h2> Controls the number of repeating features around the shape. Higher values create more lobes, points, or symmetry. <h2>Y -> Random</h2> Adds variation to the size of the generated points. Higher values create more irregular, scattered shapes. <h2>Z -> Holes</h2> Controls the amount of empty space near the center. Higher values create more open or hollow shapes."
                    hidewhen "{ ffpre1type != 48 ffp1type != 48 ffp2type != 48 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_supershapen"
                    label   "n SUPERSHAPE"
                    type    vector
                    size    3
                    default { "1" "1" "1" }
                    help    "<br/><i>Supershape</i> <u><b>N1</b></u>, <u><b>N2</b></u>, <u><b>N3</b></u> <h2>X -> N1</h2> Controls the overall shape transition. Changes whether the form appears more rounded or angular. <h2>Y -> N2</h2> Controls the horizontal shape characteristics. Adjusts the width and side curvature of the form. <h2>Z -> N3</h2> Controls the vertical shape characteristics. Adjusts the height and top/bottom curvature of the form."
                    hidewhen "{ ffpre1type != 48 ffp1type != 48 ffp2type != 48 }"
                    range   { -1 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_waves2scalexyz"
                    label   "scale xy WAVES2"
                    type    vector2
                    size    2
                    default { "1" "1" }
                    help    "<br/><i>Waves2</i> <u><b>Scale X</b></u>, <u><b>Scale Y</b></u> <h2>X -> Scale X</h2> Controls the horizontal strength of the wave distortion. Higher values create larger movement along X. <h2>Y -> Scale Y</h2> Controls the vertical strength of the wave distortion. Higher values create larger movement along Y."
                    hidewhen "{ ffpre1type != 79 ffp1type != 79 ffp2type != 79 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_waves2freqxyz"
                    label   "freq xy WAVES2"
                    type    vector2
                    size    2
                    default { "1" "1" }
                    help    "<br/><i>Waves2</i> <u><b>Frequency X</b></u>, <u><b>Frequency Y</b></u> <h2>X -> Frequency X</h2> Controls how quickly the waves repeat horizontally. Higher values create tighter, more frequent waves. <h2>Y -> Frequency Y</h2> Controls how quickly the waves repeat vertically. Higher values create tighter, more frequent waves."
                    hidewhen "{ ffpre1type != 79 ffp1type != 79 ffp2type != 79 }"
                    range   { 0 2 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_wedge"
                    label   "s/a/h/c WEDGE"
                    type    vector4
                    size    4
                    default { "0" "1.5708" "0" "2" }
                    help    "<br/><i>Wedge</i> <u><b>S</b></u><i>wirl</i>, <u><b>A</b></u><i>ngle</i>, <u><b>H</b></u><i>ole</i>, <u><b>C</b></u><i>ount</i> <h2>X -> Swirl</h2> Controls the amount of twisting applied as points move away from the center. Higher values create a stronger spiral effect. <h2>Y -> Angle</h2> Controls the rotation and width of the wedge sections. Higher values change the orientation and spacing of the wedges. <h2>Z -> Hole</h2> Controls the empty space around the center. Higher values push the pattern outward, creating a larger central gap. <h2>W -> Count</h2> Controls the number of wedge sections around the circle. Higher values create more slices and finer radial details."
                    hidewhen "{ ffpre1type != 75 ffp1type != 75 ffp2type != 75 }"
                    range   { 0 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_wedgejulia"
                    label   "p/a/d/c WEDGEJULIA"
                    type    vector4
                    size    4
                    default { "1" "0" "0" "1" }
                    help    "<br/><i>WedgeJulia</i> <u><b>P</b></u><i>ower</i>, <u><b>A</b></u><i>ngle</i>, <u><b>D</b></u><i>istance</i>, <u><b>C</b></u><i>ount</i> <h2>X -> Power</h2> Controls the number of Julia-style repetitions. Higher values create more repeated sections and finer details <h2>Y -> Angle</h2> Controls the rotation and compression of the wedge sections. Higher values change the orientation and spacing of the slices. <h2>Z -> Distance</h2> Controls the radial scaling of the Julia transformation. Higher values change how far the pattern expands or contracts from the center. <h2>W -> Count</h2> Controls the number of wedge sections around the circle. Higher values create more radial divisions."
                    hidewhen "{ ffpre1type != 76 ffp1type != 76 ffp2type != 76 }"
                    range   { 0 10 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_wedgesph"
                    label   "s/a/h/c WEDGESPH"
                    type    vector4
                    size    4
                    default { "0" "1.5708" "0" "1.5708" }
                    help    "<br/><i>WedgeSph</i> <u><b>S</b></u><i>wirl</i>, <u><b>A</b></u><i>ngle</i>, <u><b>H</b></u><i>ole</i>, <u><b>C</b></u><i>ount</i> <h2>X -> Swirl</h2> Controls the amount of twisting applied from the center outward. Higher values create a stronger spiral distortion. <h2>Y -> Angle</h2> Controls the rotation and compression of the wedge sections. Higher values change the spacing and orientation of the wedges. <h2>Z -> Hole</h2> Controls the distance from the center where the effect begins. Higher values create a larger empty area around the center. <h2>W -> Count</h2> Controls the number of wedge sections around the circle. Higher values create more, thinner sections."
                    hidewhen "{ ffpre1type != 77 ffp1type != 77 ffp2type != 77 }"
                    range   { 0 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fp1_whorl"
                    label   "in/out WHORL"
                    type    vector2
                    size    2
                    default { "3" "0.5" }
                    help    "<br/><i>Whorl</i> <u><b>Inside</b></u>, <u><b>Outside</b></u> <h2>X -> Inside</h2> Controls the amount of rotation applied to points inside the radius. Higher values create a stronger inner spiral twist. <h2>Y - Outside</h2> Controls the amount of rotation applied to points outside the radius. Higher values create a stronger outer spiral twist."
                    hidewhen "{ ffpre1type != 78 ffp1type != 78 ffp2type != 78 }"
                    range   { 0 6 }
                    parmtag { "script_callback_language" "python" }
                }
            }

        }

    }

    group {
        name    "f_flam3h_2"
        label   "CP"
        hidewhentab "{ flamefunc == 0 } { h_valid == 0 }"

        parm {
            name    "cpdisable"
            label   "disable"
            type    toggle
            invisible
            default { "1" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "cpisvalidfile"
            label   "is valid file"
            type    toggle
            invisible
            default { "0" }
            disablewhen "{ cpdisable == 1 }"
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "cpisvalidpreset"
            label   "is valid preset"
            type    toggle
            invisible
            default { "0" }
            disablewhen "{ cpdisable == 1 }"
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "hide_palette"
            label   "Hide Palette"
            type    toggle
            invisible
            default { "1" }
            disablewhen "{ cpdisable == 1 }"
            parmtag { "script_callback_language" "python" }
        }
        groupsimple {
            name    "f_cphsv"
            label   "CP HSV"
            grouptag { "group_type" "simple" }

            parm {
                name    "hsv"
                label   "HSV"
                type    vector
                size    3
                default { "1" "1" "1" }
                help    "<b>H</b>ue, <b>S</b>aturation and <b>V</b>alue of the palette's colors.<br/><br/><b>HSV</b> values are exported into the palette preset on save<br/>and also into the XML on Flame save when they are used."
                range   { 0! 1 }
                parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_palette_utils(kwargs).reset_CP(2)" }
                parmtag { "script_action_help" "[LMB] to reset the HSV parameters to their default values." }
                parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_palette_utils(kwargs).palette_hsv()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "keephsv"
                label   "keep on Load"
                type    toggle
                default { "0" }
                help    "When loading a palette, FLAM3H™ will either set the <b>HSV</b> values to the one stored into the loaded palette preset, or reset them to their defaults otherwise.<br/><br/>Toggle this option <b>ON</b> to keep the current <b>HSV</b> values untouched after loading a palette preset."
                parmtag { "script_callback" "kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
        }

        groupcollapsible {
            name    "f_cphsvpalette"
            label   "CP HSV palette - viz only"
            grouptag { "group_type" "collapsible" }

            parm {
                name    "palettehsv"
                label   "palette HSV"
                type    ramp_rgb
                default { "5" }
                help    "The palette color corrected by the HSV values for viz."
                range   { 1! 10 }
                parmtag { "rampcolordefault" "1pos ( 0 ) 1c ( 0.20000000298023224 0.05000000074505806 1 ) 1interp ( linear ) 2pos ( 0.25 ) 2c ( 0.10000000149011612 0.85000002384185791 1 ) 2interp ( linear ) 3pos ( 0.5 ) 3c ( 0.05000000074505806 1 0.10000000149011612 ) 3interp ( linear ) 4pos ( 0.75 ) 4c ( 0.94999998807907104 1 0.10000000149011612 ) 4interp ( linear ) 5pos ( 1 ) 5c ( 1 0.05000000074505806 0.05000000074505806 ) 5interp ( linear )" }
                parmtag { "rampshowcontrolsdefault" "0" }
                parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_palette_utils(kwargs).palette_cp()" }
                parmtag { "script_action_help" "[LMB] to Update HSV palette." }
                parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_palette_utils(kwargs).palette_lock()" }
                parmtag { "script_callback_language" "python" }
            }
        }

        groupsimple {
            name    "f_cppalette"
            label   "CP palette"
            grouptag { "group_type" "simple" }

            parm {
                name    "cp_bases"
                label   "Bases"
                type    ordinal
                nolabel
                joinnext
                default { "0" }
                help    "Select between different lookup samples interpolation methods (bases)"
                menu usetokenvalue {
                    "0" "![CHANNELS_linear] linear"
                    "1" "![CHANNELS_constant] constant"
                    "2" "![CHANNELS_ease] cubic"
                    "3" "![CHANNELS_bezier] bezier"
                    "4" "![CHANNELS_b_spline] bspline"
                    "5" "![CHANNELS_hermite] hermite"
                }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_palette_utils(kwargs).cp_bases_selection_msg(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
                parmtag { "sidefx::look" "icon" }
            }
            parm {
                name    "cp_lookupsamples"
                label   "lookup samples"
                type    ordinal
                nolabel
                joinnext
                default { "256" }
                menu usetokenvalue {
                    "256"   "![opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteSVG.svg]256"
                    "512"   "![opdef:/alexnardini::Sop/FLAM3H?icon_optionEnabledSVG.svg]512"
                    "1024"  "![opdef:/alexnardini::Sop/FLAM3H?icon_optionEnabledHighSVG.svg]1024     "
                }
                parmtag { "script_callback" "kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "cp_lookupsamples_label"
                label   "samples"
                type    data
                default { "0" }
                help    "<h3>256 by default<br/>The amount of lookup samples to use to sample this palette</h3>Next to this menu on its left side you can find a mini-menu to allow you to choose between different interpolation methods for the lookup samples color keys values. Keep in mind that these are interpolation methods between the lookup samples that are used to sample the palette, not between the color keys of the palette itself.<br/><br/>Lookup samples have no connection on the palette you design. Only a few color keys can be made; nevertheless, the palette will be internally sampled (<i>linearly spaced</i>) from <b>ZERO</b> (<i>start</i>) to <b>ONE</b> (<i>end</i>) using this amount of samples.<br/><br/><i>The amount of linearly spaced color keys in a typical fractal Flame is equivalent to <b>256</b>, which is the default</i>.<br/><br/>However,<br/>if you create a palette with more than <b>256</b> color keys you might eventually want to use an higher amount of samples to be sure to catch all the subtle color variations of the palette.<br/>In general, <b>256</b> lookup samples will always be good.<br/><br/>Saving out a Flame into a file, will also save the palette lookup samples value so that you can restore it once you load the Flame back into FLAM3H™.<br/><br/><i>If the file do not posses a lookup samples XML key, the default value of <b>256</b> will be used instead</i>.<br/><br/>Saving a Flame out will always save the palette with <b>256</b> color's keys.<br/>If you created a palette with more than <b>256</b> colors, for example with <b>1024</b> color keys and sample it with <b>1024</b> samples to take into account all the subtle color changes,<br/>turn <b>ON</b> the Preferences general option -> \"palette 256+\" toggle<br/>(<i>it is <b>ON</b> by default</i>)."
                parmtag { "script_callback" "" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "palette"
                label   "palette"
                type    ramp_rgb
                default { "5" }
                help    "The source palette."
                range   { 1! 10 }
                parmtag { "rampcolordefault" "1pos ( 0 ) 1c ( 0.20000000298023224 0.05000000074505806 1 ) 1interp ( linear ) 2pos ( 0.25 ) 2c ( 0.10000000149011612 0.85000002384185791 1 ) 2interp ( linear ) 3pos ( 0.5 ) 3c ( 0.05000000074505806 1 0.10000000149011612 ) 3interp ( linear ) 4pos ( 0.75 ) 4c ( 0.94999998807907104 1 0.10000000149011612 ) 4interp ( linear ) 5pos ( 1 ) 5c ( 1 0.05000000074505806 0.05000000074505806 ) 5interp ( linear )" }
                parmtag { "rampshowcontrolsdefault" "0" }
                parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_palette_utils(kwargs).reset_CP_palette_action()" }
                parmtag { "script_action_help" "[LMB] to Reset the palette to its default values. This has also the important property to remove and clear all keyframes/expressions if any in this Palette and/or in the HSV Palette as well. [CTRL+LMB] to only remove and clear all keyframes/expressions if any in this Palette and/or in the HSV Palette as well, keeping them both untouched." }
                parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteToolSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_palette_utils(kwargs).palette_cp(True)" }
                parmtag { "script_callback_language" "python" }
            }
        }

        groupsimple {
            name    "f_cptmppalette"
            label   "CP palette tmp"
            invisibletab
            grouptag { "group_type" "simple" }

            parm {
                name    "palettetmp"
                label   "palette temp"
                type    ramp_rgb
                default { "2" }
                help    "The temporary palette.\\n\\nThis palette is used as a clone of the palette loaded from a palette preset file and used to compare and understand if the user made any modification to the loaded palette preset."
                range   { 1! 10 }
                parmtag { "rampcolordefault" "1pos ( 0 ) 1c ( 0.99899899959564209 0 0 ) 1interp ( linear ) 2pos ( 1 ) 2c ( 0.99899899959564209 0 0 ) 2interp ( linear )" }
                parmtag { "rampshowcontrolsdefault" "0" }
                parmtag { "script_callback" "" }
                parmtag { "script_callback_language" "python" }
            }
        }

        groupsimple {
            name    "f_cppresets"
            label   "CP presets"
            grouptag { "group_type" "simple" }

            parm {
                name    "palettefile"
                label   "JSON file"
                type    file
                default { "" }
                help    "Load an already created FLAM3H™ <b>json</b> palette library file<br/>or choose the path and name of a new one to create."
                parmtag { "filechooser_pattern" "*.json" }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_init_presets_CP_PRESETS(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "palettename"
                label   "palette name"
                type    string
                default { "" }
                help    "Save this palette with this name.<br/><br/>If no name is provided, a default name composed of today's date and current time will be used instead."
                parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_palette_utils(kwargs).flam3h_ramp_save()" }
                parmtag { "script_action_help" "[LMB] to save this Palette inside the selected file. If the file doesn't exit yet it will create it. If the file contain already some palette, it will append it. [CTRL+LMB] to erase the content of the file and save only the current Palette in it. [SHIFT+LMB] if not a valid filepath is present already it will open a file chooser, otherwise it will open the file explorer to the file location. If the selected file is not a valid Palette JSON file type, nothing will happen. [ALT+LMB] to save the current palette into the Clipboard as a JSON data." }
                parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_WhiteStarSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_palette_utils(kwargs).cp_preset_name_set(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "palettepresets_off"
                label   "CP file contents"
                type    string
                default { "-1" }
                help    "<h2>No preset loaded</h2>Select a palette preset to load.<br/>As many entries as there are palette in the file you are loading will be added to this preset menu, if any are present.<br/><br/>Once you add a new palette preset to it, this menu will update too.<br/>It will always be set to the last palette's name you saved."
                hidewhen "{ cpisvalidpreset == 1 }"
                menu {
                    [ "menu = hou.phm().flam3.flam3h_palette_utils(kwargs).menu_cp_presets_empty()" ]
                    [ "return menu" ]
                    language python
                }
                parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_palette_utils(kwargs).json_to_flam3h_ramp()" }
                parmtag { "script_action_help" "[LMB] to load the selected CP palette preset if any. To populate this menu, load a palette *.json file first inside the CP Tab or [SHIFT+LMB] to open a floating file chooser. [CTRL+LMB] to copy the selected preset name into the \"palette name\" string parameter. [ALT+LMB] to load a palette from the Clipboard (it will import palette data from the clipboard either from a JSON data or from a full Flame preset XML data)." }
                parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionPRIDEDisabledSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_palette_utils(kwargs).json_to_flam3h_ramp(False), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "palettepresets"
                label   "CP file contents"
                type    string
                default { "-1" }
                help    "<h2>Preset loaded</h2>Select a palette preset to load.<br/>As many entries as there are palette in the file you are loading will be added to this preset menu, if any are present.<br/><br/>Once you add a new palette preset to it, this menu will update too.<br/>It will always be set to the last palette's name you saved."
                hidewhen "{ cpisvalidpreset == 0 }"
                menu {
                    [ "menu = hou.phm().flam3.flam3h_palette_utils(kwargs).menu_cp_presets()" ]
                    [ "return menu" ]
                    language python
                }
                parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_palette_utils(kwargs).json_to_flam3h_ramp()" }
                parmtag { "script_action_help" "[LMB] to reload the selected CP palette preset, if any. [SHIFT+LMB] to open a floating file chooser. [CTRL+LMB] to copy the selected preset name into the \"palette name\" string parameter. [ALT+LMB] to load a palette from the Clipboard (it will import palette data from the clipboard either from a JSON data or from a full Flame preset XML data)." }
                parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionCPSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_palette_utils(kwargs).json_to_flam3h_ramp(False), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "palettemsg"
                label   "palettemsg"
                type    label
                default { "" }
                parmtag { "sidefx::look" "block" }
            }
        }

        groupcollapsible {
            name    "f_cpoptions"
            label   "CP options"
            invisibletab
            grouptag { "group_type" "collapsible" }

            parm {
                name    "cppaletteplus"
                label   "palette 256+"
                type    toggle
                default { "1" }
                help    "ON by default.\\nIt will allow the CP Palette to be saved with more than 256 color keys assuming you created a Palette with this many colors."
                parmtag { "script_callback" "hou.phm().flam3.out_flame_utils(kwargs).out_palette_256_plus_check()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "savehsv"
                label   "palette HSV"
                type    toggle
                default { "0" }
                help    "OFF by default.\\nWhen saving out a palette, FLAM3H by default uses the non-color-corrected ramp and save the HSV values along with it if used ( different from default values ).\\n\\nIf switched ON,\\nthis option will allow you to save the color-corrected HSV ramp instead.\\nIt will also clamp the HSV palette colors on save to 0-255."
                parmtag { "script_callback_language" "python" }
            }
        }

    }

    group {
        name    "f_flam3h_3"
        label   "MB"
        disablewhentab "{ gpu == 1 }"
        hidewhentab "{ flamefunc == 0 } { h_valid == 0 }"

        groupsimple {
            name    "f_mbmain"
            label   "MB"
            grouptag { "group_type" "simple" }

            parm {
                name    "domb"
                label   "On"
                type    toggle
                default { "0" }
                help    "<h2>CPU(<i>Cvex</i>) mode only</h2><h3>Turn this ON to compute a proper temporal motion blur (<i>centered</i>)</h3>If you animate any of the available parameters using expressions,<br/>remember to always use <b>@Time</b> and not <b>$F</b><br/>so FLAM3H™ will be able to interpolate through time properly."
                parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_general_utils(kwargs).reset_MB(False)" }
                parmtag { "script_action_help" "[LMB] to reset the Motion Blur parameters to their default values." }
                parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteSVG.svg" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "fps"
                label   "fps"
                type    integer
                default { "24" }
                help    "<h3>Desired Frames Per Second</h3>Frames per second (<i><b>FPS</b></i>) significantly impacts the appearance of motion blur in video, with lower frame rates like 24 or 30 <b>FPS</b> naturally exhibiting more motion blur."
                disablewhen "{ domb == 0 }"
                range   { 1! 48 }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "mbsamples"
                label   "samples"
                type    integer
                default { "16" }
                help    "<h3>Number of motion blur samples</h3>Higher values increase the quality and produce a smoother blur."
                disablewhen "{ domb == 0 }"
                range   { 4! 64 }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "shutter"
                label   "shutter time"
                type    float
                default { "0.5" }
                help    "<h3>Shutter time</h3>Bigger shutter time creating more blur and smaller shutter time freezing motion. "
                disablewhen "{ domb == 0 }"
                range   { 0 1 }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "vizmb"
                label   "viz mb"
                type    toggle
                default { "0" }
                help    "<h3>Visualize motion blur using color</h3>(<i>Set the viewport background to black for better viewing</i>).<br/><br/>Causes every motion blur sample/pass to get darker outward from the center to simulate the fading away due to motion/camera shutter speed. It will modify the <b>@Cd</b> point attribute.<br/><br/><b>NOTE</b>:<br/>When rendering, keep in mind to turn this <b>OFF</b> to avoid superimposing a darker color."
                disablewhen "{ domb == 0 }"
                parmtag { "script_callback_language" "python" }
            }
        }

        parm {
            name    "mp_msg"
            label   "mb_msg"
            type    label
            default { "Motion Blur is not available in GPU mode." }
            hidewhen "{ gpu == 0 }"
            parmtag { "sidefx::look" "block" }
        }
    }

    group {
        name    "f_flam3h_4"
        label   "IN"
        hidewhentab "{ h_valid == 0 }"

        parm {
            name    "indisable"
            label   "disable"
            type    toggle
            invisible
            default { "1" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "inisvalidfile"
            label   "is valid file"
            type    toggle
            invisible
            default { "0" }
            disablewhen "{ indisable == 1 }"
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "inisvalidpreset"
            label   "is valid preset"
            type    toggle
            invisible
            default { "0" }
            disablewhen "{ indisable == 1 }"
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "inclipboard"
            label   "is clipboard"
            type    toggle
            invisible
            default { "0" }
            disablewhen "{ indisable == 1 }"
            parmtag { "script_callback_language" "python" }
        }
        groupsimple {
            name    "f_inmain"
            label   "IN"
            grouptag { "group_type" "simple" }

            parm {
                name    "inpath"
                label   "IN flame"
                type    file
                default { "" }
                help    "Load <i><b>*.flame</b></i> files created with FLAM3H™, Fractorium, Apophysis<br/>and other third-party programs able to save in a Flame file format.<br/><br/>The only restrictions are:<br/>The flames contained in the file must use the same variations included inside FLAM3H™.<br/><br/>Each iterator/xform can have:<ul><li><b>PRE_BLUR</b> plus <b>2 PRE</b></li><li><b>4 VARS</b></li><li><b>1 POST</b></li></ul>variations, for a total of <b>8</b> vars per iterator.<br/><br/>For <b>FF</b> ( <i>FinalXForm</i> ) you have:<ul><li><b>1 PRE</b></li><li><b>2 VARS</b></li><li><b>2 POST</b></li></ul>variations, for a total of <b>5</b> vars in the <b>FF</b>.<br/><br/>If more variations are used, the excess ones will be discarded."
                parmtag { "filechooser_mode" "read" }
                parmtag { "filechooser_pattern" "*.flame" }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_init_presets_IN_PRESETS(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "inpresets_disabled"
                label   "IN file contents"
                type    string
                default { "-1" }
                help    "<h2>No preset loaded</h2>As many entries as there are flames in the file you are loading will be added to this preset menu.<br/><br/>Each entry will display the Flame preset' name."
                hidewhen "{ inisvalidfile == 1 inisvalidpreset == 1 }"
                menu {
                    [ "menu = hou.phm().flam3.in_flame_utils(kwargs).menu_in_presets_empty()" ]
                    [ "return menu" ]
                    language python
                }
                parmtag { "script_action" "kwargs['node'].hdaModule().flam3.in_flame_utils(kwargs).in_to_flam3h()" }
                parmtag { "script_action_help" "[LMB] to load this preset. [SHIFT+LMB] to open a floating file chooser. [ALT+LMB] to load a Flame from the Clipboard." }
                parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_WhiteSVG_disabled.svg" }
                parmtag { "script_callback" "hou.phm().flam3.in_flame_utils(kwargs).in_to_flam3h(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "inpresets"
                label   "IN file contents"
                type    string
                default { "-1" }
                help    "<h2>Preset loaded</h2>As many entries as there are flames in the file you are loading will be added to this preset menu.<br/><br/>Each entry will display the Flame preset' name."
                hidewhen "{ inisvalidfile == 1 inisvalidpreset == 0 } { inisvalidfile == 0 }"
                menu {
                    [ "menu = hou.phm().flam3.in_flame_utils(kwargs).menu_in_presets()" ]
                    [ "return menu" ]
                    language python
                }
                parmtag { "script_action" "kwargs['node'].hdaModule().flam3.in_flame_utils(kwargs).in_to_flam3h()" }
                parmtag { "script_action_help" "[LMB] to reload this preset. [SHIFT+LMB] to open a floating file chooser. [ALT+LMB] to load a Flame from the Clipboard." }
                parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_WhiteSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.in_flame_utils(kwargs).in_to_flam3h(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
        }

        groupsimple {
            name    "f_inloadprefs"
            label   "IN prefs"
            disablewhentab "{ gpu == 1 }"
            hidewhentab "{ gpu == 1 }"
            grouptag { "group_type" "simple" }

            parm {
                name    "iternumonload"
                label   "iterations on Load"
                type    integer
                default { "24" }
                help    "When loading <i><b>*.flame</b></i> files,<br/>FLAM3H™ will load them in and automatically set the iteration number to <b>64</b>, which seems like a fair amount to resolve most of them fairly well.<br/><br/>However,<br/>sometimes you just want to be quick, and you can override the iteration set on load using this value.<br/><br/><b>NOTE</b>:<br/>The iterations number baked into the Flame preset name will override this setting.<br/><br/>Turn ON \"override iterations from Flame name\" to override the iterations number baked into the Flame preset name."
                disablewhen "{ useiteronload == 0 }"
                range   { 1! 128 }
                parmtag { "script_callback" "hou.phm().flam3.in_flame_utils(kwargs).set_iter_on_load_callback(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "useiteronload"
                label   "force iterations on Load"
                type    toggle
                default { "0" }
                help    "It will use a selected number of iterations every time it loads a Flame from a flame file, instead of the default 64.<br/><br/><b>NOTE</b>:<br/>The iterations number baked into the Flame preset name will override this setting.<br/><br/>Turn ON \"override iterations from Flame name\" to override the iterations number baked into the Flame preset name."
                parmtag { "script_callback" "hou.phm().flam3.in_flame_utils(kwargs).use_iter_on_load_callback(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "oritername"
                label   "override iterations from Flame name"
                type    toggle
                default { "0" }
                help    "Override the iterations number baked into the Flame preset name if any."
                disablewhen "{ useiteronload == 0 }"
                parmtag { "script_callback" "hou.phm().flam3.in_flame_utils(kwargs).use_iter_on_load_callback(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
        }

        groupcollapsible {
            name    "f_inloadoptions"
            label   "IN options"
            grouptag { "group_type" "collapsible" }

            parm {
                name    "in_f3h_affine"
                label   "F3H affine style"
                type    toggle
                default { "1" }
                help    "Use the <b>F3H affine style</b> format on load if they are present.<br/><br/>To be used when loading Flame presets that posses <b>F3H affine style</b> format in it. If not nothing will happen and FLAM3H™ will load the Flame preset using the standard <b>Flam3 affine style</b>.<br/><br/><b>F3H affine style</b> format are useful when you rotate iterators using the <b>Rot angle</b> parameter and you still want to reload the Flame using the Rotation value instead of the affine transformed by that Rotation whitch can lead to values that are hard to edit once loaded.<br/><br/><b>NOTE</b>:<br/><b>F3H affine style</b> format are only available when you save a Flame preset out from FLAM3H™ using the OUT tab option's \"F3H affine style\" whitch is <b>ON</b> by default.<br/><br/>You need to reload the current Flame preset for this change to take effect."
                parmtag { "script_action" "kwargs['node'].hdaModule().flam3.in_flame_utils(kwargs).in_to_flam3h_toggle_f3h_affine()" }
                parmtag { "script_action_help" "[LMB] to switch ON/OFF this toggle and reload the currenlty selected IN preset right after using the new settings. [ALT+LMB] to perform the same operation but while loading a Flame from the Clipboard instead." }
                parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteToolSVG.svg" }
                parmtag { "script_callback" "kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "propertiescp"
                label   "copy render properties on Load"
                type    toggle
                default { "1" }
                help    "It will automatically copy all the render properties (<b>SENSOR</b>, <b>RENDER</b> and <b>CC CURVES</b>) into the OUT render properties every time you load a Flame preset in.<br/><br/>You need to reload the current Flame preset for this change to take effect.<br/><br/><b>NOTE</b>:<br/>All the render properties of a Flame preset loaded from the clipboard will be automatically copied into the OUT render properties on load."
                parmtag { "script_action" "kwargs['node'].hdaModule().flam3.in_flame_utils(kwargs).in_to_flam3h_toggle(\"propertiescp\")" }
                parmtag { "script_action_help" "[LMB] to switch ON/OFF this toggle and reload the currenlty selected IN preset right after using the new settings." }
                parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteSVG.svg" }
                parmtag { "script_callback" "kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
        }

        groupsimple {
            name    "f_ininfos"
            label   "IN infos"
            hidewhentab "{ flamefunc == 0 } { inisvalidpreset == 0 }"
            grouptag { "group_type" "simple" }

            parm {
                name    "icon_in_infos"
                label   "IN Flame preset informations"
                type    button
                nolabel
                joinnext
                default { "0" }
                help    "<h3>Display informations about the loaded Flame preset</h3>Those infos include all the Missing variations if any are found in the currently loaded Flame preset.<br/><br/>All of the variations that Fractorium has but FLAM3H™ does not are known as: <b>MISSING</b> variations.<br/><br/>FLAM3H™ was designed to work in tandem with Fractorium, and it makes an effort to learn as much as it can about everything that Fractorium is capable of, in this case, about all the variations he possess.<br/><br/>All of the variations that Fractorium lacks will be classified as: <b>UNKNOWN</b> variations."
                disablewhen "{ indisable == 1 }"
                parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarBlueSVG.svg" }
                parmtag { "script_callback" "" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "flamestats_heading"
                label   "flamestats_heading"
                type    label
                default { "" }
                disablewhen "{ indisable == 1 }"
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "flamestats_msg"
                label   "flamestats_msg"
                type    label
                default { "" }
                parmtag { "sidefx::look" "block" }
            }
            parm {
                name    "descriptive_msg"
                label   "descriptive_msg"
                type    label
                invisible
                default { "" }
                parmtag { "sidefx::look" "block" }
            }
        }

        groupcollapsible {
            name    "f_inrenderoptions"
            label   "IN render properties"
            hidewhentab "{ flamefunc == 0 } { inisvalidpreset == 0 }"
            grouptag { "group_type" "collapsible" }
            parmtag { "sidefx::header_parm" "cprendervals" }

            parm {
                name    "cprendervals"
                label   "Copy ALL IN Flame preset render properties"
                type    button
                nolabel
                joinnext
                default { "0" }
                help    "<br/>[<b>LMB</b>] to copy ALL the loaded Flame preset renderer properties (<i><b>SENSOR</b>, <b>RENDER</b> and <b>CC CURVES</b> settings</i>) intos the OUT render properties.<br/><br/><b>NOTE</b>:<br/>All the render properties of a Flame preset loaded from the Clipboard will be automatically copied into the OUT render properties on load (<i><b>SENSOR</b>, <b>RENDER</b> and <b>CC CURVES</b> settings</i>)."
                disablewhen "{ inisvalidpreset == 0 }"
                parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_StarSwapRedCopyPasteInfosSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.in_flame_utils.in_copy_render_all_stats_msg(kwargs, None, False, True), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "flamerender_heading"
                label   "flamerender_heading"
                type    label
                default { "" }
                disablewhen "{ indisable == 1 }"
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "empty_in_01"
                label   "empty"
                type    geometrydata
                nolabel
                default { "0" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "icon_in_infos_sensor"
                label   "SENSOR"
                type    button
                default { "0" }
                help    "<br/>[<b>LMB</b>] to copy only the loaded Flame preset <b>SENSOR</b> settings intos the OUT Sensor settings.<br/><br/><b>NOTE</b>:<br/>All the render properties of a Flame preset loaded from the Clipboard will be automatically copied into the OUT render properties on load (<i><b>SENSOR</b>, <b>RENDER</b> and <b>CC CURVES</b> settings</i>)."
                disablewhen "{ inisvalidpreset == 0 }"
                hidewhen "{ inisvalidpreset == 0 }"
                parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_StarSwapRedCopyPasteAffineSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.in_flame_utils.in_copy_sensor_stats_msg(kwargs)" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "flamesensor_msg"
                label   "flamesensor_msg"
                type    label
                default { "" }
                hidewhen "{ inisvalidpreset == 0 }"
                parmtag { "sidefx::look" "block" }
            }
            parm {
                name    "icon_in_infos_render"
                label   "RENDER"
                type    button
                default { "0" }
                help    "<br/>[<b>LMB</b>] to copy only the loaded Flame preset <b>RENDER</b> and <b>CC CURVES</b> settings intos the OUT Renderer serttings.<br/><br/><b>NOTE</b>:<br/>All the render properties of a Flame preset loaded from the Clipboard will be automatically copied into the OUT render properties on load (<i><b>SENSOR</b>, <b>RENDER</b> and <b>CC CURVES</b> settings</i>)."
                disablewhen "{ inisvalidpreset == 0 }"
                hidewhen "{ inisvalidpreset == 0 }"
                parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_StarSwapRedCopyPasteAffineSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.in_flame_utils.in_copy_render_stats_msg(kwargs)" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "flamerender_msg"
                label   "flamerender_msg"
                type    label
                default { "" }
                hidewhen "{ inisvalidpreset == 0 }"
                parmtag { "sidefx::look" "block" }
            }
        }

    }

    group {
        name    "f_flam3h_5"
        label   "OUT"
        hidewhentab "{ flamefunc == 0 } { h_valid == 0 }"

        parm {
            name    "outdisable"
            label   "disable"
            type    toggle
            invisible
            default { "1" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "outisvalidfile"
            label   "is valid file"
            type    toggle
            invisible
            default { "0" }
            disablewhen "{ outdisable == 1 }"
            parmtag { "script_callback_language" "python" }
        }
        groupsimple {
            name    "f_outmain"
            label   "OUT"
            grouptag { "group_type" "simple" }

            parm {
                name    "outpath"
                label   "OUT flame"
                type    file
                default { "" }
                help    "<h3>Select a file name to save your Flame into</h3>If the selected file does not exist, it will be created."
                parmtag { "filechooser_pattern" "*.flame" }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_init_presets_OUT_PRESETS(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "outname"
                label   "Flame name"
                type    string
                default { "" }
                help    "<h3>Save this Flame with this name</h3>This is the name the Flame will have inside the XML file.<br/><br/>If no name is provided, a default name composed of today's date and current time will be used instead."
                parmtag { "script_action" "kwargs['node'].hdaModule().flam3.out_flame_utils(kwargs).out_XML()" }
                parmtag { "script_action_help" "[LMB] to save this Flame inside the selected OUT file, if any. If the file doesn't exit yet it will create it. If the file contain already some Flames, it will append it. [CTRL+LMB] to erase the content of the file and save only the current Flame in it. [SHIFT+LMB] if not a valid filepath is present already it will open a file chooser, otherwise it will open the file explorer to the file location. [ALT+LMB] to save this Flame into the Clipboard. " }
                parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_WhiteStarSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.out_flame_utils(kwargs).out_auto_add_iter_num_to_prm(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "outpresets"
                label   "OUT file contents"
                type    string
                default { "-1" }
                help    "<h3>This menu is only for informational purposes</h3>It will show the Flame presets contained in the selected output file, if any are present. Once you add a new Flame to it, this menu will update too. It will always be set to the last Flame name you saved.<br/><br/>It will also print quick informations (<i>in the status bar and as a flash message in the network editor</i>)<br/>about the Flame preset when one is selected.<br/><br/>Quick infos are:<ul><li><b>Flame preset name</b> (<i>only in the status bar</i>)</li><li><b>FF</b>: when finalXform(<b>FF</b>) is being used</li><li><b>RIP</b>: when <b>R</b>emove <b>I</b>nvalid <b>P</b>oints(<i><b>RIP</b></i>) is being used (<i>only in the status bar</i>)</li><li><b>F3C</b>: when Flam3 Compatibility is being used (<i>only in the status bar</i>)</li><li><b>XF</b>: Number of iterators/xforms being used</li><li><b>Palette</b>: number of colors in the palette</li><li><b>HSV</b>: when <b>HSV</b> color correction is being used</li><li><b>HSV values</b> (<i>only in the status bar</i>)</li><li><b>Basis</b>: palette lookup sample interpolation method being used</li></ul>"
                menu {
                    [ "menu = hou.phm().flam3.out_flame_utils(kwargs).menu_out_contents_presets()" ]
                    [ "return menu" ]
                    language python
                }
                parmtag { "script_action" "kwargs['node'].hdaModule().flam3.out_flame_utils(kwargs).out_presets_copy_menu_label_callback()" }
                parmtag { "script_action_help" "[LMB] to copy the currently selected OUT Flame preset' name into the OUT Flame name parameter string field. [SHIFT+LMB] to print quick informations message about the selected OUT Flame preset. [CTRL+LMB] to display the Flame name informations/tips. [ALT+LMB] to copy the selected OUT Flame preset into the Clipboard." }
                parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarBlueToolSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.out_flame_utils(kwargs).out_to_flam3h_quick(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "outmsg"
                label   "outmsg"
                type    label
                default { "" }
                parmtag { "sidefx::look" "block" }
            }
        }

        groupcollapsible {
            name    "f_outoptions"
            label   "OUT options"
            grouptag { "group_type" "collapsible" }

            parm {
                name    "outpalette"
                label   "palette HSV"
                type    toggle
                default { "0" }
                help    "<h3>If switched <b>ON</b>, this option will allow you to save the color-corrected <b>HSV</b> palette instead</h3>When saving out a Flame, FLAM3H™ by default uses the non-color-corrected palette and save the <b>HSV</b> values along with it if used (<i>different from default values</i>).<br/><br/>This option will clamp the palette colors on save to <b>0</b>-<b>255</b> and you should use this only when you want to export the desired colors to be loaded inside Fratorium or Apophysis or other fractal flame editors out there."
                parmtag { "script_callback" "kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "out_f3h_affine"
                label   "F3H affine style"
                type    toggle
                default { "1" }
                help    "<h3>Save the Flame out with also the <b>F3H affine style</b> format</h3><b>F3H affine style</b> format are useful when you rotate iterators using the <b>Rot angle</b> parameter and you still want to reload the Flame using the Rotation value instead of the affine transformed by that Rotation whitch can lead to values that are hard to edit once loaded back into FLAM3H™.<br/><br/><b>NOTE</b>:<br/>When this toggle is <b>ON</b>, both <b>affine</b> and <b>F3H affine style</b> formats are saved with the Flame preset so that you can still load the saved Flame into other applications."
                parmtag { "script_callback" "kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "out_in_flame_name"
                label   "Flame name inherit on Load"
                type    toggle
                default { "0" }
                help    "<h3>Cause the OUT Flame name parameter to automatically be set to the name of the loaded IN flame preset</h3>It will work for Flame presets loaded from a disk file or from the Clipboard."
                parmtag { "script_callback" "hou.phm().flam3.out_flame_utils(kwargs).out_flame_name_inherit_on_load(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "outfractoriumprm"
                label   "use Fractorium paramtetrics"
                type    toggle
                default { "1" }
                help    "<h3>To export the parameter names for parametric variations to the one that Fractorium uses</h3>This is only useful if you have used the <b>Oscope</b> and/or the <b>Mobius</b> variations and you would like to load the saved Flame into Fractorium as it uses diferent parametric parameter's names for these.<br/><br/><b>NOTE</b>:<br/>For a Flame to be loaded inside Apophysis check this toggle <b>OFF</b> when saving it out if it is using the <b>Oscope</b> and/or the <b>Mobius</b> variations."
                parmtag { "script_callback" "kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "autoadditer"
                label   "add iterations to Flame name"
                type    toggle
                default { "1" }
                help    "<h2>CPU(<i>Cvex</i>) mode only</h2>It will automatically append the iteration number to the Flame name you enter. Once you type in a Flame name, changing the iteration number will update the Flame name too.<br/><br/><i>It will also autocorrect the flame name string based on internally defined rules</i>.<br/><br/><b>NOTE</b>:<br/>This option is not needed when in GPU mode."
                disablewhen "{ gpu == 1 }"
                parmtag { "script_callback" "hou.phm().flam3.out_flame_utils(kwargs).out_auto_change_iter_num_to_prm(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
        }

        groupcollapsible {
            name    "f_outrenderproperties"
            label   "OUT render properties"
            parmtag { "group_default" "1" }
            grouptag { "group_type" "collapsible" }

            parm {
                name    "outedit"
                label   "edit render properties"
                type    toggle
                default { "0" }
                help    "<h3>Allow the editing of the Flame render properties</h3>These properties will be stored into the preset file when you save this Flame out from FLAM3H™.<br/><br/><i>They will control how the saved fractal Flame will render inside other applications like <b>Fractorium</b> and <b>Apophysis</b>. They are their renderer settings, and they will be exported into the <b>XML</b> file</i>.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
                parmtag { "script_action" "kwargs['node'].hdaModule().flam3.out_flame_utils(kwargs).reset_OUT_kwargs()" }
                parmtag { "script_action_help" "[LMB] to reset all the OUT Render properties. [SHIFT+LMB] to reset only the OUT Camera SENSOR properties. [CTRL+LMB] to reset only the OUT RENDER settings properties. Additionally: [ALT+LMB] to copy all the render properties of a Flame preset from the Clipboard into here (SENSOR, RENDER and CC CURVES settings)." }
                parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteKwargsSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_toggle_off(\"outsensor\"), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            groupsimple {
                name    "f_outrendersensor"
                label   "OUT sensor settings"
                disablewhentab "{ outedit == 0 }"
                grouptag { "group_type" "simple" }

                parm {
                    name    "out_sensorviz_disabled"
                    label   "ENTER sensor viz"
                    type    button
                    default { "0" }
                    help    "<br/>[<b>LMB</b>] to <b>ENTER</b> sensor viz mode.<br/><br/>All the render settings required by third-party programs such as Apophysis and Fractorium are stored together with the fractal flames when they are saved from FLAM3H™.<br/><br/>A portion of the render parameters deal with the camera and how the fractal flame you just saved is framed. The FLAM3H™ camera sensor will precisely display the image framing.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
                    hidewhen "{ outsensor == 1 }"
                    parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_TagORedSVG_disabled.svg" }
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_outsensor_toggle(), kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "out_sensorviz"
                    label   "EXIT sensor viz"
                    type    button
                    default { "0" }
                    help    "<br/>[<b>LMB</b>] to <b>EXIT</b> sensor viz mode. (<i>Camera sensor update <b>ON</b></i>).<br/><br/>All the render settings required by third-party programs such as Apophysis and Fractorium are stored together with the fractal flames when they are saved from FLAM3H™.<br/><br/>A portion of the render parameters deal with the camera and how the fractal flame you just saved is framed. The FLAM3H™ camera sensor will precisely display the image framing.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
                    hidewhen "{ outsensor == 0 } { outsensorupdate == 0 }"
                    parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_TagORedSVG.svg" }
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_outsensor_toggle(), kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "out_sensorviz_off"
                    label   "EXIT sensor viz"
                    type    button
                    default { "0" }
                    help    "<br/>[<b>LMB</b>] to <b>EXIT</b> sensor viz mode. (<i>Camera sensor update <b>OFF</b></i>).<br/><br/>All the render settings required by third-party programs such as Apophysis and Fractorium are stored together with the fractal flames when they are saved from FLAM3H™.<br/><br/>A portion of the render parameters deal with the camera and how the fractal flame you just saved is framed. The FLAM3H™ camera sensor will precisely display the image framing.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
                    hidewhen "{ outsensor == 0 } { outsensorupdate == 1 }"
                    parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_TagORedOffSVG.svg" }
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_outsensor_toggle(), kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "outres"
                    label   "resolution"
                    type    intvector2
                    joinnext
                    size    2
                    default { "1024" "1024" }
                    help    "<h3>The image resolution</h3><i>This parameter's value will be saved into the Flame file and used by a third-party application renderer. <b>Fractorium</b> being the preferred one followed by <b>Apophysis</b> and others</i>."
                    disablewhen "{ outedit == 0 }"
                    range   { 256! 4096 }
                    parmtag { "cook_dependent" "1" }
                    parmtag { "script_action_help" "The image resolution." }
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).util_set_front_viewer(False)" }
                    parmtag { "script_callback_language" "python" }
                    parmtag { "spare_category" "View" }
                }
                parm {
                    name    "outrespresets"
                    label   "OUT Res presets"
                    type    string
                    nolabel
                    joinnext
                    default { "-1" }
                    menumini {
                        [ "menu = hou.phm().flam3.out_flame_utils(kwargs).menu_sensor_resolution()" ]
                        [ "return menu" ]
                        language python
                    }
                    parmtag { "script_callback" "hou.phm().flam3.out_flame_utils(kwargs).menu_sensor_resolution_set(False), kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "outcprendervals"
                    label   "Copy ALL IN Flame preset render properties"
                    type    button
                    nolabel
                    default { "0" }
                    help    "<br/>[<b>LMB</b>] to copy ALL the currently loaded IN Flame preset render properties (<i><b>SENSOR</b>, <b>RENDER</b> and <b>CC CURVES</b> settings</i>) into here, the OUT render properties.<br/><br/><i>When you load a Flame preset from a file or from the Clipboard, this icon will become available</i>.<br/><br/><b>NOTE</b>:<br/>All the render properties of a Flame preset loaded from the Clipboard will be automatically copied into here, the OUT render properties, on load (<i><b>SENSOR</b>, <b>RENDER</b> and <b>CC CURVES</b> settings</i>).<br/><br/><b>TIP</b>:<br/>You can load only the render properties of a Flame preset stored in the Clipboard into here using [<b>ALT+LMB</b>] from the above \"<b>edit render properties</b>\" toggle parameter Action Button star icon. "
                    disablewhen "{ inisvalidpreset == 0 }"
                    parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_StarSwapRedCopyPasteInfosSVG.svg" }
                    parmtag { "script_callback" "hou.phm().flam3.in_flame_utils.in_copy_render_all_stats_msg(kwargs, None, False, True), kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "outcenter"
                    label   "center"
                    type    vector2
                    size    2
                    default { "0" "0" }
                    help    "<h3>The center of the frame<br/>Offsets the camera in fractal space (<i>panning</i>)</h3><i>This parameter's value will be saved into the Flame file and used by a third-party application renderer. <b>Fractorium</b> being the preferred one followed by <b>Apophysis</b> and others</i>."
                    disablewhen "{ outedit == 0 }"
                    range   { -5 5 }
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).util_set_front_viewer(False)" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "outrotate"
                    label   "rotate"
                    type    float
                    default { "0" }
                    help    "<h3>The camera rotation</h3><i>This parameter's value will be saved into the Flame file and used by a third-party application renderer. <b>Fractorium</b> being the preferred one followed by <b>Apophysis</b> and others</i>."
                    disablewhen "{ outedit == 0 }"
                    range   { -360 360 }
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).util_set_front_viewer(False)" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "outscale"
                    label   "scale"
                    type    float
                    default { "400" }
                    help    "<h3>Size of the lens</h3><i>This parameter's value will be saved into the Flame file and used by a third-party application renderer. <b>Fractorium</b> being the preferred one followed by <b>Apophysis</b> and others</i>.<br/><br/><b>NOTE</b>:<br/>Because the quality won't be raised once loaded into third-party programs such as <b>Fractorium</b> or <b>Apophysis</b>, you will need to manually alter it from within the host program, making this XML key an affordable way to achieve zoom."
                    disablewhen "{ outedit == 0 }"
                    range   { 16! 2048 }
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).util_set_front_viewer(False)" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "outsensorupdate"
                    label   "update sensor"
                    type    toggle
                    default { "1" }
                    help    "Every change to the camera sensor parameters will update the sensor viewport viz.<br/><br/>Turn this <b>OFF</b> to disable any sensor viewport's updates."
                    disablewhen "{ outsensor == 0 }"
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).util_set_front_viewer(False), kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
            }

            groupsimple {
                name    "f_outrendersettings"
                label   "OUT renderer settings"
                disablewhentab "{ outedit == 0 }"
                grouptag { "group_type" "simple" }

                parm {
                    name    "outquality"
                    label   "quality"
                    type    integer
                    default { "1000" }
                    help    "<h3>The render quality is the same as \"density\" in FLAM3H™</h3><i>This parameter's value will be saved into the Flame file and used by a third-party application renderer. <b>Fractorium</b> being the preferred one followed by <b>Apophysis</b> and others</i>."
                    disablewhen "{ outedit == 0 }"
                    range   { 64! 2048 }
                    parmtag { "script_action_help" "The render quality. Think of this as how many points are used inside Fractorium to render the final image. The more the more cleaner the final image." }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "outbrightness"
                    label   "brightness"
                    type    float
                    default { "3" }
                    help    "<h3>Shifts the overall lightness or darkness of the image</h3><i>This parameter's value will be saved into the Flame file and used by a third-party application renderer. <b>Fractorium</b> being the preferred one followed by <b>Apophysis</b> and others</i>."
                    disablewhen "{ outedit == 0 }"
                    range   { 1! 16 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "outgamma"
                    label   "gamma"
                    type    float
                    default { "2.5" }
                    help    "<h3>Adjusts midtones without heavily changing black or white</h3><i>This parameter's value will be saved into the Flame file and used by a third-party application renderer. <b>Fractorium</b> being the preferred one followed by <b>Apophysis</b> and others</i>."
                    disablewhen "{ outedit == 0 }"
                    range   { 1! 10 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "outhighlight"
                    label   "highlight power"
                    type    float
                    default { "5" }
                    help    "<h3>Controls how intense the brightest areas appear</h3><i>This parameter's value will be saved into the Flame file and used by a third-party application renderer. <b>Fractorium</b> being the preferred one followed by <b>Apophysis</b> and others</i>."
                    disablewhen "{ outedit == 0 }"
                    range   { 0! 5 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "outk2"
                    label   "logscale K2"
                    type    float
                    default { "0" }
                    help    "<h3>Uses a logarithmic curve to compress or expand midrange values</h3><i>This parameter's value will be saved into the Flame file and used by a third-party application renderer. <b>Fractorium</b> being the preferred one followed by <b>Apophysis</b> and others</i>."
                    disablewhen "{ outedit == 0 }"
                    range   { 0! 1 }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "outvibrancy"
                    label   "vibrancy"
                    type    float
                    default { "0.3333" }
                    help    "<h3>Boosts muted colors while keeping vivid tones natural</h3><i>This parameter's value will be saved into the Flame file and used by a third-party application renderer. <b>Fractorium</b> being the preferred one followed by <b>Apophysis</b> and others</i>."
                    disablewhen "{ outedit == 0 }"
                    range   { 0! 1 }
                    parmtag { "script_callback_language" "python" }
                }
            }

            groupcollapsible {
                name    "f_outrendercurves"
                label   "OUT renderer color correction curves"
                disablewhentab "{ outedit == 0 }"
                parmtag { "group_default" "0" }
                grouptag { "group_type" "collapsible" }
                parmtag { "sidefx::header_toggle" "outccdefault" }

                parm {
                    name    "outccdefault"
                    label   "Default toggle"
                    type    toggle
                    nolabel
                    default { "0" }
                    help    "<h3>This toggle indicate when a color correction is active</h3>It will be <b>OFF</b> when the color correction curves values are at their defaults."
                    disablewhen "{ outdisable == 1 }"
                    parmtag { "script_callback" "hou.phm().flam3.out_flame_utils.out_render_curves_compare_and_set_toggle(kwargs['node']), kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "icon_f3h_cc_defaults_copy"
                    label   "CC CURVES: Defaults"
                    type    button
                    nolabel
                    joinnext
                    default { "0" }
                    help    "<h2>CC Curves at their defaults</h2>[<b>LMB</b>] to copy all the color correction curves data from the currently loaded IN Flame preset.<br/><br/><i>If the loaded IN Flame preset have its color correction curves data at default values, the copy will be skipped</i>.<br/><br/><u><b>These color correction curves data can not be edited</b></u>.<br/><br/><b>TIP</b>:<br/><i>The data is stored here from the loaded Flame preset, and it will be saved into the file when you save the Flame preset out from FLAM3H™ so to keep and preserve the original color correction data intact</i>."
                    hidewhen "{ outccdefault == 1 }"
                    parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteSVG.svg" }
                    parmtag { "script_callback" "hou.phm().flam3.in_flame_utils.in_copy_cc_curves_stats_msg(kwargs), kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "icon_f3h_cc_modified_reset"
                    label   "CC CURVES: Modified"
                    type    button
                    nolabel
                    joinnext
                    default { "0" }
                    help    "<h2>CC Curves modified</h2>[<b>LMB</b>] to reset all the color correction curves to their defaults (<i>no color correction</i>).<br/><br/><u><b>These color correction curves data can not be edited</b></u><br/><br/><b>TIP</b>:<br/><i>The data is stored here from the loaded Flame preset, and it will be saved into the file when you save the Flame preset out from FLAM3H™ so to keep and preserve the original color correction data intact</i>."
                    hidewhen "{ outccdefault == 0 }"
                    parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarRedSVG.svg" }
                    parmtag { "script_callback" "hou.phm().flam3.out_flame_utils.out_render_curves_set_and_retrieve_defaults(kwargs['node']), kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "label_outccdefault"
                    label   "Heading"
                    type    label
                    default { "Defaults" }
                    parmtag { "sidefx::look" "heading" }
                }
                parm {
                    name    "empty_out_02"
                    label   "empty"
                    type    geometrydata
                    invisible
                    nolabel
                    default { "0" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "icon_f3h_cc_curves"
                    label   "Curves All"
                    type    button
                    invisible
                    nolabel
                    joinnext
                    default { "0" }
                    help    "Color correction: CURVES (All)\\n\\nThis is data coming from Fractorium's color correction curves when the loaded Flame preset uses it.\\nIf not used or found, default values (no color correction) will be used instead.\\n\\nThis parameter data will be saved into the Flame file and used by a third-party application renderer.\\nFractorium being the preferred one followed by Apophysis and others."
                    disablewhen "{ outdisable == 1 }"
                    parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarBlueSVG.svg" }
                    parmtag { "script_callback" "" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "outcurvesval"
                    label   "curves"
                    type    string
                    invisible
                    nolabel
                    default { "0 0 1 0.25 0.25 1 0.5 0.5 1 0.75 0.75 1 0 0 1 0.25 0.25 1 0.5 0.5 1 0.75 0.75 1 0 0 1 0.25 0.25 1 0.5 0.5 1 0.75 0.75 1 0 0 1 0.25 0.25 1 0.5 0.5 1 0.75 0.75 1" }
                    parmtag { "script_callback" "hou.phm().flam3.out_flame_utils.out_render_curves_retrive_data(kwargs['node'])" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "empty_out_03"
                    label   "empty"
                    type    geometrydata
                    nolabel
                    default { "0" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "icon_f3h_cc_overall"
                    label   "Curve Overall"
                    type    button
                    nolabel
                    joinnext
                    default { "0" }
                    help    "<h2>CC: OVERALL (<i>Luminance</i>)</h2>This is data coming from <b>Fractorium's</b> color correction curves when the loaded Flame preset uses it.<br/><br/>If not used or found, default values (<i>no color correction</i>) will be used instead.<br/><br/><i>This parameter's value will be saved into the Flame file and used by a third-party application renderer. <b>Fractorium</b> being the preferred one followed by <b>Apophysis</b> and others</i>."
                    disablewhen "{ outdisable == 1 }"
                    parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarBlueSVG.svg" }
                    parmtag { "script_callback" "" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "outcurveoverallval"
                    label   "overall"
                    type    string
                    nolabel
                    default { "0 0 0.25 0.25 0.5 0.5 0.75 0.75 1 1" }
                    parmtag { "script_callback" "hou.phm().flam3.out_flame_utils.out_render_curves_retrive_data(kwargs['node'])" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "empty_out_04"
                    label   "empty"
                    type    geometrydata
                    nolabel
                    default { "0" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "icon_f3h_cc_red"
                    label   "Curve Red"
                    type    button
                    nolabel
                    joinnext
                    default { "0" }
                    help    "<h2>CC: RED</h2>This is data coming from <b>Fractorium's</b> color correction curves when the loaded Flame preset uses it.<br/><br/>If not used or found, default values (<i>no color correction</i>) will be used instead.<br/><br/><i>This parameter's value will be saved into the Flame file and used by a third-party application renderer. <b>Fractorium</b> being the preferred one followed by <b>Apophysis</b> and others</i>."
                    disablewhen "{ outdisable == 1 }"
                    parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarBlueSVG.svg" }
                    parmtag { "script_callback" "" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "outcurveredval"
                    label   "red"
                    type    string
                    nolabel
                    default { "0 0 0.25 0.25 0.5 0.5 0.75 0.75 1 1" }
                    parmtag { "script_callback" "hou.phm().flam3.out_flame_utils.out_render_curves_retrive_data(kwargs['node'])" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "icon_f3h_cc_green"
                    label   "Curve Green"
                    type    button
                    nolabel
                    joinnext
                    default { "0" }
                    help    "<h2>CC: GREEN</h2>This is data coming from <b>Fractorium's</b> color correction curves when the loaded Flame preset uses it.<br/><br/>If not used or found, default values (<i>no color correction</i>) will be used instead.<br/><br/><i>This parameter's value will be saved into the Flame file and used by a third-party application renderer. <b>Fractorium</b> being the preferred one followed by <b>Apophysis</b> and others</i>."
                    disablewhen "{ outdisable == 1 }"
                    parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarBlueSVG.svg" }
                    parmtag { "script_callback" "" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "outcurvegreenval"
                    label   "green"
                    type    string
                    nolabel
                    default { "0 0 0.25 0.25 0.5 0.5 0.75 0.75 1 1" }
                    parmtag { "script_callback" "hou.phm().flam3.out_flame_utils.out_render_curves_retrive_data(kwargs['node'])" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "icon_f3h_cc_blue"
                    label   "Curve Blue"
                    type    button
                    nolabel
                    joinnext
                    default { "0" }
                    help    "<h2>CC: BLUE</h2>This is data coming from <b>Fractorium's</b> color correction curves when the loaded Flame preset uses it.<br/><br/>If not used or found, default values (<i>no color correction</i>) will be used instead.<br/><br/><i>This parameter's value will be saved into the Flame file and used by a third-party application renderer. <b>Fractorium</b> being the preferred one followed by <b>Apophysis</b> and others</i>."
                    disablewhen "{ outdisable == 1 }"
                    parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarBlueSVG.svg" }
                    parmtag { "script_callback" "" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "outcurveblueval"
                    label   "blue"
                    type    string
                    nolabel
                    default { "0 0 0.25 0.25 0.5 0.5 0.75 0.75 1 1" }
                    parmtag { "script_callback" "hou.phm().flam3.out_flame_utils.out_render_curves_retrive_data(kwargs['node'])" }
                    parmtag { "script_callback_language" "python" }
                }
            }

        }

    }

    group {
        name    "f_flam3h_6"
        label   "prefs"
        hidewhentab "{ flamefunc == 0 } { h_valid == 0 }"

        groupcollapsible {
            name    "f_prefs"
            label   "FLAM3H™"
            parmtag { "group_default" "1" }
            grouptag { "group_type" "collapsible" }

            parm {
                name    "prefsdisable"
                label   "disable"
                type    toggle
                invisible
                default { "1" }
                parmtag { "script_callback_language" "python" }
            }
            groupsimple {
                name    "f_prefsgpu"
                label   "prefs GPU"
                grouptag { "group_type" "simple" }

                parm {
                    name    "gpu"
                    label   "GPU"
                    type    toggle
                    default { "1" }
                    help    "<h3>Run the algorithm entirely on the GPU device</h3>This can be hundreds of times faster compared to the <b>CPU</b>(<i>CVEX</i>) implementation depending on the system' GPU device being used.<br/><br/><b>NOTE</b>:<br/>when switching this toggle <b>OFF</b> for the very first time,<br/>Houdini will compile all the FLAM3H™ <b>CPU</b>(<i>CVEX</i>) nodes.<br/>Depending on your PC configuration it can take up to <b>1</b>(<i>one</i>) minute.<br/>It is a one time compile process.<br/><br/><b>TIPS</b>:<br/>When in GPU mode, having the SYS Tab <b>RIP</b>(<i><b>R</b>emove <b>I</b>nvalid <b>P</b>oints</i>) toggle <b>ON</b> will slow down as it will be taxing to cleanup the incoming point cloud from the GPU nodes.<br/>Keep the <b>RIP</b>(<i><b>R</b>emove <b>I</b>nvalid <b>P</b>oints</i>) toggle <b>OFF</b> while editing your fractal Flames in GPU mode to go full speed and Activate it only if/when needed:<br/>(<i>e.g. before any rendering or to check the final result from time to time if any iterators' opacity is <b>0</b>(Zero) or <b>NaN</b> values are present</i>)."
                    parmtag { "script_callback" "hou.phm().flam3.out_flame_utils(kwargs).out_auto_change_iter_num_to_prm(), kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "gpu_iter"
                    label   "iterations"
                    type    ordinal
                    default { "1024" }
                    help    "<h3>When GPU is <b>ON</b>/<b>Active</b>,<br/>run the algorithm with this number of iterations</h3>The default value is: <b>1024</b> (<i>hence the bookmark icon</i>),<br/>and it should be good for almost all cases;<br/>however you can change this value to be lower and/or higher if you desire."
                    disablewhen "{ gpu == 0 }"
                    menu usetokenvalue {
                        "128"   "128                          "
                        "256"   "256"
                        "512"   "512"
                        "1024"  "![opdef:/alexnardini::Sop/FLAM3H?icon_optionOCLSVG.svg]1024"
                        "2048"  "2048"
                        "4096"  "4096"
                    }
                    parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_general_utils(kwargs).reset_parm((1024,))" }
                    parmtag { "script_action_help" "[LMB] to reset the GPU iterations to the default: 1024" }
                    parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionOCLSVG.svg" }
                    parmtag { "script_callback" "kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
            }

            groupcollapsible {
                name    "f_prefsgpu_compiler"
                label   "prefs GPU compiler"
                invisibletab
                grouptag { "group_type" "collapsible" }

                parm {
                    name    "use_cl_fast"
                    label   "cl fast relaxed math"
                    type    toggle
                    default { "1" }
                    help    "Enable <b>-cl-fast-relaxed-math</b> compiler flag.<br/><br/>Let the compiler optimize aggressively."
                    disablewhen "{ gpu == 0 }"
                    parmtag { "script_callback" "kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "sepparm4"
                    label   "Spacer"
                    type    separator
                    default { "" }
                    parmtag { "sidefx::layout_height" "small" }
                    parmtag { "sidefx::look" "blank" }
                }
                parm {
                    name    "use_fma"
                    label   "fma"
                    type    toggle
                    default { "1" }
                    help    "Enable fused multiply-add if desired."
                    disablewhen "{ gpu == 0 }"
                    parmtag { "script_callback" "kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "use_native"
                    label   "native math"
                    type    toggle
                    default { "1" }
                    help    "Enable faster native OpenCL math functions (<i><b>native_*</b></i>).<br/><br/>These may reduce precision and produce device-dependent results."
                    disablewhen "{ gpu == 0 }"
                    parmtag { "script_callback" "kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "use_rng_x128"
                    label   "rng xoroshiro128+"
                    type    toggle
                    default { "1" }
                    help    "Enable <b>RNG</b> (<i><b>R</b>andom <b>N</b>umber <b>G</b>enerator</i>) <b>Xoroshiro128+</b>.<br/><br/>Produces different random sequences with better randomness and longer period.<br/><br/>When <b>OFF</b> it will use the older <b>MWC64X</b>."
                    disablewhen "{ gpu == 0 }"
                    parmtag { "export_disable" "1" }
                    parmtag { "script_callback" "kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
            }

            groupsimple {
                name    "f_prefsgeneral"
                label   "prefs general"
                grouptag { "group_type" "simple" }

                parm {
                    name    "reframeval"
                    label   "viewport frame size"
                    type    float
                    invisible
                    default { "1" }
                    help    "The bounding box size that will be viewport framed when the SYS Tab frameview icon is clicked.\\n\\nA value of 1 should work well in every situation, but you can increase it if you'd like.\\n\\nConsider this as the size of a box at the ZERO world that, upon clicking the SYS Tab frame viewport icon, will be center framed in the viewport.\\nOnce this value is changed, Click the SYS Tab Frame viewport to see the new framing."
                    range   { 1! 2 }
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).util_viewport_bbox_frame()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "paletteplus"
                    label   "palette 256+"
                    type    toggle
                    default { "1" }
                    help    "<h3>It will allow the OUT Flame to be saved with more than 256 color keys assuming you created a Palette with this many colors otherwise it will always save the Flame using the standard 256 color keys</h3>If the Palette color keys are less than 256, it will always sample the Palette at 256 when saving out the Flame preset.<br/><br/>The maximun Palette color keys you can use are 1024, if you create a Palette with more, it will be sampled at 1024 colors.<br/><br/><b>NOTE</b>:<br/>If you are planning to load the saved Flame inside Apophysis, remember that it will fail if the Flame preset you are trying to load posses a Palette with more than 256 color keys."
                    parmtag { "script_callback" "hou.phm().flam3.out_flame_utils(kwargs).out_palette_256_plus_check(), kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "solo_follow"
                    label   "SOLO follow"
                    type    toggle
                    default { "1" }
                    help    "<h3>When any iterator has its xform handle in SOLO mode already, it causes the iterator that is selected or picked from the SYS tab's select iterator mini-menu to be automatically configured to be in SOLO mode</h3>This enables you to swiftly go over each one automatically.<br/><br/>To prevent the selected iterator from being in SOLO mode while being selected, turn this <b>OFF</b>."
                    parmtag { "script_callback" "kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "flashmsg"
                    label   "flash messages"
                    type    toggle
                    default { "1" }
                    help    "<h3>Causes a message to appear briefly in the upper left corner of the network editor, then fade away</h3>Copy/Paste <b>iterators</b> and <b>FF</b> data uses flash messages, as well as some other features."
                    parmtag { "script_callback" "kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "iterclr"
                    label   "iterative color attribute"
                    type    toggle
                    default { "0" }
                    help    "<h3>Output the iterative color float point attribute <b>@clr</b> used internally by FLAM3H™ to map the palette colors to the points</h3>The attribute values are computed inside the chaos game<br/>and can be usefull to post process the output point cloud in many ways.<br/><br/>It is dependent of each iterator shader location and speed parameters values along with the number of iterations being used. "
                    parmtag { "script_callback" "kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
            }

            groupsimple {
                name    "f_prefsui"
                label   "prefs UI"
                grouptag { "group_type" "simple" }

                parm {
                    name    "enumeratemenu"
                    label   "enumerate presets menus"
                    type    toggle
                    default { "1" }
                    help    "<h3>Causes the presets menus inside the <b>CP</b>, <b>IN</b> and <b>OUT</b> tab to be enumerated</h3>This make it easy to remember a particular preset you liked while trying out others inside the loaded library file.<br/><br/>Turn this <b>OFF</b> to only display the raw preset names.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).menus_refresh_enum_prefs(), kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "itericons"
                    label   "iterator menus bookmark icons"
                    type    toggle
                    invisible
                    default { "0" }
                    help    "OFF by default.\\nCauses the variation menus inside each iterator to have a bookmark icon (FLAME and FF tab).\\n\\nThis is a dynamic mode that will change each variation's menu based of the value of their weight hence it will take a hit on the UI performance.\\n\\nWhen you turn this toggle back OFF,\\nHoudini will revert the density value to its default (500k points) as a way to reduce the waiting time since a re-compute of the fractal Flame is triggered."
                    disablewhen "{ prefsdisable == 1 }"
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_iterator_utils(kwargs).refresh_iterator_vars_menu(), kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
            }

            groupcollapsible {
                name    "f_prefscvex"
                label   "prefs cvex precision"
                invisibletab
                grouptag { "group_type" "collapsible" }

                parm {
                    name    "vex_precision"
                    label   "modes"
                    type    string
                    default { "32" }
                    help    "Switch between the default Single Precision (<i><b>32-bit</b></i>) or Double Precision (<i><b>64-bit</b></i>).<br/><br/><b>64-bit</b> double precision will be really, really slow. I repeat: really, really slow.<br/><br/>Always use the default <b>32-bit</b> unless you notice some major artifacts and you truly love the fractal flame you are working on.<br/><br/>When switching to Double Precision (<i><b>64-bit</b></i>) for the first time, it will Re-Compile all FLAM3H CVEX nodes. Depending on your PC configuration it can take up to <b>1</b> minute.<br/><br/>It is a one time compile process."
                    menu {
                        "32"    "![opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteSVG.svg]32-bit (SP)       "
                        "64"    "64-bit (DP)"
                    }
                    parmtag { "autoscope" "0000000000000000" }
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_scripts(kwargs).flam3h_check_first_node_instance_prefs_cvex_precision_msg(), kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
            }

            groupsimple {
                name    "f_prefsxaos"
                label   "prefs xaos:"
                grouptag { "group_type" "simple" }

                parm {
                    name    "xm"
                    label   "mode"
                    type    ordinal
                    default { "0" }
                    help    "<h3>Set the XAOS mode to use</h3>Once changed, FLAM3H™ will reset all iterators' xaos weights to reflect the new mode.<br/><br/>When saving out Flame files, <b>xaos FROM</b> mode will internally be converted into xaos TO on save and reloaded as <b>xaos TO</b>.<h2>xaos TO (<i>default</i>)</h2>Specifies how likely an iterator/xform is to be chosen based on the previous iterator/xform that was chosen.<h2>xaos FROM</h2>Specifies the probability modifier of the next chosen iterator/xform based on the currently chosen one."
                    menu usetokenvalue {
                        "0" "![opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteSVG.svg]xaos TO       "
                        "1" "xaos FROM"
                    }
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_iterator_utils(kwargs).flam3h_xaos_convert(), kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
            }

            groupsimple {
                name    "f_prefsdensity"
                label   "prefs density"
                grouptag { "group_type" "simple" }

                parm {
                    name    "ptcount"
                    label   "density"
                    type    integer
                    default { "500000" }
                    help    "<h3>Set a custom density value for the fractal Flame</h3>If the global tab's density menu entries do not have whant you need, you can set a custom density value using this parameter.<br/><br/><b>NOTE</b>:<br/>This is the only place where you are allowed to animate the density value."
                    hidewhen "{ flamefunc == 0 }"
                    range   { 1! 1e+06 }
                    parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_iterator_utils(kwargs).menu_global_density_set_default()" }
                    parmtag { "script_action_help" "[LMB] to reset density to its default: 500k(thousands) points. This is what should be used while editing fractal Flames most of the time. Additionally: [SHIFT+LMB] set density to: 300k(thousands). [CTRL+LMB] set density to: 200k(thousands). [ALT+LMB] set density to: 100k(thousands)" }
                    parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteToolSVG.svg" }
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_iterator_utils.flam3h_on_loaded_set_density_menu(kwargs['node'])" }
                    parmtag { "script_callback_language" "python" }
                }
            }

            groupcollapsible {
                name    "f_prefscamera"
                label   "prefs camera"
                grouptag { "group_type" "collapsible" }

                parm {
                    name    "camhandle"
                    label   "handle"
                    type    toggle
                    default { "0" }
                    help    "<h3>Display the viewport camera handle to help frame/center your fractal flame</h3>Turn this <b>OFF</b> when rendering.<br/><br/><b>NOTE</b>:<br/>The handles are properly scaled and visible only when looking through a perspective type of camera, not when looking through an orthogonal type of camera."
                    parmtag { "script_callback" "kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "camcull"
                    label   "camera cull"
                    type    toggle
                    default { "0" }
                    help    "<h3>Enable culling based on camera view</h3>"
                    parmtag { "script_callback" "kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "fcam"
                    label   "cam"
                    type    oppath
                    default { "" }
                    help    "<h3>Camera to use for either the handles or the culling</h3>"
                    disablewhen "{ camcull == 0 camhandle == 0 }"
                    parmtag { "opfilter" "!!OBJ/CAMERA!!" }
                    parmtag { "oprelative" "." }
                    parmtag { "script_callback" "kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "cullamount"
                    label   "amount"
                    type    float
                    default { "0.99" }
                    help    "<h3>Camera cull amount</h3>"
                    disablewhen "{ camcull == 0 }"
                    range   { 0 1 }
                    parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_general_utils(kwargs).reset_parm((0.99,))" }
                    parmtag { "script_action_help" "[LMB] to reset the camera cull amount to: 0.99" }
                    parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteSVG.svg" }
                    parmtag { "script_callback_language" "python" }
                }
            }

            groupsimple {
                name    "f_prefsviewport"
                label   "prefs viewport"
                grouptag { "group_type" "simple" }

                parm {
                    name    "setdark"
                    label   "dark"
                    type    toggle
                    default { "0" }
                    help    "<h3>Set dark viewport color scheme</h3>"
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).colorSchemeDark(), kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "sepparm2"
                    label   "Spacer"
                    type    separator
                    default { "" }
                    parmtag { "sidefx::layout_height" "medium" }
                    parmtag { "sidefx::look" "blank" }
                }
                parm {
                    name    "vptype"
                    label   "display"
                    type    ordinal
                    default { "0" }
                    help    "<h3>Types of Viewport Point Display types</h3>"
                    menu {
                        "0" "![opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteSVG.svg]Points          "
                        "1" "Pixels"
                    }
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).viewportParticleDisplay(), kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "vpptsize"
                    label   "size"
                    type    float
                    default { "1" }
                    help    "<h3>If display type is set to Points, this will set the size of those points in the viewport</h3>"
                    disablewhen "{ vptype == 1 }"
                    range   { 0.1! 2 }
                    parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_general_utils(kwargs).viewportParticleSize(1.0)" }
                    parmtag { "script_action_help" "[LMB] to reset this parameter to a value of: 1.0" }
                    parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteSVG.svg" }
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).viewportParticleSize(), kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "sepparm3"
                    label   "Spacer"
                    type    separator
                    default { "" }
                    parmtag { "sidefx::layout_height" "medium" }
                    parmtag { "sidefx::look" "blank" }
                }
                parm {
                    name    "vpww"
                    label   "wire width"
                    type    float
                    default { "3" }
                    help    "<h3>When the SYS tab \"xforms handles VIZ\" is <b>ON</b>, this parameter will set the wire curves thickness for the viewport display</h3>A value of <b>3.0</b> is generally good."
                    disablewhen "{ vizhandles == 0 } { outsensor == 1 } { ptcount > 5000000 }"
                    range   { 0.1! 5! }
                    parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_general_utils(kwargs).viewportWireWidth(3.0)" }
                    parmtag { "script_action_help" "[LMB] to reset this parameter to a value of: 3.0" }
                    parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteSVG.svg" }
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).viewportWireWidth(), kwargs['parm'].deleteAllKeyframes()" }
                    parmtag { "script_callback_language" "python" }
                }
            }

            groupcollapsible {
                name    "f_prefsf3hdata"
                label   "prefs FLAM3H™ DATA PRIVATE"
                invisibletab
                grouptag { "group_type" "collapsible" }

                parm {
                    name    "icon_custom_7"
                    label   "custom"
                    type    button
                    nolabel
                    joinnext
                    default { "0" }
                    help    "This custom data is used for the well being of some functionalities.<br/><br/><u><b>Never touch this data unless you are developing additional features that require changes or debug informations from those options</b></u>."
                    disablewhen "{ aboutdisable == 1 }"
                    parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarBlueSVG.svg" }
                    parmtag { "script_callback" "" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "private_label"
                    label   "private heading"
                    type    label
                    default { "Never touch this data for the well being of FLAM3H™" }
                    parmtag { "sidefx::look" "heading" }
                }
                groupsimple {
                    name    "f_prefssys"
                    label   "FLAM3H™ system"
                    disablewhentab "{ aboutdisable == 1 }"
                    grouptag { "group_type" "simple" }

                    parm {
                        name    "h_valid"
                        label   "H VALID"
                        type    toggle
                        default { "1" }
                        help    "Is this FLAM3H™ version valid for this Houdini version ?"
                        disablewhen "{ flamefunc == 0 }"
                        parmtag { "script_callback" "" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "empty_prefs_01"
                        label   "empty"
                        type    geometrydata
                        nolabel
                        default { "0" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "doff"
                        label   "FF"
                        type    toggle
                        default { "0" }
                        help    "FF"
                        disablewhen "{ flamefunc == 0 }"
                        parmtag { "script_callback" "" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "rip"
                        label   "RIP"
                        type    toggle
                        default { "0" }
                        help    "RIP"
                        disablewhen "{ flamefunc == 0 } { outsensor == 1 }"
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "f3c"
                        label   "F3C (flam3 compatibility)"
                        type    toggle
                        default { "1" }
                        help    "F3C"
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "tag"
                        label   "TAG"
                        type    toggle
                        default { "0" }
                        help    "TAG"
                        disablewhen "{ flamefunc == 0 }"
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "outsensor"
                        label   "SENSOR"
                        type    toggle
                        default { "0" }
                        help    "SENSOR"
                        disablewhen "{ flamefunc == 0 }"
                        parmtag { "script_callback_language" "python" }
                    }
                }

                groupcollapsible {
                    name    "f_prefscustom"
                    label   "FLAM3H™ custom"
                    disablewhentab "{ aboutdisable == 1 }"
                    grouptag { "group_type" "collapsible" }

                    parm {
                        name    "flam3custom_msg"
                        label   "flam3custom_msg"
                        type    label
                        default { "The following parameters\nare part of FLAM3H™ custom memory data.\n\nThey are used to keep track, restore and compare data\nfor the well being of some algorithm core functionalities." }
                        parmtag { "sidefx::look" "block" }
                    }
                    parm {
                        name    "vptype_mem"
                        label   "display MEM"
                        type    integer
                        default { "0" }
                        help    "What point viewport display type is being used."
                        range   { 0 10 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "vpptsize_mem"
                        label   "size MEM"
                        type    float
                        default { "1" }
                        help    "If display type is set to Points, this will set the size of those points in the viewport."
                        range   { 0.1! 2 }
                        parmtag { "script_action_help" "Reset this parameter to a value of: 1.0" }
                        parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteSVG.svg" }
                        parmtag { "script_callback" "" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "vpww_mem"
                        label   "wire width MEM"
                        type    float
                        default { "3" }
                        help    "When the SYS -> \"xforms handles VIZ\" is <b>ON</b>, this parameter will set the wire curves thickness for the viewport display."
                        range   { 0.1! 5! }
                        parmtag { "script_action_help" "Reset this parameter to a value of: 3.0" }
                        parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteSVG.svg" }
                        parmtag { "script_callback" "" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "icon_custom_6"
                        label   "custom"
                        type    button
                        nolabel
                        joinnext
                        default { "0" }
                        help    "Spacing the Xaos weight will turn this toggle <b>ON</b> and <b>OFF</b>"
                        disablewhen "{ aboutdisable == 1 }"
                        parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarBlueSVG.svg" }
                        parmtag { "script_callback" "" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "empty_prefs_02"
                        label   "empty"
                        type    geometrydata
                        invisible
                        nolabel
                        default { "0" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "xaosdiv"
                        label   "auto space xaos weights"
                        type    toggle
                        default { "1" }
                        help    "Will space the xaos weights for easy read and count ( <b>ON</b>/<b>OFF</b> )."
                        disablewhen "{ autoxaos == 0 }"
                        parmtag { "script_callback" "" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "autopath"
                        label   "auto correct output paths"
                        type    toggle
                        invisible
                        default { "1" }
                        help    "This is a simple autocorrection of the output filenames for the CP and OUT tabs.\\n\\nAs of now this toggle it is set to always be ON/Active and it should probably be removed from FLAM3H™ at some point.\\nIt is kept around until I d'nt find the time to make the necessary correction inside the python module.\\n\\nThis toggle will need to be removed at some point."
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "icon_custom_4"
                        label   "custom"
                        type    button
                        nolabel
                        joinnext
                        default { "0" }
                        help    "This data is to keep track of the xform handles VIZ modes"
                        disablewhen "{ aboutdisable == 1 }"
                        parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarBlueSVG.svg" }
                        parmtag { "script_callback" "" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "empty_prefs_03"
                        label   "empty"
                        type    geometrydata
                        invisible
                        nolabel
                        default { "0" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "vizhandles"
                        label   "viewport xforms VIZ"
                        type    toggle
                        default { "0" }
                        help    "When switched <b>ON</b> it will display the xforms handles in the viewport."
                        parmtag { "script_callback" "" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "vizhandles_solo"
                        label   "viewport xforms VIZ (solo)"
                        type    toggle
                        default { "0" }
                        help    "When switched <b>ON</b> it will display the xforms handles in the viewport in SOLO mode."
                        disablewhen "{ vizhandles == 0 }"
                        parmtag { "script_callback" "" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "vizhandles_solo_mpidx"
                        label   "xfviz MPIDX"
                        type    integer
                        default { "0" }
                        help    "The multi parameter index of the iterator being in xform handle SOLO mode. When no iterator is in SOLO mode this value will be <b>0</b>(<i>Zero</i>)"
                        disablewhen "{ vizhandles == 0 } { vizhandles_solo == 0 }"
                        range   { 0! 9 }
                        parmtag { "autoscope" "0000000000000000" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "vizhandlesff_solo"
                        label   "viewport xforms VIZ FF (solo)"
                        type    toggle
                        default { "0" }
                        help    "When switched <b>ON</b> it will display the xforms handles for the <b>FF</b> in the viewport."
                        disablewhen "{ flamefunc == 0 }"
                        parmtag { "script_callback" "" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "icon_custom_2"
                        label   "custom"
                        type    button
                        nolabel
                        joinnext
                        default { "0" }
                        help    "This data is for the copy/paste undos and xaos undos."
                        disablewhen "{ aboutdisable == 1 }"
                        parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarBlueSVG.svg" }
                        parmtag { "script_callback" "" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "empty_prefs_04"
                        label   "empty"
                        type    geometrydata
                        nolabel
                        default { "0" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "flam3h_data_mpidx"
                        label   "copy/paste MPIDX"
                        type    integer
                        default { "0" }
                        help    "When this value is <b>0</b>(<i>Zero</i>) mean no iterators has been marked for copying.<br/><br/>When this value is above <b>0</b>(<i>Zero</i>) it will be the multi paramter index of the marked iterator.<br/><br/>When this value is <b>-1</b> will signify that a marked iterator has been removed/deleted."
                        range   { -1! 0 }
                        parmtag { "autoscope" "0000000000000000" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "flam3h_data_mpmem"
                        label   "flam3h_data_mpmem"
                        type    label
                        default { "" }
                        parmtag { "sidefx::look" "block" }
                    }
                    parm {
                        name    "flam3h_data_xaos"
                        label   "flam3h_data_xaos"
                        type    label
                        default { "" }
                        parmtag { "sidefx::look" "block" }
                    }
                    parm {
                        name    "empty_prefs_05"
                        label   "empty"
                        type    geometrydata
                        nolabel
                        default { "0" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "icon_custom_3"
                        label   "custom"
                        type    button
                        nolabel
                        joinnext
                        default { "0" }
                        help    "Color correction curves data"
                        disablewhen "{ aboutdisable == 1 }"
                        parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarBlueSVG.svg" }
                        parmtag { "script_callback" "" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "empty_prefs_06"
                        label   "empty"
                        type    geometrydata
                        nolabel
                        default { "0" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "flam3curves_msg"
                        label   "flam3curves_msg"
                        type    label
                        default { "The following data represent\ncolor correction curves coming from Fractorium.\n\nIf a flame you are loading was not authored in Fractorium\ndefault values will be used instead." }
                        parmtag { "sidefx::look" "block" }
                    }
                    parm {
                        name    "outcurves"
                        label   "curves"
                        type    label
                        default { "" }
                        parmtag { "sidefx::look" "block" }
                    }
                    parm {
                        name    "outcurveoverall"
                        label   "overall"
                        type    label
                        default { "" }
                        parmtag { "sidefx::look" "block" }
                    }
                    parm {
                        name    "outcurvered"
                        label   "red"
                        type    label
                        default { "" }
                        parmtag { "sidefx::look" "block" }
                    }
                    parm {
                        name    "outcurvegreen"
                        label   "green"
                        type    label
                        default { "" }
                        parmtag { "sidefx::look" "block" }
                    }
                    parm {
                        name    "outcurveblue"
                        label   "blue"
                        type    label
                        default { "" }
                        parmtag { "sidefx::look" "block" }
                    }
                    parm {
                        name    "flam3custom_heading_div_4"
                        label   "flam3custom_heading"
                        type    label
                        default { "" }
                        parmtag { "sidefx::look" "heading" }
                    }
                }

                groupcollapsible {
                    name    "f_prmtemp"
                    label   "FLAM3H™ temp parms"
                    disablewhentab "{ aboutdisable == 1 }"
                    grouptag { "group_type" "collapsible" }

                    parm {
                        name    "icon_custom_8"
                        label   "custom"
                        type    button
                        nolabel
                        joinnext
                        default { "0" }
                        help    "Temp parameters"
                        disablewhen "{ aboutdisable == 1 }"
                        parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarBlueSVG.svg" }
                        parmtag { "script_callback" "" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "empty_prefs_07"
                        label   "empty"
                        type    geometrydata
                        invisible
                        nolabel
                        default { "0" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "flam3tmpprm_msg"
                        label   "flam3tmpprm_msg"
                        type    label
                        default { "The following parameters are used to temporarily\nstore data to then be copied somewhere else.\n\nThey are used by the swap PRE or POST variation's order\ninside the iterators and FF.\n\nIterator's PRE and FF's POST variations\nare both two so we have two temp integers\nfor the variation name indexes\nand two temp floats for their weights." }
                        parmtag { "sidefx::look" "block" }
                    }
                    parm {
                        name    "sepparm"
                        label   "Spacer"
                        type    separator
                        default { "" }
                        parmtag { "sidefx::layout_height" "large" }
                        parmtag { "sidefx::look" "blank" }
                    }
                    parm {
                        name    "tmp_int_0"
                        label   "int 00 TMP"
                        type    integer
                        default { "0" }
                        help    "<h2>Integer 00 temp Memory</h2>"
                        range   { 0 10 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "tmp_int_1"
                        label   "int 01 TMP"
                        type    integer
                        default { "0" }
                        help    "<h2>Integer 01 temp Memory</h2>"
                        range   { 0 10 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "tmp_float_0"
                        label   "float 00 TMP"
                        type    float
                        default { "0" }
                        help    "<h2>Float 00 temp Memory</h2>"
                        range   { 0 10 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "tmp_float_1"
                        label   "float 01 TMP"
                        type    float
                        default { "0" }
                        help    "<h2>Float 01 temp Memory</h2>"
                        range   { 0 10 }
                        parmtag { "script_callback_language" "python" }
                    }
                }

            }

        }

    }

