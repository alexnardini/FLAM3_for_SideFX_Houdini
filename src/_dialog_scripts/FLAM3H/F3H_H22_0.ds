            groupcollapsible {
                name    "f_iteraffinedo_#"
                label   "#: post affine"
                disablewhentab "{ vactive_# == 0 } { iw_# == 0 }"
                grouptag { "group_type" "collapsible" }
                parmtag { "sidefx::header_toggle" "dopost_#" }

                parm {
                    name    "dopost_#"
                    label   "post"
                    type    toggle
                    default { "0" }
                    help    "<h2>Turn post affine <b>ON</b>/<b>OFF</b></h2>The term \"<b>post-affine</b>\" would be used to emphasize the sequential application of an affine transformation within a larger pipeline of operations.<br/><br/>For example, if you first apply a perspective transformation to an image and then apply an affine transformation to correct for a slight remaining distortion or to further refine the image, you might refer to the latter as a \"<b>post-affine transformation</b>\" to distinguish its place in the sequence.<br/><br/><i>In the context of fractal Flames, the \"<b>post-affine transformation</b>\" will be the very last to be applied to the incoming point/sample</i>.<br/><br/><b>OFF</b> by default."
                    parmtag { "script_callback_language" "python" }
                }
            }

            group {
                name    "f_iteraffine_#"
                label   "#: pre affine"

                groupsimple {
                    name    "f_iterpreaffinedata_#"
                    label   "PRE AFFINE"
                    disablewhentab "{ vactive_# == 0 } { iw_# == 0 }"
                    grouptag { "group_type" "simple" }

                    parm {
                        name    "scl_#"
                        label   "Scale"
                        type    float
                        default { "1" }
                        help    "Scale <u><b>pre affine</b></u> values (<i><b>X</b> and <b>Y</b></i>) by an amount,<br/>with a value of <b>1</b>(<i>one</i>) (<i>100% -> no scale</i>) being the default.<br/><br/><b>The are two ways to use this parameter</b>:<ol><li>Input a value into the numeric field. For example if you type: <b>1.2</b> it will scale the affine up by <b>20%</b>.</li><li>[<b>LMB</b>] into the numeric field and use the [<b>Mouse Wheel</b>] to increment the scale up or down.</li></ol><b>When using the mouse wheel (<i><b>2</b></i>)</b>:<ul><li>[<b>Mouse Wheel</b>]<br/>will scale the value by an increment of: <b>+/- 0.1</b></li><li>[<b>SHIFT+Mouse Wheel</b>]<br/>will scale the value by an increment of: <b>+/- 0.01</b></li><li>[<b>CTRL+Mouse Wheel</b>]<br/>will scale the value by an increment of: <b>+/- 1</b></li></ul><br/><i>Additionally</i>:<br/><i>The parameter's slider ranges are between <b>0.975</b> and <b>1.025</b> to allow for precise and very small value changes when dragged left or right</i>.<br/><br/><u><b>This parameter can not be animated</b></u>.<br/><br/><b>NOTE</b>:<br/>Every time you either input a value, drag the slider or use the mouse wheel to increment the value, it will revert back to the default value of <b>1</b>(<i>one</i>) (<i>100% -> no scale</i>)."
                        range   { 0.975 1.025 }
                        parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_iterator_utils(kwargs).prm_paste_sel_pre_affine()" }
                        parmtag { "script_action_help" "[LMB] to copy the values from the POST Affine into here, the PRE Affine. It will copy: X, Y, O and Rot. Additionally: [SHIFT+LMB] to copy only the X and Y values. [CTRL+LMB] to copy only the O value. [ALT+LMB] to copy only the Rotation angle value." }
                        parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_StarSwapRedCopyPasteAffineSVG.svg" }
                        parmtag { "script_callback" "hou.phm().flam3.flam3h_iterator_utils(kwargs).iterator_affine_scale()" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "x_#"
                        label   "X (A, D)"
                        type    vector2
                        size    2
                        default { "1" "0" }
                        help    "<u><b>pre affine</b></u>: <b>X</b>.<i>x</i>, <b>X</b>.<i>y</i> ( [<b>A</b>], [<b>D</b>] )<br/><br/>Some of the variations uses some of the pre affine coefficients to determine their behavior rather than additional parameters.<br/><br/>These are call: <b>dependent</b> variations.<br/><br/>The <b>dependent</b> variations and the affine coefficients they employ are listed below:<ul><li><h2>Waves* -> B, C, E, F</h2></li><li><h2>Popcorn* -> C, F</h2></li><li><h2>Rings* -> C</h2></li><li><h2>Fan* -> C, F</h2></li></ul><br/><b>NOTE</b>:<br/><i>Please, read the FLAM3H™ documentation to find out more.</i>"
                        range   { -1 1 }
                        parmtag { "script_callback" "" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "y_#"
                        label   "Y (B, E)"
                        type    vector2
                        size    2
                        default { "0" "1" }
                        help    "<u><b>pre affine</b></u>: <b>Y</b>.<i>x</i>, <b>Y</b>.<i>y</i> ( [<b>B</b>], [<b>E</b>] )<br/><br/>Some of the variations uses some of the pre affine coefficients to determine their behavior rather than additional parameters.<br/><br/>These are call: <b>dependent</b> variations.<br/><br/>The <b>dependent</b> variations and the affine coefficients they employ are listed below:<ul><li><h2>Waves* -> B, C, E, F</h2></li><li><h2>Popcorn* -> C, F</h2></li><li><h2>Rings* -> C</h2></li><li><h2>Fan* -> C, F</h2></li></ul><br/><b>NOTE</b>:<br/><i>Please, read the FLAM3H™ documentation to find out more.</i>"
                        range   { -1 1 }
                        parmtag { "script_callback" "" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "o_#"
                        label   "O (C, F)"
                        type    vector2
                        size    2
                        default { "0" "0" }
                        help    "<u><b>pre affine</b></u> (<b>O</b><i>ffset</i>): <b>O</b>.<i>x</i>, <b>O</b>.<i>y</i> ( [<b>C</b>], [<b>F</b>] )<br/><br/>Some of the variations uses some of the pre affine coefficients to determine their behavior rather than additional parameters.<br/><br/>These are call: <b>dependent</b> variations.<br/><br/>The <b>dependent</b> variations and the affine coefficients they employ are listed below:<ul><li><h2>Waves* -> B, C, E, F</h2></li><li><h2>Popcorn* -> C, F</h2></li><li><h2>Rings* -> C</h2></li><li><h2>Fan* -> C, F</h2></li></ul><br/><b>NOTE</b>:<br/><i>Please, read the FLAM3H™ documentation to find out more.</i>"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "ang_#"
                        label   "Rot"
                        type    float
                        default { "0" }
                        help    "Rotate <u><b>pre affine</b></u> in angle degrees.<br/><br/>The rotation will take the values of <b>X</b>, <b>Y</b>, <b>O</b> and apply a rotation<br/>(<i>with <b>O</b> being the pivot</i>).<br/><br/><b>NOTE</b>:<br/>the resulting affine coefficients are not updated in the UI but passed directly internally to the algorithm."
                        range   { -90 90 }
                        parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_iterator_utils(kwargs).reset_preaffine()" }
                        parmtag { "script_action_help" "[LMB] to reset all affine values. [SHIFT+LMB] to reset only the affine X and Y values. [CTRL+LMB] to reset only the affine O value. [ALT+LMB] to reset only the affine Rotation angle value." }
                        parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteKwargsSVG.svg" }
                        parmtag { "script_callback_language" "python" }
                    }
                }

            }

            group {
                name    "f_iteraffine_#_1"
                label   "#: post affine"

                groupsimple {
                    name    "f_iterpostaffinedata_#"
                    label   "POST AFFINE"
                    disablewhentab "{ dopost_# == 0 } { vactive_# == 0 } { iw_# == 0 }"
                    grouptag { "group_type" "simple" }

                    parm {
                        name    "pscl_#"
                        label   "Scale"
                        type    float
                        default { "1" }
                        help    "Scale <u><b>post affine</b></u> values (<i><b>X</b> and <b>Y</b></i>) by an amount,<br/>with a value of <b>1</b>(<i>one</i>) (<i>100% -> no scale</i>) being the default.<br/><br/><b>The are two ways to use this parameter</b>:<ol><li>Input a value into the numeric field. For example if you type: <b>1.2</b> it will scale the affine up by <b>20%</b>.</li><li>[<b>LMB</b>] into the numeric field and use the [<b>Mouse Wheel</b>] to increment the scale up or down.</li></ol><b>When using the mouse wheel (<i><b>2</b></i>)</b>:<ul><li>[<b>Mouse Wheel</b>]<br/>will scale the value by an increment of: <b>+/- 0.1</b></li><li>[<b>SHIFT+Mouse Wheel</b>]<br/>will scale the value by an increment of: <b>+/- 0.01</b></li><li>[<b>CTRL+Mouse Wheel</b>]<br/>will scale the value by an increment of: <b>+/- 1</b></li></ul><br/><i>Additionally</i>:<br/><i>The parameter's slider ranges are between <b>0.975</b> and <b>1.025</b> to allow for precise and very small value changes when dragged left or right</i>.<br/><br/><u><b>This parameter can not be animated</b></u>.<br/><br/><b>NOTE</b>:<br/>Every time you either input a value, drag the slider or use the mouse wheel to increment the value, it will revert back to the default value of <b>1</b>(<i>one</i>) (<i>100% -> no scale</i>)."
                        range   { 0.975 1.025 }
                        parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_iterator_utils(kwargs).prm_paste_sel_post_affine()" }
                        parmtag { "script_action_help" "[LMB] to copy the values from the PRE Affine into here, the POST Affine. It will copy: X, Y, O and Rot. Additionally: [SHIFT+LMB] to copy only the X and Y values. [CTRL+LMB] to copy only the O value. [ALT+LMB] to copy only the Rotation angle value." }
                        parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_StarSwapRedCopyPasteAffineSVG.svg" }
                        parmtag { "script_callback" "hou.phm().flam3.flam3h_iterator_utils(kwargs).iterator_post_affine_scale()" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "px_#"
                        label   "X"
                        type    vector2
                        size    2
                        default { "1" "0" }
                        help    "<u><b>post affine</b></u>: <b>X</b>.<i>x</i>, <b>X</b>.<i>y</i> ( [<b>A</b>], [<b>D</b>] )"
                        range   { -1 1 }
                        parmtag { "script_callback" "" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "py_#"
                        label   "Y"
                        type    vector2
                        size    2
                        default { "0" "1" }
                        help    "<u><b>post affine</b></u>: <b>Y</b>.<i>x</i>, <b>Y</b>.<i>y</i> ( [<b>B</b>], [<b>E</b>] )"
                        range   { -1 1 }
                        parmtag { "script_callback" "" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "po_#"
                        label   "O"
                        type    vector2
                        size    2
                        default { "0" "0" }
                        help    "<u><b>post affine</b></u> (<b>O</b><i>ffset</i>): <b>O</b>.<i>x</i>, <b>O</b>.<i>y</i> ( [<b>C</b>], [<b>F</b>] )"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "pang_#"
                        label   "Rot"
                        type    float
                        default { "0" }
                        help    "Rotate <u><b>post affine</b></u> in angle degrees.<br/><br/>The rotation will take the values of <b>X</b>, <b>Y</b>, <b>O</b> and apply a rotation<br/>(<i>with <b>O</b> being the pivot</i>).<br/><br/><b>NOTE</b>:<br/>the resulting affine coefficients are not updated in the UI but passed directly internally to the algorithm."
                        range   { -90 90 }
                        parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_iterator_utils(kwargs).reset_postaffine()" }
                        parmtag { "script_action_help" "[LMB] to reset all affine values. [SHIFT+LMB] to reset only the affine X and Y values. [CTRL+LMB] to reset only the affine O value. [ALT+LMB] to reset only the affine Rotation angle value." }
                        parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteKwargsSVG.svg" }
                        parmtag { "script_callback_language" "python" }
                    }
                }

            }

            group {
                name    "f_iteraffine_#_2"
                label   "#: VARS"

                groupsimple {
                    name    "f_itervariablesdata_#"
                    label   "VARS PARAMETERS"
                    disablewhentab "{ vactive_# == 0 } { iw_# == 0 }"
                    grouptag { "group_type" "simple" }

                    parm {
                        name    "auger_#"
                        label   "f/s/s/w AUGER"
                        type    vector4
                        size    4
                        default { "1" "2" "1" "1" }
                        help    "<br/><i>Auger</i> <u><b>F</b></u><i>requency</i>, <u><b>S</b></u><i>cale</i>, <u><b>S</b></u><i>ymmetry</i>, <u><b>W</b></u><i>eight</i> <h2>X -> Frequency</h2> Controls the size of the waves. Higher values create smaller, more frequent ripples. <h2>Y -> Scale</h2> Adjusts the size of the wave deformation. Higher values produce broader, more noticeable bends. <h2>Z -> Symmetry</h2> Balances how evenly the effect is applied across the pattern. <h2>W -> Weight</h2> Controls the overall strength of the deformation. Higher values produce a stronger effect."
                        hidewhen "{ p1type_# != 94 pre1type_# != 94 pre2type_# != 94 v1type_# != 94 v2type_# != 94 v3type_# != 94 v4type_# != 94 v5type_# != 94 }"
                        range   { 0 4 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "bent2xy_#"
                        label   "xy BENT2"
                        type    vector2
                        size    2
                        default { "1.5" "0" }
                        help    "<br/><i>Bent2</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X</h2> Controls how much the negative X (<i>left</i>) side of the pattern is stretched or compressed. <h2>Y</h2> Controls how much the negative Y (<i>bottom</i>) side of the pattern is stretched or compressed."
                        hidewhen "{ p1type_# != 52 pre1type_# != 52 pre2type_# != 52 v1type_# != 52 v2type_# != 52 v3type_# != 52 v4type_# != 52 v5type_# != 52 }"
                        range   { 0 2 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "bipolarshift_#"
                        label   "shift BIPOLAR"
                        type    float
                        default { "1" }
                        help    "<br/><i>Bipolar</i> <u><b>Shift</b></u> <h2>Shift</h2> Moves the seam of the bipolar mapping around the pattern, changing where the transformation wraps."
                        hidewhen "{ p1type_# != 53 pre1type_# != 53 pre2type_# != 53 v1type_# != 53 v2type_# != 53 v3type_# != 53 v4type_# != 53 v5type_# != 53 }"
                        range   { 0 10 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "blob_#"
                        label   "low/high/waves BLOB"
                        type    vector
                        size    3
                        default { "0.2" "1" "6" }
                        help    "<br/><i>Blob</i> <u><b>Low</b></u>, <u><b>High</b></u>, <u><b>Waves</b></u> <h2>X -> Low</h2> Sets the minimum size of the blob. <h2>Y -> High</h2> Sets the maximum size of the blob. <h2>Z -> Waves</h2> Controls the number of bulges or lobes around the blob. Higher values create more repeating bumps."
                        hidewhen "{ pre1type_# != 30 pre2type_# != 30 p1type_# != 30 v1type_# != 30 v2type_# != 30 v3type_# != 30 v4type_# != 30 v5type_# != 30 }"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "bwraps_#"
                        label   "s/s/g BWRAPS"
                        type    vector
                        size    3
                        default { "0.5" "0" "1" }
                        help    "<br/><i>Bwraps</i> <u><b>S</b></u><i>ize</i>, <u><b>S</b></u><i>pace</i>, <u><b>G</b></u><i>ain</i> <h2>X -> Size</h2> Controls the size of each bubble wrap cell. Larger values create bigger wrapped areas. <h2>Y -> Space</h2> Controls the spacing between bubble cells. Higher values spread the bubbles farther apart. <h2>Z -> Gain</h2> Controls the intensity of the bubble distortion. Higher values create a stronger wrapping effect."
                        hidewhen "{ p1type_# != 99 pre1type_# != 99 pre2type_# != 99 v1type_# != 99 v2type_# != 99 v3type_# != 99 v4type_# != 99 v5type_# != 99 }"
                        range   { 0 2 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "bwrapstwist_#"
                        label   "in/out twist BWRAPS"
                        type    vector2
                        size    2
                        default { "3" "0" }
                        help    "<br/><i>Bwraps</i> <u><b>IN Twist</b></u>, <u><b>OUT Twist</b></u> <h2>X -> IN Twist</h2> Controls the amount of rotation applied toward the center of each bubble. <h2>Y -> OUT Twist</h2> Controls the amount of rotation applied toward the outside of each bubble."
                        hidewhen "{ p1type_# != 99 pre1type_# != 99 pre2type_# != 99 v1type_# != 99 v2type_# != 99 v3type_# != 99 v4type_# != 99 v5type_# != 99 }"
                        range   { 0 2 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "cellsize_#"
                        label   "size CELL"
                        type    float
                        default { "0.05" }
                        help    "<br/><i>Cell</i> <u><b>Size</b></u> <h2>Size</h2> Controls the size of the repeating cells. Smaller values create more, smaller cells; larger values create fewer, larger cells."
                        hidewhen "{ p1type_# != 56 pre1type_# != 56 pre2type_# != 56 v1type_# != 56 v2type_# != 56 v3type_# != 56 v4type_# != 56 v5type_# != 56 }"
                        range   { 0 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "conic_#"
                        label   "ecc/holes CONIC"
                        type    vector2
                        size    2
                        default { "0.5" "0.5" }
                        help    "<br/><i>Conic</i> <u><b>Eccentricity</b></u>, <u><b>Holes</b></u> <h2>X -> Eccentricity</h2> Controls the shape and intensity of the cone distortion. <h2>Y -> Holes</h2> Adjusts the amount of open space in the conic pattern."
                        hidewhen "{ p1type_# != 50 pre1type_# != 50 pre2type_# != 50 v1type_# != 50 v2type_# != 50 v3type_# != 50 v4type_# != 50 v5type_# != 50 }"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "cpow_#"
                        label   "pow/r/i CPOW"
                        type    vector
                        size    3
                        default { "2" "1" "0.25" }
                        help    "<br/><i>Cpow</i> <u><b>Power</b></u>, <u><b>R</b></u>, <u><b>I</b></u> <h2>X -> Power</h2> Controls the number of repeated spiral sections. Higher values create more repetitions and finer details. <h2>Y -> R</h2> Controls the radial distortion, affecting how the pattern expands or contracts from the center. <h2>Z -> I</h2> Controls the angular distortion, changing the twist and rotation of the pattern."
                        hidewhen "{ p1type_# != 57 pre1type_# != 57 pre2type_# != 57 v1type_# != 57 v2type_# != 57 v3type_# != 57 v4type_# != 57 v5type_# != 57 }"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "cropltrb_#"
                        label   "l/t/r/b CROP"
                        type    vector4
                        size    4
                        default { "-1" "-1" "1" "1" }
                        help    "<br/><i>Crop</i> <u><b>L</b></u><i>eft</i>, <u><b>T</b></u><i>op</i>, <u><b>R</b></u><i>ight</i>, <u><b>B</b></u><i>ottom</i> <h2>X -> Left</h2> Sets the left boundary of the crop area. <h2>Y -> Top</h2> Sets the top boundary of the crop area. <h2>Z -> Right</h2> Sets the right boundary of the crop area. <h2>W -> Bottom</h2> Sets the bottom boundary of the crop area."
                        hidewhen "{ p1type_# != 102 pre1type_# != 102 pre2type_# != 102 v1type_# != 102 v2type_# != 102 v3type_# != 102 v4type_# != 102 v5type_# != 102 }"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "cropaz_#"
                        label   "area/zero CROP"
                        type    vector2
                        size    2
                        default { "0" "0" }
                        help    "<br/><i>Crop</i> <u><b>Area</b></u>, <u><b>Zero</b></u> <h2>X -> Area</h2> Controls the amount of random repositioning inside the crop area. Higher values create a larger randomized region. <h2>Y -> Zero</h2> Controls what happens to points outside the crop area. When enabled (<i>it just need to be higher than <b>0</b>(Zero)</i>), outside points are moved to the center instead."
                        hidewhen "{ p1type_# != 102 pre1type_# != 102 pre2type_# != 102 v1type_# != 102 v2type_# != 102 v3type_# != 102 v4type_# != 102 v5type_# != 102 }"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "curlc_#"
                        label   "c1/c2 CURL"
                        type    vector2
                        size    2
                        default { "0" "0" }
                        help    "<br/><i>Curl</i> <u><b>C1</b></u>, <u><b>C2</b></u> <h2>X -> C1 (Curl Strength)</h2> Controls the overall curl direction and strength. Higher values create a stronger bending effect. <h2>Y -> C2 (Curl Twist)</h2> Controls the secondary curl behavior, adding more twisting and variation to the distortion."
                        hidewhen "{ pre1type_# != 27 pre2type_# != 27 p1type_# != 27 v1type_# != 27 v2type_# != 27 v3type_# != 27 v4type_# != 27 v5type_# != 27 }"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "curvexyzlenght_#"
                        label   "lenght:xy CURVE"
                        type    vector2
                        size    2
                        default { "1" "1" }
                        help    "<br/><i>Curve</i> <u><b>Lenght X</b></u>, <u><b>Lenght Y</b></u> <h2>X -> Lenght X</h2> Controls the horizontal range of the curve effect. Larger values make the curve spread over a wider area. <h2>Y -> Lenght Y</h2> Controls the vertical range of the curve effect. Larger values make the curve spread over a wider area."
                        hidewhen "{ p1type_# != 97 pre1type_# != 97 pre2type_# != 97 v1type_# != 97 v2type_# != 97 v3type_# != 97 v4type_# != 97 v5type_# != 97 }"
                        range   { 0 2 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "curvexyzamp_#"
                        label   "amp:xy CURVE"
                        type    vector2
                        size    2
                        default { "0" "0" }
                        help    "<br/><i>Curve</i> <u><b>Amplitude X</b></u>, <u><b>Amplitude Y</b></u> <h2>X -> Amplitude X</h2> Controls the strength of the horizontal bend. Higher values create a stronger curve along X. <h2>Y -> Amplitude Y</h2> Controls the strength of the vertical bend. Higher values create a stronger curve along Y."
                        hidewhen "{ p1type_# != 97 pre1type_# != 97 pre2type_# != 97 v1type_# != 97 v2type_# != 97 v3type_# != 97 v4type_# != 97 v5type_# != 97 }"
                        range   { 0 2 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "disc2_#"
                        label   "rot/twist DISC2"
                        type    vector2
                        size    2
                        default { "6" "0.5" }
                        help    "<br/><i>Disc2</i> <u><b>Rotation</b></u>, <u><b>Twist</b></u> <h2>X -> Rotation</h2> Rotates the disc pattern. Adjust this to change the overall orientation of the effect. <h2>Y -> Twist</h2> Adds a twisting offset to the disc pattern, changing how tightly or loosely it spirals."
                        hidewhen "{ p1type_# != 47 pre1type_# != 47 pre2type_# != 47 v1type_# != 47 v2type_# != 47 v3type_# != 47 v4type_# != 47 v5type_# != 47 }"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "escherbeta_#"
                        label   "beta ESCHER"
                        type    float
                        default { "1" }
                        help    "<br/><i>Escher</i> <u><b>Beta</b></u> <h2>Beta</h2> Controls the intensity of the Escher distortion. Lower values create a subtle transformation, while higher values produce stronger twisting and scaling effects."
                        hidewhen "{ p1type_# != 61 pre1type_# != 61 pre2type_# != 61 v1type_# != 61 v2type_# != 61 v3type_# != 61 v4type_# != 61 v5type_# != 61 }"
                        range   { 0 2 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "fan2_#"
                        label   "size/rot FAN2"
                        type    vector2
                        size    2
                        default { "-0.933803" "0.873941" }
                        help    "<br/><i>Fan2</i> <u><b>Size</b></u>, <u><b>Rotation</b></u> <h2>X -> Size</h2> Controls how wide each fan segment is. Lower values create many thin segments, while higher values create fewer, broader segments. <h2>Y -> Rotation</h2> Rotates the entire fan pattern around the center without changing its shape."
                        hidewhen "{ p1type_# != 34 pre1type_# != 34 pre2type_# != 34 v1type_# != 34 v2type_# != 34 v3type_# != 34 v4type_# != 34 v5type_# != 34 }"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "flower_#"
                        label   "petals/holes FLOWER"
                        type    vector2
                        size    2
                        default { "5" "0.5" }
                        help    "<br/><i>Flower</i> <u><b>Petals</b></u>, <u><b>Holes</b></u> <h2>X -> Petals</h2> Controls the number of petals in the flower pattern. Higher values create more petals and finer details. <h2>Y -> Holes</h2> Controls the amount of empty space between petals. Higher values create a more open, hollow flower shape."
                        hidewhen "{ p1type_# != 49 pre1type_# != 49 pre2type_# != 49 v1type_# != 49 v2type_# != 49 v3type_# != 49 v4type_# != 49 v5type_# != 49 }"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "fluxspread_#"
                        label   "spread FLUX"
                        type    float
                        default { "0.5" }
                        help    "<br/><i>Flux</i> <u><b>Spread</b></u> <h2>Spread</h2> Controls the intensity of the flux effect. Higher values create a wider, stronger flow distortion; lower values keep the effect tighter and more subtle."
                        hidewhen "{ p1type_# != 95 pre1type_# != 95 pre2type_# != 95 v1type_# != 95 v2type_# != 95 v3type_# != 95 v4type_# != 95 v5type_# != 95 }"
                        range   { 0 2 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "julian_#"
                        label   "power/dist JULIAN"
                        type    vector2
                        size    2
                        default { "6" "1" }
                        help    "<br/><i>JuliaN</i> <u><b>Power</b></u>, <u><b>Distance</b></u> <h2>X -> Power</h2> Controls the number of repeated sections in the pattern. Higher values create more symmetrical repetitions and finer details. <h2>Y -> Distance</h2> Controls how the pattern expands or contracts from the center. Higher values change the overall spread and shape of the distortion. <br/><br/> <b>TIP</b>:<br/> <i>The copies all rotate in the same direction, creating a more continuous spiral or radial repetition.</i>"
                        hidewhen "{ p1type_# != 31 pre1type_# != 31 pre2type_# != 31 v1type_# != 31 v2type_# != 31 v3type_# != 31 v4type_# != 31 v5type_# != 31 }"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "juliascope_#"
                        label   "power/dist JULIASCOPE"
                        type    vector2
                        size    2
                        default { "5" "1" }
                        help    "<br/><i>JuliaScope</i> <u><b>Power</b></u>, <u><b>Distance</b></u> <h2>X -> Power</h2> Controls the number of repeated sections in the pattern. Higher values create more symmetrical details and tighter repetitions. <h2>Y -> Distance</h2> Controls how the pattern expands or contracts from the center, affecting the overall size and spread of the distortion. <br/><br/> <b>TIP</b>:<br/> <i>Creates a mirrored repetition around the center, producing kaleidoscope-like fractal patterns.</i>"
                        hidewhen "{ p1type_# != 32 pre1type_# != 32 pre2type_# != 32 v1type_# != 32 v2type_# != 32 v3type_# != 32 v4type_# != 32 v5type_# != 32 }"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "lazysusanxyz_#"
                        label   "xy LAZYSUSAN"
                        type    vector2
                        size    2
                        default { "0" "0" }
                        help    "<br/><i>Lazysusan</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X</h2> Moves the center of the effect horizontally. <h2>Y</h2> Moves the center of the effect vertically."
                        hidewhen "{ p1type_# != 63 pre1type_# != 63 pre2type_# != 63 v1type_# != 63 v2type_# != 63 v3type_# != 63 v4type_# != 63 v5type_# != 63 }"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "lazysusan_#"
                        label   "s/t/s LAZYSUSAN"
                        type    vector
                        size    3
                        default { "3.14159" "0" "0" }
                        help    "<br/><i>Lazysusan</i> <u><b>S</b></u><i>pin</i>, <u><b>T</b></u><i>wist</i>, <u><b>S</b></u><i>pace</i> <h2>X -> Spin</h2> Rotates the area near the center. Higher values increase the amount of rotation. <h2>Y -> Twist</h2> Adds extra twisting toward the center, creating a spiral-like effect. <h2>Z -> Space</h2> Controls how strongly points outside the center are pushed away."
                        hidewhen "{ p1type_# != 63 pre1type_# != 63 pre2type_# != 63 v1type_# != 63 v2type_# != 63 v3type_# != 63 v4type_# != 63 v5type_# != 63 }"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "mobiusre_#"
                        label   "re:abcd MOBIUS"
                        type    vector4
                        size    4
                        default { "1" "0" "0" "1" }
                        help    "<br/><i>Mobius real</i> <u><b>A</b></u>, <u><b>B</b></u>, <u><b>C</b></u>, <u><b>D</b></u> <h2>X -> reA - Transform</h2> Controls the main transformation strength, including rotation, scaling, and distortion. <h2>Y -> reB - Offset</h2> Controls the offset/translation of the transformation. <h2>Z -> reC - Warp</h2> Controls the amount of inversion and warping behavior. <h2>W -> reD - Balance</h2> Controls the final shift and overall transformation balance."
                        hidewhen "{ p1type_# != 96 pre1type_# != 96 pre2type_# != 96 v1type_# != 96 v2type_# != 96 v3type_# != 96 v4type_# != 96 v5type_# != 96 }"
                        range   { 0 2 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "mobiusim_#"
                        label   "im:abcd MOBIUS"
                        type    vector4
                        size    4
                        default { "0" "0" "1" "0" }
                        help    "<br/><i>Mobius imaginary</i> <u><b>A</b></u>, <u><b>B</b></u>, <u><b>C</b></u>, <u><b>D</b></u> <h2>X -> imA - Transform</h2> Controls the main transformation strength, including rotation, scaling, and distortion. <h2>Y -> imB - Offset</h2> Controls the offset/translation of the transformation. <h2>Z -> imC - Warp</h2> Controls the amount of inversion and warping behavior. <h2>W -> imD - Balance</h2> Controls the final shift and overall transformation balance."
                        hidewhen "{ p1type_# != 96 pre1type_# != 96 pre2type_# != 96 v1type_# != 96 v2type_# != 96 v3type_# != 96 v4type_# != 96 v5type_# != 96 }"
                        range   { 0 2 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "modulusXYZ_#"
                        label   "xy MODULUS"
                        type    vector2
                        size    2
                        default { "1" "1" }
                        help    "<br/><i>Modulus</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X</h2> Controls the horizontal repetition size. Larger values create wider repeating sections along X. <h2>Y</h2> Controls the vertical repetition size. Larger values create taller repeating sections along Y."
                        hidewhen "{ p1type_# != 66 pre1type_# != 66 pre2type_# != 66 v1type_# != 66 v2type_# != 66 v3type_# != 66 v4type_# != 66 v5type_# != 66 }"
                        range   { 0 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "ngon_#"
                        label   "p/s/c/c NGON"
                        type    vector4
                        size    4
                        default { "2" "4" "1" "1" }
                        help    "<br/><i>Ngon</i> <u><b>P</b></u><i>ower</i>, <u><b>S</b></u><i>ides</i>, <u><b>C</b></u><i>orner</i>, <u><b>C</b></u><i>ircle</i> <h2>X -> Power</h2> Controls the overall scaling and radial behavior of the shape. Higher values change the size and intensity of the transformation. <h2>Y -> Sides</h2> Controls the number of sides of the polygon. Lower values create simpler shapes (triangle, square, etc.), while higher values create more circular forms. <h2>Z -> Corner</h2> Controls the sharpness of the polygon corners. Higher values emphasize the corners; lower values make the shape smoother. <h2>W -> Circle</h2> Controls the roundness of the polygon. Higher values make the shape more circular, while lower values keep sharper polygon edges."
                        hidewhen "{ pre1type_# != 28 pre2type_# != 28 p1type_# != 28 v1type_# != 28 v2type_# != 28 v3type_# != 28 v4type_# != 28 v5type_# != 28 }"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "oscope_#"
                        label   "f/a/d/s OSCOPE"
                        type    vector4
                        size    4
                        default { "3.14159" "1" "0" "1" }
                        help    "<br/><i>Oscope</i> <u><b>F</b></u><i>requency</i>, <u><b>A</b></u><i>mplitude</i>, <u><b>D</b></u><i>amping</i>, <u><b>S</b></u><i>eparation</i> <h2>X -> Frequency</h2> Controls how many waves appear across the pattern. Higher values create more frequent oscillations. <h2>Y -> Amplitude</h2> Controls the height/strength of the wave distortion. Higher values create larger wave movements. <h2>Z -> Damping</h2> Controls how quickly the wave fades away from the center. Higher values make the effect disappear faster. <h2>W -> Separation</h2> Controls the base offset of the wave boundary, changing the position where the flip occurs."
                        hidewhen "{ p1type_# != 67 pre1type_# != 67 pre2type_# != 67 v1type_# != 67 v2type_# != 67 v3type_# != 67 v4type_# != 67 v5type_# != 67 }"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "parabola_#"
                        label   "height/width PARABOLA"
                        type    vector2
                        size    2
                        default { "2" "3" }
                        help    "<br/><i>Parabola</i> <u><b>Height</b></u>, <u><b>Width</b></u> <h2>X -> Eight</h2> Controls the vertical strength of the parabola. Higher values make the curve extend further. <h2>Y -> Width</h2> Controls the horizontal spread of the parabola. Higher values make the curve wider and softer."
                        hidewhen "{ p1type_# != 51 pre1type_# != 51 pre2type_# != 51 v1type_# != 51 v2type_# != 51 v3type_# != 51 v4type_# != 51 v5type_# != 51 }"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "pdjw_#"
                        label   "w ABCD PDJ"
                        type    vector4
                        size    4
                        default { "1" "1" "1" "1" }
                        help    "<br/><i>PDJ</i> <u><b>wA</b></u>, <u><b>wB</b></u>, <u><b>wC</b></u>, <u><b>wD</b></u> <h2>X -> wA</h2> Controls the frequency of the wave affecting the X direction. Higher values create tighter, more frequent variations. <h2>Y -> wB</h2> Controls the frequency of the wave affecting the X direction's secondary pattern. <h2>Z -> wC</h2> Controls the frequency of the wave affecting the Y direction. Higher values create tighter, more frequent variations. <h2>W -> wD</h2> Controls the frequency of the wave affecting the Y direction's secondary pattern."
                        hidewhen "{ pre1type_# != 29 pre2type_# != 29 p1type_# != 29 v1type_# != 29 v2type_# != 29 v3type_# != 29 v4type_# != 29 v5type_# != 29 }"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "persp_#"
                        label   "angle/dist PERSPECTIVE"
                        type    vector2
                        size    2
                        default { "0.5" "0.5" }
                        help    "<br/><i>Perspective</i> <u><b>Angle</b></u>, <u><b>Distance</b></u> <h2>X -> Angle</h2> Controls the viewing angle of the perspective effect. Higher values create a stronger tilt or distortion. <h2>Y -> Distance</h2> Controls the distance of the virtual camera. Higher values reduce the perspective distortion; lower values create a stronger depth effect."
                        hidewhen "{ p1type_# != 98 pre1type_# != 98 pre2type_# != 98 v1type_# != 98 v2type_# != 98 v3type_# != 98 v4type_# != 98 v5type_# != 98 }"
                        range   { 0 2 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "pie_#"
                        label   "slice/thick/rot PIE"
                        type    vector
                        size    3
                        default { "6" "0.5" "0" }
                        help    "<br/><i>Pie</i> <u><b>Slices</b></u>, <u><b>Thickness</b></u>, <u><b>Rotation</b></u> <h2>X -> Slices</h2> Controls the number of pie sections. Higher values create more individual slices around the circle. <h2>Y -> Thickness</h2> Controls how much of each slice is filled. Lower values create thinner slices; higher values fill more of each section. <h2>Z -> Rotation</h2> Rotates the pie pattern around the center."
                        hidewhen "{ p1type_# != 38 pre1type_# != 38 pre2type_# != 38 v1type_# != 38 v2type_# != 38 v3type_# != 38 v4type_# != 38 v5type_# != 38 }"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "ptsym_#"
                        label   "o/x/y POINT SYMMETRY"
                        type    vector
                        size    3
                        default { "3" "0" "0" }
                        help    "<br/><i>Point Symmetry</i> <u><b>O</b></u><i>rder</i>, <i>Center </i><u><b>X</b></u>, <i>Center </i><u><b>Y</b></u> <h2>X -> Order</h2> Controls the number of symmetry repetitions around the center. Higher values create more repeated copies and finer radial patterns. <h2>Y -> Center X</h2> Moves the symmetry center horizontally. <h2>Z -> Center Y</h2> Moves the symmetry center vertically."
                        hidewhen "{ p1type_# != 105 pre1type_# != 105 pre2type_# != 105 v1type_# != 105 v2type_# != 105 v3type_# != 105 v4type_# != 105 v5type_# != 105 }"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "polynomialpow_#"
                        label   "pow:xy POLYNOMIAL"
                        type    vector2
                        size    2
                        default { "1" "1" }
                        help    "<br/><i>Polynomial</i> <u><b>Power X</b></u>, <u><b>Power Y</b></u> <h2>X -> Power X</h2> Controls the shape of the curve along the X axis. Higher values create stronger, sharper changes; lower values create softer curves. <h2>Y -> Power Y</h2> Controls the shape of the curve along the Y axis. Higher values create stronger, sharper changes; lower values create softer curves."
                        hidewhen "{ p1type_# != 101 pre1type_# != 101 pre2type_# != 101 v1type_# != 101 v2type_# != 101 v3type_# != 101 v4type_# != 101 v5type_# != 101 }"
                        range   { 0 2 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "polynomiallc_#"
                        label   "lc:xy POLYNOMIAL"
                        type    vector2
                        size    2
                        default { "0" "0" }
                        help    "<br/><i>Polynomial</i> <u><b>Linear X</b></u>, <u><b>Linear Y</b></u> <h2>X -> Linear X</h2> Controls the amount of regular scaling applied along the X axis. <h2>Y -> Linear Y</h2> Controls the amount of regular scaling applied along the Y axis."
                        hidewhen "{ p1type_# != 101 pre1type_# != 101 pre2type_# != 101 v1type_# != 101 v2type_# != 101 v3type_# != 101 v4type_# != 101 v5type_# != 101 }"
                        range   { 0 2 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "polynomialsc_#"
                        label   "sc:xy POLYNOMIAL"
                        type    vector2
                        size    2
                        default { "0" "0" }
                        help    "<br/><i>Polynomial</i> <u><b>Scale X</b></u>, <u><b>Scale Y</b></u> <h2>X -> Scale X</h2> Adds a horizontal offset to the result. <h2>Y -> Scale Y</h2> Adds a vertical offset to the result."
                        hidewhen "{ p1type_# != 101 pre1type_# != 101 pre2type_# != 101 v1type_# != 101 v2type_# != 101 v3type_# != 101 v4type_# != 101 v5type_# != 101 }"
                        range   { 0 2 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "popcorn2xyz_#"
                        label   "xy POPCORN2"
                        type    vector2
                        size    2
                        default { "0.1" "0.1" }
                        help    "<br/><i>Popcorn2</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X -> Horizontal</h2> Controls the strength of the effect along the X (horizontal) direction. <h2>Y -> Vertical</h2> Controls the strength of the effect along the Y (vertical) direction."
                        hidewhen "{ p1type_# != 69 pre1type_# != 69 pre2type_# != 69 v1type_# != 69 v2type_# != 69 v3type_# != 69 v4type_# != 69 v5type_# != 69 }"
                        range   { 0 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "popcorn2c_#"
                        label   "c POPCORN2"
                        type    float
                        default { "2" }
                        help    "<br/><i>Popcorn2</i> <u><b>C</b></u> <h2>C - Detail</h2> Controls the frequency of the popcorn ripples. Higher values create finer, more intricate patterns."
                        hidewhen "{ p1type_# != 69 pre1type_# != 69 pre2type_# != 69 v1type_# != 69 v2type_# != 69 v3type_# != 69 v4type_# != 69 v5type_# != 69 }"
                        range   { 0 8 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "radialblur_#"
                        label   "angle RADIALBLUR"
                        type    float
                        default { "0.5" }
                        help    "<br/><i>Radial Blur</i> <u><b>Angle</b></u> <h2>Angle</h2> Controls the intensity of the radial blur. Higher values create stronger circular motion and zoom-like distortion."
                        hidewhen "{ p1type_# != 37 pre1type_# != 37 pre2type_# != 37 v1type_# != 37 v2type_# != 37 v3type_# != 37 v4type_# != 37 v5type_# != 37 }"
                        range   { 0 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "rectangles_#"
                        label   "xy RECTANGLE"
                        type    vector2
                        size    2
                        default { "1" "1" }
                        help    "<br/><i>Rectangles</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X -> Width</h2> Controls the width of the repeating rectangles. Larger values create wider horizontal sections. <h2>Y -> Height</h2> Controls the height of the repeating rectangles. Larger values create taller vertical sections."
                        hidewhen "{ p1type_# != 36 pre1type_# != 36 pre2type_# != 36 v1type_# != 36 v2type_# != 36 v3type_# != 36 v4type_# != 36 v5type_# != 36 }"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "rings2val_#"
                        label   "val RINGS2"
                        type    float
                        default { "1" }
                        help    "<br/><i>Rings2</i> <u><b>Value</b></u> <h2>Value</h2> Controls the size of the rings. Smaller values create more frequent rings, while larger values create wider spacing between rings."
                        hidewhen "{ p1type_# != 35 pre1type_# != 35 pre2type_# != 35 v1type_# != 35 v2type_# != 35 v3type_# != 35 v4type_# != 35 v5type_# != 35 }"
                        range   { 0 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "separationxyz_#"
                        label   "xy SEPARATION"
                        type    vector2
                        size    2
                        default { "0.5" "0.5" }
                        help    "<br/><i>Separation</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X -> Horizontal separation</h2> Controls the horizontal separation distance. Higher values push the left and right sides farther apart. <h2>Y -> Vertical separation</h2> Controls the vertical separation distance. Higher values push the top and bottom areas farther apart."
                        hidewhen "{ p1type_# != 71 pre1type_# != 71 pre2type_# != 71 v1type_# != 71 v2type_# != 71 v3type_# != 71 v4type_# != 71 v5type_# != 71 }"
                        range   { 0 2 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "separationinsidexyz_#"
                        label   "inside xy SEPARATION"
                        type    vector2
                        size    2
                        default { "1.5" "1.5" }
                        help    "<br/><i>Separation</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X -> Horizontal influence</h2> Controls the horizontal influence of the separation effect. Higher values increase the internal spread along X. <h2>Y -> Vertical influence</h2> Controls the vertical influence of the separation effect. Higher values increase the internal spread along Y."
                        hidewhen "{ p1type_# != 71 pre1type_# != 71 pre2type_# != 71 v1type_# != 71 v2type_# != 71 v3type_# != 71 v4type_# != 71 v5type_# != 71 }"
                        range   { 0 4 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "splitxyz_#"
                        label   "xy SPLIT"
                        type    vector2
                        size    2
                        default { "4" "1" }
                        help    "<br/><i>Split</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X -> Horizontal split</h2> Controls the number of horizontal splits. Higher values create more repeated left/right flips (<i>mirror</i>) sections. <h2>Y -> Vertical split</h2> Controls the number of vertical splits. Higher values create more repeated top/bottom flips (<i>mirror</i>) sections."
                        hidewhen "{ p1type_# != 72 pre1type_# != 72 pre2type_# != 72 v1type_# != 72 v2type_# != 72 v3type_# != 72 v4type_# != 72 v5type_# != 72 }"
                        range   { 0 8 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "splitsxyz_#"
                        label   "xy SPLITS"
                        type    vector2
                        size    2
                        default { "1" "1" }
                        help    "<br/><i>Splits</i> <u><b>X</b></u>, <u><b>Y</b></u> <h2>X -> Horizontal split distance</h2> Controls the horizontal separation offset. Higher values push the left and right sides farther apart. <h2>Y -> Vertical split distance</h2> Controls the vertical separation offset. Higher values push the top and bottom sides farther apart. <br/><br/> <b>TIP</b>:<br/> <i>Unlike <b>Split</b>, which creates repeated mirrored sections, <b>Splits</b> simply separates the positive and negative sides.</i>"
                        hidewhen "{ p1type_# != 73 pre1type_# != 73 pre2type_# != 73 v1type_# != 73 v2type_# != 73 v3type_# != 73 v4type_# != 73 v5type_# != 73 }"
                        range   { 0 2 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "stripes_#"
                        label   "space/warp STRIPES"
                        type    vector2
                        size    2
                        default { "0.5" "0" }
                        help    "<br/><i>Stripes</i> <u><b>Space</b></u>, <u><b>Warp</b></u> <h2>X -> Space</h2> Controls the spacing and compression of the stripes. Higher values change how tightly the stripes are packed. <h2>Y -> Warp</h2> Controls the amount of bending or distortion applied to the stripes. Higher values create stronger curved stripe patterns."
                        hidewhen "{ p1type_# != 74 pre1type_# != 74 pre2type_# != 74 v1type_# != 74 v2type_# != 74 v3type_# != 74 v4type_# != 74 v5type_# != 74 }"
                        range   { 0 2 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "supershape_#"
                        label   "m/r/h SUPERSHAPE"
                        type    vector
                        size    3
                        default { "6" "0" "2" }
                        help    "<br/><i>Supershape</i> <u><b>M</b></u>, <u><b>R</b></u><i>andom</i>, <u><b>H</b></u><i>oles</i> <h2>X -> M</h2> Controls the number of repeating features around the shape. Higher values create more lobes, points, or symmetry. <h2>Y -> Random</h2> Adds variation to the size of the generated points. Higher values create more irregular, scattered shapes. <h2>Z -> Holes</h2> Controls the amount of empty space near the center. Higher values create more open or hollow shapes."
                        hidewhen "{ p1type_# != 48 pre1type_# != 48 pre2type_# != 48 v1type_# != 48 v2type_# != 48 v3type_# != 48 v4type_# != 48 v5type_# != 48 }"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "supershapen_#"
                        label   "n SUPERSHAPE"
                        type    vector
                        size    3
                        default { "1" "1" "1" }
                        help    "<br/><i>Supershape</i> <u><b>N1</b></u>, <u><b>N2</b></u>, <u><b>N3</b></u> <h2>X -> N1</h2> Controls the overall shape transition. Changes whether the form appears more rounded or angular. <h2>Y -> N2</h2> Controls the horizontal shape characteristics. Adjusts the width and side curvature of the form. <h2>Z -> N3</h2> Controls the vertical shape characteristics. Adjusts the height and top/bottom curvature of the form."
                        hidewhen "{ p1type_# != 48 pre1type_# != 48 pre2type_# != 48 v1type_# != 48 v2type_# != 48 v3type_# != 48 v4type_# != 48 v5type_# != 48 }"
                        range   { -1 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "waves2scalexyz_#"
                        label   "scale xy WAVES2"
                        type    vector2
                        size    2
                        default { "1" "1" }
                        help    "<br/><i>Waves2</i> <u><b>Scale X</b></u>, <u><b>Scale Y</b></u> <h2>X -> Scale X</h2> Controls the horizontal strength of the wave distortion. Higher values create larger movement along X. <h2>Y -> Scale Y</h2> Controls the vertical strength of the wave distortion. Higher values create larger movement along Y."
                        hidewhen "{ p1type_# != 79 pre1type_# != 79 pre2type_# != 79 v1type_# != 79 v2type_# != 79 v3type_# != 79 v4type_# != 79 v5type_# != 79 }"
                        range   { 0 2 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "waves2freqxyz_#"
                        label   "freq xy WAVES2"
                        type    vector2
                        size    2
                        default { "1" "1" }
                        help    "<br/><i>Waves2</i> <u><b>Frequency X</b></u>, <u><b>Frequency Y</b></u> <h2>X -> Frequency X</h2> Controls how quickly the waves repeat horizontally. Higher values create tighter, more frequent waves. <h2>Y -> Frequency Y</h2> Controls how quickly the waves repeat vertically. Higher values create tighter, more frequent waves."
                        hidewhen "{ p1type_# != 79 pre1type_# != 79 pre2type_# != 79 v1type_# != 79 v2type_# != 79 v3type_# != 79 v4type_# != 79 v5type_# != 79 }"
                        range   { 0 2 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "wedge_#"
                        label   "s/a/h/c WEDGE"
                        type    vector4
                        size    4
                        default { "0" "1.5708" "0" "2" }
                        help    "<br/><i>Wedge</i> <u><b>S</b></u><i>wirl</i>, <u><b>A</b></u><i>ngle</i>, <u><b>H</b></u><i>ole</i>, <u><b>C</b></u><i>ount</i> <h2>X -> Swirl</h2> Controls the amount of twisting applied as points move away from the center. Higher values create a stronger spiral effect. <h2>Y -> Angle</h2> Controls the rotation and width of the wedge sections. Higher values change the orientation and spacing of the wedges. <h2>Z -> Hole</h2> Controls the empty space around the center. Higher values push the pattern outward, creating a larger central gap. <h2>W -> Count</h2> Controls the number of wedge sections around the circle. Higher values create more slices and finer radial details."
                        hidewhen "{ p1type_# != 75 pre1type_# != 75 pre2type_# != 75 v1type_# != 75 v2type_# != 75 v3type_# != 75 v4type_# != 75 v5type_# != 75 }"
                        range   { 0 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "wedgejulia_#"
                        label   "p/a/d/c WEDGEJULIA"
                        type    vector4
                        size    4
                        default { "1" "0" "0" "1" }
                        help    "<br/><i>WedgeJulia</i> <u><b>P</b></u><i>ower</i>, <u><b>A</b></u><i>ngle</i>, <u><b>D</b></u><i>istance</i>, <u><b>C</b></u><i>ount</i> <h2>X -> Power</h2> Controls the number of Julia-style repetitions. Higher values create more repeated sections and finer details <h2>Y -> Angle</h2> Controls the rotation and compression of the wedge sections. Higher values change the orientation and spacing of the slices. <h2>Z -> Distance</h2> Controls the radial scaling of the Julia transformation. Higher values change how far the pattern expands or contracts from the center. <h2>W -> Count</h2> Controls the number of wedge sections around the circle. Higher values create more radial divisions."
                        hidewhen "{ p1type_# != 76 pre1type_# != 76 pre2type_# != 76 v1type_# != 76 v2type_# != 76 v3type_# != 76 v4type_# != 76 v5type_# != 76 }"
                        range   { 0 10 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "wedgesph_#"
                        label   "s/a/h/c WEDGESPH"
                        type    vector4
                        size    4
                        default { "0" "1.5708" "0" "2" }
                        help    "<br/><i>WedgeSph</i> <u><b>S</b></u><i>wirl</i>, <u><b>A</b></u><i>ngle</i>, <u><b>H</b></u><i>ole</i>, <u><b>C</b></u><i>ount</i> <h2>X -> Swirl</h2> Controls the amount of twisting applied from the center outward. Higher values create a stronger spiral distortion. <h2>Y -> Angle</h2> Controls the rotation and compression of the wedge sections. Higher values change the spacing and orientation of the wedges. <h2>Z -> Hole</h2> Controls the distance from the center where the effect begins. Higher values create a larger empty area around the center. <h2>W -> Count</h2> Controls the number of wedge sections around the circle. Higher values create more, thinner sections."
                        hidewhen "{ p1type_# != 77 pre1type_# != 77 pre2type_# != 77 v1type_# != 77 v2type_# != 77 v3type_# != 77 v4type_# != 77 v5type_# != 77 }"
                        range   { 0 1 }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "whorl_#"
                        label   "in/out WHORL"
                        type    vector2
                        size    2
                        default { "3" "0.5" }
                        help    "<br/><i>Whorl</i> <u><b>Inside</b></u>, <u><b>Outside</b></u> <h2>X -> Inside</h2> Controls the amount of rotation applied to points inside the radius. Higher values create a stronger inner spiral twist. <h2>Y - Outside</h2> Controls the amount of rotation applied to points outside the radius. Higher values create a stronger outer spiral twist."
                        hidewhen "{ p1type_# != 78 pre1type_# != 78 pre2type_# != 78 v1type_# != 78 v2type_# != 78 v3type_# != 78 v4type_# != 78 v5type_# != 78 }"
                        range   { 0 6 }
                        parmtag { "script_callback_language" "python" }
                    }
                }

            }

        }

    }

    group {
        name    "f_flam3h_1"
        label   "FF"
        hidewhentab "{ flamefunc == 0 } { h_valid == 0 }"

        groupsimple {
            name    "f_ffmain"
            label   "FF"
            grouptag { "group_type" "simple" }

            parm {
                name    "doff_disabled"
                label   "FF Disabled"
                type    button
                nolabel
                joinnext
                default { "0" }
                help    "Allow you to Enable or Disable the <b>FF</b> (<i>finalXform</i>).<br/>For example this <b>FF</b> is now Disabled. [<b>LMB</b>] to Enable it.<br/><br/>Iterators like Final Flame (<b>FF</b>) or finalXform function like camera lenses.<br/>It allows for a great deal of creative experimentation by taking the combined result of all the iterators inside the FLAME Tab and applying further modifications to that result.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
                disablewhen "{ flamefunc == 0 }"
                hidewhen "{ flamefunc == 0 } { doff == 1 }"
                parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionFFDisabledSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_toggle_private_FF(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "doff_enabled"
                label   "FF Enabled"
                type    button
                nolabel
                joinnext
                default { "0" }
                help    "Allow you to Enable or Disable the <b>FF</b> (<i>finalXform</i>).<br/>For example this <b>FF</b> is now Enabled. [<b>LMB</b>] to Disable it.<br/><br/>Iterators like Final Flame (<b>FF</b>) or finalXform function like camera lenses.<br/>It allows for a great deal of creative experimentation by taking the combined result of all the iterators inside the FLAME Tab and applying further modifications to that result.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
                disablewhen "{ flamefunc == 0 }"
                hidewhen "{ flamefunc == 0 } { doff == 0 }"
                parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionFFEnabledSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_toggle_private_FF(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "xfvizff_off"
                label   "FF handle VIZ SOLO OFF"
                type    button
                nolabel
                joinnext
                default { "0" }
                help    "<br/>[<b>LMB</b>] to enable the FF xform handle VIZ only (<i>SOLO mode</i>).<br/><br/>When the SYS -> \"xforms handles VIZ\" is <b>ON</b> this icon will become available.<br/><br/>The viewport handles will be automatically disabled<br/>if the FLAM3H™ density value is raised above 5M(<i>millions</i>) points.<br/>or when the OUT camera sensor VIZ mode is <b>ON</b>.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
                disablewhen "{ vizhandles == 0 } { doff == 0 } { outsensor == 1 } { ptcount > 5000000 }"
                hidewhen "{ vizhandlesff_solo == 1 }"
                parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_xfHandlesDisabledSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_toggle_xf_ff_viz(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "xfvizff_on"
                label   "FF handle VIZ SOLO ON"
                type    button
                nolabel
                joinnext
                default { "0" }
                help    "<br/>[<b>LMB</b>] to disable the <b>FF</b> xform handle VIZ SOLO mode<br/>and revert to display all xforms handles VIZ together.<br/><br/>The viewport handles will be automatically disabled<br/>if the FLAM3H™ density value is raised above 5M(<i>millions</i>) points.<br/>or when the OUT camera sensor VIZ mode is <b>ON</b>.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
                disablewhen "{ vizhandles == 0 } { outsensor == 1 } { ptcount > 5000000 }"
                hidewhen "{ vizhandlesff_solo == 0 }"
                parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_ffHandlesEnabledSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_toggle_xf_ff_viz(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "ffnote"
                label   "FF note"
                type    string
                nolabel
                joinnext
                default { "iterator_FF" }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_iterator_utils(kwargs).note_FF(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "ffprmpastesel"
                label   "FF parm paste selection"
                type    ordinal
                joinnext
                default { "0" }
                menumini {
                    [ "menu = hou.phm().flam3.flam3h_iterator_utils(kwargs).menu_copypaste_FF()" ]
                    [ "return menu" ]
                    language python
                }
                parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_iterator_utils(kwargs).prm_paste_FF()" }
                parmtag { "script_action_help" "[LMB] to mark this FF for being copied. If already marked, it will unmark it. [SHIFT+LMB] will unmark this FF for being copied. [ALT+LMB] to paste the marked FF data inside a different FLAM3H node's FF. Once marked use the nearby mini menu on another FLAM3H node to paste only specific sections of it instead. Additionally: [CTRL+LMB] to reset this FF to its default values." }
                parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_StarSwapRedCopyPasteFFSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_iterator_utils(kwargs).prm_paste_sel_FF()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "ffselmem"
                label   "Selection MEM"
                type    integer
                invisible
                nolabel
                default { "0" }
                range   { 0 10 }
                parmtag { "script_callback_language" "python" }
            }
        }

