{
    name	parameters
    groupsimple {
        name    "f_flam3h_global"
        label   "global"
        disablewhentab "{ flamefunc == 0 }"
        hidewhentab "{ h_valid == 0 }"
        grouptag { "group_type" "simple" }

        parm {
            name    "icon_iter_off"
            label   "Iterations OFF"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "The iterations number to use to resolve this fractal Flame.."
            disablewhen "{ aboutdisable == 1 }"
            hidewhen "{ flamefunc > 0 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionDisabledZeroIterSVG.svg" }
            parmtag { "script_callback" "" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "iter_off"
            label   "iterations"
            type    integer
            nolabel
            joinnext
            default { "10" }
            help    "The iterations number to use to resolve this fractal Flame."
            disablewhen "{ gpu == 1 }"
            hidewhen "{ flamefunc > 0 }"
            range   { 1! 128 }
            parmtag { "script_callback" "" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "ptcount_presets_off"
            label   "density presets off"
            type    ordinal
            nolabel
            default { "0" }
            hidewhen "{ flamefunc > 0 }"
            menu {
                "0" "![opdef:/alexnardini::Sop/FLAM3H?icon_optionDisabledZeroIterSVG.svg]"
                "1" "![opdef:/alexnardini::Sop/FLAM3H?icon_optionDisabledZeroIterSVG.svg]1 Billion"
            }
            parmtag { "script_action" "n = None" }
            parmtag { "script_action_help" "Reset density OFF" }
            parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionDisabledZeroIterSVG.svg" }
            parmtag { "script_callback" "" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "icon_iter"
            label   "Iterations"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "<h2>CPU(<i>Cvex</i>) mode</h2>[<b>LMB</b>] to switch to the GPU mode.<br/><br/>The iterations number to use to resolve this fractal Flame.<br/><br/>You must experiment with the number of iterations<br/>and always go as low as possible to save on execution time.<br/>You went too low when the fractal Flame start to turn blocky,<br/>which happens when it crosses its own minimum.<br/><br/>It is advised that occasionally you bump up this number a little<br/>to see if there is anything you are overlooking.<br/><br/>For instance,<br/>certain Flames can seem completely different with higher number of iterations."
            hidewhen "{ flamefunc == 0 } { gpu == 1 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarBlueSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).cpu_switch_to_gpu()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "icon_iter_gpu"
            label   "Iterations"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "<h2>GPU(<i>OpenCL</i>) mode</h2>[<b>LMB</b>]<br/>To cycle through the available GPU iterations presets.<br/>Presets are: <b>128</b>, <b>256</b>, <b>512</b>, <b>1024</b>, <b>2048</b>, <b>4096</b>.<br/>It will cycle backward.<br/><br/>[<b>SHIFT+LMB</b>]<br/>It will cycle forward.<br/><br/>[<b>CTRL+LMB</b>]<br/>It will switch to the CPU(Cvex) mode.<br/>When switching to CPU(Cvex) mode for the very first time,<br/>Houdini will compile all the FLAM3H™ CPU(CVEX) nodes.<br/>Depending on your PC configuration it can take up to <b>1</b>(<i>one</i>) minute.<br/>It is a one time compile process.<br/><br/><i>Additionally</i>,<br/><i>you can change the number of iterations being used by the GPU in the preferences tab under the GPU section</i>.<br/><br/><b>NOTE</b>:<br/>Everytime you either:<ul><li>Load a Flame preset</li><li>Reset FLAM3H™ to the Sierpiński triangle</li><li>Set its iterator's count to <b>0</b>(<i>Zero</i>)</li></ul>the GPU iterations will be reset to its default value of: <b>1024</b>"
            hidewhen "{ flamefunc == 0 } { gpu == 0 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionToolOCLSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).gpu_iterations_cycle()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "iter"
            label   "iterations"
            type    integer
            nolabel
            joinnext
            default { "10" }
            help    "The iterations number to use to resolve this fractal Flame."
            disablewhen "{ gpu == 1 }"
            hidewhen "{ flamefunc == 0 }"
            range   { 1! 128 }
            parmtag { "script_callback" "hou.phm().flam3.out_flame_utils(kwargs).out_auto_change_iter_num_to_prm()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "ptcount_presets"
            label   "density presets"
            type    ordinal
            nolabel
            default { "1" }
            hidewhen "{ flamefunc == 0 }"
            menu {
                [ "menu = hou.phm().flam3.flam3h_iterator_utils(kwargs).menu_global_density()" ]
                [ "return menu" ]
                language python
            }
            parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_iterator_utils(kwargs).menu_global_density_set_default()" }
            parmtag { "script_action_help" "[LMB] to reset density to its default: 500k(thousands) points. This is what should be used while editing fractal Flames most of the time. When using a custom density value from inside the preferences tab's density parameter this menu will become empty to signal it otherwise it will always show the menu label you selected. Additionally: [SHIFT+LMB] set density to: 300k(thousands). [CTRL+LMB] set density to: 200k(thousands). [ALT+LMB] set density to: 100k(thousands)" }
            parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarWhiteToolSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_iterator_utils(kwargs).menu_global_density_set()" }
            parmtag { "script_callback_language" "python" }
        }
    }

    groupsimple {
        name    "f_flam3h_sys"
        label   "sys"
        hidewhentab "{ h_valid == 0 }"
        grouptag { "group_type" "simple" }

        parm {
            name    "sys_help"
            label   "FLAM3H™ Documentation"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "[<b>LMB</b>] to display FLAM3H™ Documentation"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_F_docStarSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_display_help(), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "iterlist"
            label   "Iterator list"
            type    ordinal
            nolabel
            joinnext
            default { "0" }
            menumini {
                [ "menu = hou.phm().flam3.flam3h_iterator_utils(kwargs).menu_select_iterator()" ]
                [ "return menu" ]
                language python
            }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_iterator_utils(kwargs).prm_select_iterator(), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "doff_no_iterators"
            label   "FF OFF"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "FF"
            disablewhen "{ flamefunc == 0 }"
            hidewhen "{ flamefunc > 0 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionDisabledZeroIterSVG.svg" }
            parmtag { "script_callback" "" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "doff_sysdisabled"
            label   "FF Disabled"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "Allow you to Enable or Disable the <b>FF</b> (<i>finalXform</i>).<br/>For example this <b>FF</b> is now Disabled. [<b>LMB</b>] to Enable it.<br/><br/>Iterators like Final Flame (<b>FF</b>) or finalXform function like camera lenses.<br/>It allows for a great deal of creative experimentation by taking the combined result of all the iterators inside the FLAME Tab and applying further modifications to that result.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
            disablewhen "{ flamefunc == 0 }"
            hidewhen "{ flamefunc == 0 } { doff == 1 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionFFDisabledSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_toggle_private_FF(), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "doff_sysenabled"
            label   "FF Enabled"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "Allow you to Enable or Disable the <b>FF</b> (<i>finalXform</i>).<br/>For example this <b>FF</b> is now Enabled. [<b>LMB</b>] to Disable it.<br/><br/>Iterators like Final Flame (<b>FF</b>) or finalXform function like camera lenses.<br/>It allows for a great deal of creative experimentation by taking the combined result of all the iterators inside the FLAME Tab and applying further modifications to that result.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
            disablewhen "{ flamefunc == 0 }"
            hidewhen "{ flamefunc == 0 } { doff == 0 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionFFEnabledSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_toggle_private_FF(), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "rip_no_iterators"
            label   "RIP OFF"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "RIP"
            disablewhen "{ flamefunc == 0 } { outsensor == 1 }"
            hidewhen "{ flamefunc > 0 outsensor == 0 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionDisabledZeroIterSVG.svg" }
            parmtag { "script_callback" "" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "rip_disabled"
            label   "RIP Disabled"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "<br/>[<b>LMB</b>] to enable <b>RIP</b><br/><br/>Remove invalid points. <b>INF</b>, <b>NAN</b>, <b>Zero Opacity</b> and <b>out-of-bounds</b> points.<br/><br/>After the algorithm transforms the points,<br/>it is possible for some of those points to shoot to infinity.<br/><br/>Turn this ON while rendering ( <i>particularly for a sequence</i> )<br/>to correct any failed or black frames that may appear.<br/><br/>If rendering a flame seems unusually slow,<br/>it’s probably because certain points wind up being really far from the zero world.<br/>Those points will be eliminated if this option is turned ON.<br/><br/><b>TIPS</b>:<br/>This functionality is CPU only.<br/>When in GPU mode, having this ON/Active will slow down<br/>as it will be taxing to cleanup the incoming point cloud from the GPU nodes.<br/>Keep this OFF while editing your fractal flames in GPU mode to go full speed and Activate it only if/when needed: (<i>e.g. before any rendering or to check the final result from time to time if any iterators' opacity is 0(Zero) or NaN values are present</i>).<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
            disablewhen "{ flamefunc == 0 } { outsensor == 1 }"
            hidewhen "{ flamefunc == 0 } { rip == 1 } { outsensor == 1 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionRIPDisabledSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_toggle_private(\"rip\"), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "rip_enabled"
            label   "RIP Enabled"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "<br/>[<b>LMB</b>] to disable <b>RIP</b><br/><br/>Remove invalid points. <b>INF</b>, <b>NAN</b>, <b>Zero Opacity</b> and <b>out-of-bounds</b> points.<br/><br/>After the algorithm transforms the points,<br/>it is possible for some of those points to shoot to infinity.<br/><br/>Turn this ON while rendering ( <i>particularly for a sequence</i> )<br/>to correct any failed or black frames that may appear.<br/><br/>If rendering a flame seems unusually slow,<br/>it’s probably because certain points wind up being really far from the zero world.<br/>Those points will be eliminated if this option is turned ON.<br/><br/><b>TIPS</b>:<br/>This functionality is CPU only.<br/>When in GPU mode, having this ON/Active will slow down<br/>as it will be taxing to cleanup the incoming point cloud from the GPU nodes.<br/>Keep this OFF while editing your fractal flames in GPU mode to go full speed and Activate it only if/when needed: (<i>e.g. before any rendering or to check the final result from time to time if any iterators' opacity is 0(Zero) or NaN values are present</i>).<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
            disablewhen "{ flamefunc == 0 }"
            hidewhen "{ flamefunc == 0 } { rip == 0 } { outsensor == 1 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionRIPEnabledSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_toggle_private(\"rip\"), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "f3c_no_iterators"
            label   "F3C OFF"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "F3C"
            disablewhen "{ flamefunc == 0 }"
            hidewhen "{ flamefunc > 0 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionDisabledZeroIterSVG.svg" }
            parmtag { "script_callback" "" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "f3c_chaotica"
            label   "F3C Chaotica"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "<h3><b>F3C</b>: Unchecked -> Chaotica behavior</h3>[<b>LMB</b>] to enable <b>F3C</b>.<br/><br/>The behavior of the:<br/><b>Cos</b>, <b>Cosh</b> <b>Cot</b>, <b>Coth</b>, <b>Csc</b>, <b>Csch</b>, <b>Sec</b>, <b>Sech</b>, <b>Sin</b>, <b>Sinh</b>, <b>Tan</b>, <b>Tanh</b>, <b>Cross</b>, <b>Curve</b>, <b>Edisc</b>, <b>Escher</b>, <b>Fan2</b><br/>variations are different in flam3/Apophysis versus Chaotica.<h2>Checked</h2>Use the Apophysis behavior.<h2>Unchecked</h2>Use the Chaotica behavior.<br/><br/>The behavior of the:<br/><b>Bipolar</b>, <b>Glynnia</b>, <b>Julia</b>, <b>JuliaN</b>, <b>JuliaScope</b><br/>variations are also different in Flam3/Apophysis versus Chaotica<br/>and FLAM3H™ do not implement these Chaotica variants just yet (<i>Fractorium does</i>).<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
            disablewhen "{ flamefunc == 0 }"
            hidewhen "{ flamefunc == 0 } { f3c == 1 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionF3CDisabledSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_toggle_private(\"f3c\"), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "f3c_apophysis"
            label   "F3C Apophysis"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "<h3><b>F3C</b>: Checked -> Flam3/Apophysis behavior</h3>[<b>LMB</b>] to disable <b>F3C</b>.<br/><br/>The behavior of the:<br/><b>Cos</b>, <b>Cosh</b> <b>Cot</b>, <b>Coth</b>, <b>Csc</b>, <b>Csch</b>, <b>Sec</b>, <b>Sech</b>, <b>Sin</b>, <b>Sinh</b>, <b>Tan</b>, <b>Tanh</b>, <b>Cross</b>, <b>Curve</b>, <b>Edisc</b>, <b>Escher</b>, <b>Fan2</b><br/>variations are different in flam3/Apophysis versus Chaotica.<h2>Checked</h2>Use the Apophysis behavior.<h2>Unchecked</h2>Use the Chaotica behavior.<br/><br/>The behavior of the:<br/><b>Bipolar</b>, <b>Glynnia</b>, <b>Julia</b>, <b>JuliaN</b>, <b>JuliaScope</b><br/>variations are also different in Flam3/Apophysis versus Chaotica<br/>and FLAM3H™ do not implement these Chaotica variants just yet (<i>Fractorium does</i>).<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
            disablewhen "{ flamefunc == 0 }"
            hidewhen "{ flamefunc == 0 } { f3c == 0 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionF3CEnabledSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_toggle_private(\"f3c\"), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "xfviz_no_iterators"
            label   "XF VIZ OFF"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "XF VIZ"
            disablewhen "{ flamefunc == 0 } { outsensor == 1 }"
            hidewhen "{ flamefunc > 0 outsensor == 0 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionDisabledZeroIterSVG.svg" }
            parmtag { "script_callback" "" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "xfviz_off"
            label   "xforms handles VIZ OFF"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "<br/>[<b>LMB</b>] to enable the xforms handles VIZ in the viewport.<br/><br/>These handles are not editable, but only for visualization purpose.<br/>They will be helpful to better grasp how the affine values (<i><b>PRE</b> and <b>POST</b> affine</i>) are acting over each iterator of the fractal Flame.<br/><br/>You can adjust their wire curve thickness in the preferences tab<br/>using the prefs viewport -> \"<b>wire width</b>\" parameter.<br/><br/>The viewport handles will be automatically disabled<br/>if the FLAM3H™ density value is raised above 5M(<i>millions</i>) points<br/>or when the OUT camera sensor VIZ mode is <b>ON</b>.<br/><br/><b>WARNING</b>:<br/>Turn this OFF when rendering.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
            disablewhen "{ flamefunc == 0 } { ptcount > 5000000 }"
            hidewhen "{ flamefunc == 0 } { vizhandles == 1 } { outsensor == 1 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_xfHandlesDisabledSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_xf_viz_toggle(), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "xfviz_on"
            label   "xforms handles VIZ ON"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "<br/>[<b>LMB</b>] to disable the xforms handles VIZ in the viewport.<br/><br/>These handles are not editable, but only for visualization purpose.<br/>They will be helpful to better grasp how the affine values (<i><b>PRE</b> and <b>POST</b> affine</i>) are acting over each iterator of the fractal Flame.<br/><br/>You can adjust their wire curve thickness in the preferences tab<br/>using the prefs viewport -> \"<b>wire width</b>\" parameter.<br/><br/>The viewport handles will be automatically disabled<br/>if the FLAM3H™ density value is raised above 5M(<i>millions</i>) points<br/>or when the OUT camera sensor VIZ mode is <b>ON</b>.<br/><br/><b>WARNING</b>:<br/>Turn this OFF when rendering.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
            disablewhen "{ flamefunc == 0 } { ptcount > 5000000 }"
            hidewhen "{ flamefunc == 0 } { vizhandles == 0 } { vizhandles_solo == 1 vizhandlesff_solo == 1 } { vizhandles_solo == 1 } { vizhandlesff_solo == 1 } { outsensor == 1 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_xfHandlesEnabledSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_xf_viz_toggle(), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "xfviz_on_solo"
            label   "xform handle VIZ SOLO ON"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "<br/>[<b>LMB</b>] to disable the xforms handles VIZ SOLO mode<br/>and revert to display all xforms handles VIZ together.<br/><br/>The viewport handles will be automatically disabled<br/>if the FLAM3H™ density value is raised above 5M(<i>millions</i>) points<br/>or when the OUT camera sensor VIZ mode is <b>ON</b>.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
            disablewhen "{ flamefunc == 0 } { ptcount > 5000000 }"
            hidewhen "{ flamefunc == 0 } { vizhandles == 0 } { vizhandles_solo == 0 vizhandlesff_solo == 1 } { vizhandles_solo == 0 } { outsensor == 1 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_xfHandlesEnabledMPIDXSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_toggle_sys_xf_viz_solo(), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "xfvizff_on_solo"
            label   "FF handle VIZ SOLO ON"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "<br/>[<b>LMB</b>] to disable the <b>FF</b> handle VIZ SOLO mode<br/>and revert to display all xforms handles VIZ together.<br/><br/>The viewport handles will be automatically disabled<br/>if the FLAM3H™ density value is raised above 5M(<i>millions</i>) points<br/>or when the OUT camera sensor VIZ mode is <b>ON</b>.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
            disablewhen "{ flamefunc == 0 } { ptcount > 5000000 }"
            hidewhen "{ flamefunc == 0 } { vizhandles == 0 } { vizhandles_solo == 1 vizhandlesff_solo == 0 } { vizhandlesff_solo == 0 } { outsensor == 1 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_ffHandlesEnabledSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_toggle_sys_xf_ff_viz_solo(), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "sys_out_sensorviz"
            label   "SENSOR Enabled"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "<br/>[<b>LMB</b>] to EXIT sensor viz mode. (<i> Camera sensor update ON </i>).\\n\\nNOTE:\\nThis has the important property to update and refresh all the Presets menus data\\n(CP, IN and OUT presets menus)"
            hidewhen "{ outsensor == 0 } { outsensorupdate == 0 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_TagORedSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_outsensor_toggle(), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "sys_out_sensorviz_off"
            label   "SENSOR Enabled"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "<br/>[<b>LMB</b>] to EXIT sensor viz mode. (<i> Camera sensor update OFF </i>).\\n\\nNOTE:\\nThis has the important property to update and refresh all the Presets menus data\\n(CP, IN and OUT presets menus)"
            hidewhen "{ outsensor == 0 } { outsensorupdate == 1 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_TagORedOffSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_outsensor_toggle(), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "sys_tag_disabled"
            label   "TAG OFF"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "TAG"
            disablewhen "{ flamefunc == 0 }"
            hidewhen "{ flamefunc > 0 } { outsensor == 1 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionDisabledZeroIterSVG.svg" }
            parmtag { "script_callback" "" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "sys_tag_off"
            label   "TAG Disabled"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "<br/>[<b>LMB</b>] to enable viewport <b>TAG</b>.<br/><br/><b>TAG</b> allow you to review your fractal Flame construction infos in one compact viewport string.<br/>However, it has a cost and the default behavior is for it to be <b>OFF</b>.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
            disablewhen "{ outsensor == 1 }"
            hidewhen "{ flamefunc == 0 } { tag == 1 } { outsensor == 1 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_TagOBlueSVG_disabled.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_toggle_private(\"tag\"), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "sys_tag"
            label   "TAG Enabled"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "<br/>[<b>LMB</b>] to disable viewport <b>TAG</b>.<br/><br/>Next to this icon on the right there is a menu to choose different tag sizes.<br/><b>TAG</b> allow you to review your fractal Flame construction infos in one compact viewport string.<br/>However, it has a cost and the default behavior is for it to be <b>OFF</b>.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
            disablewhen "{ outsensor == 1 }"
            hidewhen "{ flamefunc == 0 } { tag == 0 } { outsensor == 1 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_TagOBlueSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_toggle_private(\"tag\"), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "tagsize_no_iterators"
            label   "TAG size"
            type    ordinal
            nolabel
            joinnext
            default { "0" }
            help    "Set a different viewport tag size."
            disablewhen "{ flamefunc == 0 } { tag == 0 } { outsensor == 1 }"
            hidewhen "{ flamefunc > 0 outsensor == 0 }"
            menu {
                "0" "![opdef:/alexnardini::Sop/FLAM3H?icon_optionDisabledZeroIterSVG.svg]"
            }
            parmtag { "script_callback" "kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
            parmtag { "sidefx::look" "icon" }
        }
        parm {
            name    "tagsize"
            label   "TAG size"
            type    ordinal
            nolabel
            joinnext
            default { "0" }
            help    "Set a different viewport tag size."
            disablewhen "{ flamefunc == 0 } { tag == 0 } { outsensor == 1 }"
            hidewhen "{ flamefunc == 0 } { outsensor == 1 }"
            menu {
                "0" "![opdef:/alexnardini::Sop/FLAM3H?icon_TagOBlueMenuSmallSVG.svg] sml"
                "1" "![opdef:/alexnardini::Sop/FLAM3H?icon_TagOBlueMenuMidSVG.svg] Mid"
                "2" "![opdef:/alexnardini::Sop/FLAM3H?icon_TagOBlueMenuBigSVG.svg] BIG"
            }
            parmtag { "script_callback" "kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
            parmtag { "sidefx::look" "icon" }
        }
        parm {
            name    "loaddef"
            label   "Sierpiński triangle"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "<br/>[<b>LMB</b>] to reset FLAM3H™ and load the default <b>Sierpiński triangle</b> preset.<br/><br/><i>Additionally</i>:<br/><i>it will also reset the FLAM3H™ UI and options toggles to their defaults including the OUT render properties (<b>SENSOR</b>, <b>RENDER</b> and <b>CC CURVES</b> settings)</i>.<br/><br/>When in GPU mode,<br/>it will also reset the GPU iterations to its default: <b>1024</b>"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_SierpinskyDefSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_iterator_utils(kwargs).flam3h_default()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "frameview"
            label   "Frame viewport"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "Re-frame current viewport based on a centered bounding box.<br/><br/>[<b>LMB</b>]<br/>Reframe keeping the current viewports type.<br/><br/>[<b>SHIFT+LMB</b>]<br/>Reframe while setting the viewports to Front type.<br/><br/>This is being added because it occasionally happens that the camera viewport frames the current Flame really small due to some of its points ending up being really far away from the zero world position.<br/><br/>When in camera sensor mode the re-frame will be based on the Camera sensor bounding box instead.<br/><br/><i>Additionally</i>,<br/><i>it will set the viewports clipping planes to proper values every time is invoked</i>.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
            hidewhen "{ outsensor == 1 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_FrameBlueToolSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).util_viewport_bbox_frame(), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "frameviewsensor"
            label   "Frame viewport sensor"
            type    button
            nolabel
            joinnext
            default { "0" }
            help    "<br/>[<b>LMB</b>] to re-frame sensor viz.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
            hidewhen "{ outsensor == 0 }"
            parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_FrameRedSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).util_set_front_viewer(False), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "sys_palettepresets_disabled"
            label   "SYS CP file contents"
            type    string
            nolabel
            joinnext
            default { "-1" }
            help    "Disabled. Select a palette preset to load. It will show the palette contained in the selected output file, if any are present. Once you add a new palette to it, this menu will update too. It will always be set to the last palette's name you saved."
            disablewhen "{ flamefunc == 0 }"
            hidewhen "{ flamefunc > 0 }"
            menumini {
                "language"  "python"
            }
            parmtag { "script_action" "n = None" }
            parmtag { "script_action_help" "CP OFF" }
            parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionDisabledZeroIterSVG.svg" }
            parmtag { "script_callback" "" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "sys_palettepresets_off"
            label   "SYS CP file contents off"
            type    string
            nolabel
            joinnext
            default { "-1" }
            help    "Select a palette preset to load. It will show the palette contained in the selected output file, if any are present. Once you add a new palette to it, this menu will update too. It will always be set to the last palette's name you saved."
            hidewhen "{ flamefunc == 0 } { cpisvalidpreset == 1 }"
            menumini {
                [ "menu = hou.phm().flam3.flam3h_palette_utils(kwargs).menu_cp_presets_empty()" ]
                [ "return menu" ]
                language python
            }
            parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_palette_utils(kwargs).json_to_flam3h_ramp()" }
            parmtag { "script_action_help" "[LMB] to load the selected CP palette preset if any. To populate this menu, load a palette *.json file first inside the CP Tab or [SHIFT+LMB] to open a floating file chooser. [CTRL+LMB] to copy the selected preset name into the \"palette name\" string parameter. [ALT+LMB] to load a palette from the Clipboard (it will import palette data from the clipboard either from a JSON data or from a full Flame preset XML data)." }
            parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionPRIDEDisabledSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_palette_utils(kwargs).json_to_flam3h_ramp_sys(False), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "sys_palettepresets"
            label   "SYS CP file contents"
            type    string
            nolabel
            joinnext
            default { "-1" }
            help    "Select a palette preset to load. It will show the palette contained in the selected output file, if any are present. Once you add a new palette to it, this menu will update too. It will always be set to the last palette's name you saved."
            hidewhen "{ flamefunc == 0 } { cpisvalidpreset == 0 }"
            menumini {
                [ "menu = hou.phm().flam3.flam3h_palette_utils(kwargs).menu_cp_presets()" ]
                [ "return menu" ]
                language python
            }
            parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_palette_utils(kwargs).json_to_flam3h_ramp()" }
            parmtag { "script_action_help" "[LMB] to reload the selected CP palette preset, if any. [SHIFT+LMB] to open a floating file chooser. [CTRL+LMB] to copy the selected preset name into the \"palette name\" string parameter. [ALT+LMB] to load a palette from the Clipboard (it will import palette data from the clipboard either from a JSON data or from a full Flame preset XML data)." }
            parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionCPSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.flam3h_palette_utils(kwargs).json_to_flam3h_ramp_sys(False), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "sys_inpresets_disabled"
            label   "SYS IN file contents"
            type    string
            nolabel
            joinnext
            default { "-1" }
            hidewhen "{ inisvalidfile == 1 inisvalidpreset == 1 }"
            menumini {
                [ "menu = hou.phm().flam3.in_flame_utils(kwargs).menu_in_presets_empty()" ]
                [ "return menu" ]
                language python
            }
            parmtag { "script_action" "kwargs['node'].hdaModule().flam3.in_flame_utils(kwargs).in_to_flam3h()" }
            parmtag { "script_action_help" "[LMB] to load the selected IN Flame preset, if any. To populate this menu, load a Flame lib *.flame file first inside the IN Tab or [SHIFT+LMB] to open a floating file chooser. [ALT+LMB] to load a Flame from the Clipboard." }
            parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_WhiteSVG_disabled.svg" }
            parmtag { "script_callback" "hou.phm().flam3.in_flame_utils(kwargs).in_to_flam3h_sys(), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "sys_inpresets"
            label   "SYS IN file contents"
            type    string
            nolabel
            joinnext
            default { "-1" }
            hidewhen "{ inisvalidfile == 1 inisvalidpreset == 0 } { inisvalidfile == 0 }"
            menumini {
                [ "menu = hou.phm().flam3.in_flame_utils(kwargs).menu_in_presets()" ]
                [ "return menu" ]
                language python
            }
            parmtag { "script_action" "kwargs['node'].hdaModule().flam3.in_flame_utils(kwargs).in_to_flam3h()" }
            parmtag { "script_action_help" "[LMB] to reload the selected IN Flame preset, if any. [SHIFT+LMB] to open a floating file chooser. [ALT+LMB] to load a Flame from the Clipboard. " }
            parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_WhiteSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.in_flame_utils(kwargs).in_to_flam3h_sys(), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "sys_outpresets_disabled"
            label   "SYS OUT file contents"
            type    string
            nolabel
            joinnext
            default { "-1" }
            disablewhen "{ flamefunc == 0 }"
            hidewhen "{ flamefunc > 0 }"
            menumini {
                "language"  "python"
            }
            parmtag { "script_action" "n = None" }
            parmtag { "script_action_help" "OUT OFF" }
            parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionDisabledZeroIterSVG.svg" }
            parmtag { "script_callback" "" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "sys_outpresets"
            label   "SYS OUT file contents"
            type    string
            nolabel
            joinnext
            default { "-1" }
            help    "This menu is only for informational purposes.\\nIt will show the Flame presets contained in the selected output file, if any are present. Once you add a new Flame to it, this menu will update too. It will always be set to the last Flame name you saved.\\n\\nIt will also print quick informations ( in the status bar and as a flash message in the network editor)\\nabout the Flame preset when one is selected.\\n\\nQuick infos are:\\n- Flame preset name ( only in the status bar )\\n- XF: Number of iterators/xforms being used\\n- FF: when finalXform(FF) is being used\\n- Palette: number of colors in the palette\\n- HSV: when HSV color correction is being used\\n- HSV values ( only in the status bar )\\n"
            hidewhen "{ flamefunc == 0 }"
            menumini {
                [ "menu = hou.phm().flam3.out_flame_utils(kwargs).menu_out_contents_presets()" ]
                [ "return menu" ]
                language python
            }
            parmtag { "script_action" "kwargs['node'].hdaModule().flam3.out_flame_utils(kwargs).out_XML()" }
            parmtag { "script_action_help" "[LMB] to save this Flame inside the selected OUT file, if any. If the file doesn't exit yet it will create it. If the file contain already some Flames, it will append it. [CTRL+LMB] to erase the content of the file and save only the current Flame in it. [SHIFT+LMB] if not a valid filepath is present already it will open a file chooser, otherwise it will open the file explorer to the file location. [ALT+LMB] to save this Flame into the Clipboard. " }
            parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_WhiteStarSVG.svg" }
            parmtag { "script_callback" "hou.phm().flam3.out_flame_utils(kwargs).out_to_flam3h_quick('SYS'), kwargs['parm'].deleteAllKeyframes()" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "label_paletteplus"
            label   "label_paletteplus"
            type    label
            default { "[256+]" }
            hidewhen "{ paletteplus == 0 } { flamefunc == 0 }"
            parmtag { "sidefx::look" "block" }
        }
    }

    group {
        name    "f_flam3h"
        label   "FLAME"
        hidewhentab "{ h_valid == 0 }"

        multiswitcher {
            name    "flamefunc"
            label    "iterators"
            default 3
            parmtag { "script_callback" "hou.pwd().hdaModule().flam3.flam3h_iterator_utils(kwargs).iterators_count()" }
            parmtag { "script_callback_from_ui" "1" }
            parmtag { "script_callback_language" "python" }
            parmtag { "sidefx::multi_label" "mpmem_#" }

            parm {
                name    "doiter_disabled_#"
                label   "Iterator Disabled"
                type    button
                nolabel
                joinnext
                default { "0" }
                help    "Allow you to Enable or Disable this iterator.<br/><br/>For example this iterator is now Disabled. [<b>LMB</b>] to Enable it.<br/><br/>If an xform/iterator is disabled<br/>it wont be included when saving the Flame out into a flame file.<br/>In case you still want to include the inactive iterator into the file<br/>set its Weight to <b>0</b>(<i>Zero</i>) instead.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
                hidewhen "{ vactive_# == 1 }"
                parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionDisabledSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_iterator_utils(kwargs).iterator_vactive_and_update(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "doiter_#"
                label   "Iterator Enabled"
                type    button
                nolabel
                joinnext
                default { "0" }
                help    "Allow you to Enable or Disable this iterator.<br/><br/>For example this iterator is now Enabled. [<b>LMB</b>] to Disable it.<br/><br/>If an xform/iterator is disabled<br/>it wont be included when saving the Flame out into a flame file.<br/>In case you still want to include the inactive iterator into the file<br/>set its Weight to <b>0</b>(<i>Zero</i>) instead.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
                hidewhen "{ vactive_# == 0 }"
                parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarYellowOrangeSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_iterator_utils(kwargs).iterator_vactive_and_update(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "xfviz_off_#"
                label   "xform handle VIZ SOLO OFF"
                type    button
                nolabel
                joinnext
                default { "0" }
                help    "<br/>[<b>LMB</b>] to enable this iterator's xform handle VIZ only (<i>SOLO mode</i>).<br/><br/>When the SYS -> \"xforms handles VIZ\" is <b>ON</b> this icon will become available.<br/><br/>If the <b>FF</b> is <b>ON</b> its xform handle VIZ will always be displayed together with this iterator xform handle VIZ.<br/><br/>When enabled (<i>SOLO mode</i>), it causes the iterator that is selected or picked from the SYS tab select iterator mini-menu to be automatically configured to be in SOLO mode.<br/><br/>This enables you to swiftly go over each one automatically.<br/><br/>The viewport handles will be automatically disabled<br/>if the FLAM3H™ density value is raised above <b>5M</b>(<i>millions</i>) points<br/>or when the OUT camera sensor VIZ mode is <b>ON</b>.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
                disablewhen "{ vizhandles == 0 } { vactive_# == 0 } { iw_# == 0 } { outsensor == 1 } { ptcount > 5000000 }"
                hidewhen "{ xfviz_# == 1 }"
                parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_xfHandlesDisabledSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_toggle_mp_xf_viz(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "xfviz_on_#"
                label   "xform handle VIZ SOLO ON"
                type    button
                nolabel
                joinnext
                default { "0" }
                help    "<br/>[<b>LMB</b>] to disable this iterator's xform handle VIZ SOLO mode<br/>and revert to display all xforms handles VIZ together.<br/><br/>It causes the iterator that is selected or picked from the SYS tab select iterator mini-menu to be automatically configured to be in SOLO mode as well.<br/><br/>This enables you to swiftly go over each one automatically.<br/><br/>The viewport handles will be automatically disabled if the FLAM3H™ density value is raised above <b>5M</b>(<i>millions</i>) points or when the OUT camera sensor VIZ mode is <b>ON</b>.<br/><br/><b>NOTE</b>:<br/>This has the important property to update and refresh all the Presets menus data (<i><b>CP</b>, <b>IN</b> and <b>OUT</b> presets menus</i>)"
                disablewhen "{ vizhandles == 0 } { vactive_# == 0 } { iw_# == 0 } { outsensor == 1 } { ptcount > 5000000 }"
                hidewhen "{ xfviz_# == 0 }"
                parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_xfHandlesEnabledMPIDXSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_general_utils(kwargs).flam3h_toggle_mp_xf_viz(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "mp_add_#"
                label   "Add or Delete iterator"
                type    button
                nolabel
                joinnext
                default { "0" }
                help    "<br/>[<b>LMB</b>] to insert an iterator Before.<br/><br/>[<b>SHIFT+LMB</b>] to insert an iterator After.<br/><br/>[<b>CTRL+LMB</b>] to delete this iterator.<br/><br/><b>NOTE</b>:<br/>This icon is what you must use to Add and Delete iterators since it is updating all the FLAM3H™ internal data and each iterators' xaos string accordingly."
                parmtag { "button_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_AddDelIteratorSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_iterator_utils(kwargs).add_iterator()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "mpmem_#"
                label   "MPMEM"
                type    string
                invisible
                joinnext
                default { "#" }
                parmtag { "script_callback" "" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "mpmem_x_#"
                label   "MPMEM X"
                type    integer
                invisible
                joinnext
                default { "#" }
                range   { 0 10 }
                parmtag { "script_callback" "" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "note_#"
                label   "         "
                type    string
                joinnext
                default { "iterator_#" }
                help    "<h2>This iterator name</h2>Give this iterator a name or a short descriptive note.<br/><br/>The text you write here will be shown inside the SYS tab select iterator mini menu entries.<br/><br/><b>NOTE</b>:<br/>It will also be stored with the Flame preset file on Save and shown inside third-party applications like Apophysis and Fractorium as the iterator's name."
                parmtag { "script_callback" "hou.phm().flam3.flam3h_iterator_utils(kwargs).destroy_data_note(), kwargs['parm'].deleteAllKeyframes()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "prmpastesel_#"
                label   "parm paste selection"
                type    ordinal
                nolabel
                joinnext
                default { "0" }
                menumini {
                    [ "menu = hou.phm().flam3.flam3h_iterator_utils(kwargs).menu_copypaste()" ]
                    [ "return menu" ]
                    language python
                }
                parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_iterator_utils(kwargs).prm_paste()\n" }
                parmtag { "script_action_help" "[LMB] to mark this iterator for being copied. If already marked, it will unmark it. [SHIFT+LMB] to unmark this FLAM3H node's marked iterator for being copied. [ALT+LMB] to paste the marked iterator data into this iterator, even if the marked iterator lives in a different FLAM3H node. Once marked and pasted, it will paste everything but not Xaos. Use the nearby mini menu to paste only specific sections of it instead, like for example: Xaos. Additionally: [CTRL+LMB] to reset this iterator to its default values." }
                parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_StarSwapRedCopyPasteSVG.svg" }
                parmtag { "script_callback" "hou.phm().flam3.flam3h_iterator_utils(kwargs).prm_paste_sel()" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "selmem_#"
                label   "Selection MEM"
                type    integer
                invisible
                nolabel
                default { "0" }
                range   { 0 10 }
                parmtag { "script_callback" "" }
                parmtag { "script_callback_language" "python" }
            }
            groupsimple {
                name    "f_itermain_#"
                label   "#"
                grouptag { "group_type" "simple" }

                parm {
                    name    "vactive_#"
                    label   "A"
                    type    toggle
                    invisible
                    default { "1" }
                    help    "Enable or disable this iterator."
                    parmtag { "script_callback" "" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "xfviz_#"
                    label   "XF VIZ (solo)"
                    type    toggle
                    invisible
                    default { "0" }
                    help    "Enable or disable this iterator."
                    parmtag { "script_callback" "" }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "iw_#"
                    label   "W"
                    type    float
                    default { "0.5" }
                    disablewhen "{ vactive_# == 0 }"
                    range   { 0! 5 }
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_iterator_utils(kwargs).iterator_vactive_and_update()" }
                    parmtag { "script_callback_language" "python" }
                }
            }

            groupsimple {
                name    "f_iterxaos#"
                label   "#: xaos:"
                disablewhentab "{ vactive_# == 0 } { iw_# == 0 }"
                grouptag { "group_type" "simple" }

                parm {
                    name    "xaos_#"
                    label   "F# xaos"
                    type    string
                    nolabel
                    default { "xaos:" }
                    parmtag { "script_action" "kwargs['node'].hdaModule().flam3.flam3h_ui_msg_utils(kwargs).ui_xaos_infos()" }
                    parmtag { "script_action_help" "[LMB] to Activate/Deactivate auto space xaos weights option. It will space the xaos weights for easy edit, read and count ( ON/OFF ). [CTRL+LMB] to display the Xaos usage informations/tips." }
                    parmtag { "script_action_icon" "opdef:/alexnardini::Sop/FLAM3H?icon_optionStarBlueToolSVG.svg" }
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_iterator_utils(kwargs).auto_set_xaos()" }
                    parmtag { "script_callback_language" "python" }
                }
            }

            groupsimple {
                name    "f_itershader_#"
                label   "#: shader"
                disablewhentab "{ vactive_# == 0 } { iw_# == 0 }"
                grouptag { "group_type" "simple" }

                parm {
                    name    "clr_#"
                    label   "location"
                    type    float
                    default { "0" }
                    help    "<h3>The color location in the ramp <b>{0:1}</b></h3>"
                    range   { 0! 1! }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "clrspeed_#"
                    label   "speed"
                    type    float
                    default { "0" }
                    help    "<h3>Speed of color blending between iterations</h3><i>Values above <b>0</b>(<i>Zero</i>) attract the selected color while values below <b>0</b>(<i>Zero</i>) will repel it</i>.<br/><br/><b>NOTE</b>:<br/>The correct ranges for this value should always be between <b>-1</b> and <b>1</b>."
                    range   { 0 1! }
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "alpha_#"
                    label   "opacity"
                    type    float
                    default { "1" }
                    help    "<h3>It will be fully opaque at opacity <b>1</b>(<i>one</i>) and completely transparent at opacity <b>0</b>(<i>Zero</i>)</h3><i>It can also be used to adjust the prominence of different portions of your fractal Flame, independent of the iterator’s <b>W</b>eight</i>.<br/><br/><b>NOTE</b>:<br/>When an iterator's opacity is <b>0</b>(<i>Zero</i>), you can activate the SYS Tab RIP option to get rid of those points.<br/>( <i>Since <b>Opacity</b> == <b>@pscale</b> or <b>@widths</b> in Solaris, you don't need them anymore</i> )"
                    range   { 0! 1! }
                    parmtag { "script_callback" "hou.phm().flam3.flam3h_iterator_utils.destroy_cachedUserData(kwargs['node'], 'iter_sel')" }
                    parmtag { "script_callback_language" "python" }
                }
            }

            groupcollapsible {
                name    "f_iterpre_#"
                label   "#: PRE"
                disablewhentab "{ vactive_# == 0 } { iw_# == 0 }"
                grouptag { "group_type" "collapsible" }
                parmtag { "sidefx::header_parm" "preblurweight_#" }

